{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vnpy.local/artifact-contracts/c-fast/commodity-approved-research-source-v1.schema.json",
  "title": "Approved immutable research source envelope for C_FAST",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_role", "status", "source_view", "source_view_canonical_sha256", "source_receipt_sha256", "approval"],
  "properties": {
    "schema_version": {"const": "commodity_approved_research_source_v1"},
    "artifact_role": {"const": "approved_research_source"},
    "status": {"const": "APPROVED_IMMUTABLE_SOURCE"},
    "source_view": {"type": "object"},
    "source_view_canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval": {"type": "object", "additionalProperties": false, "required": ["approved", "immutable", "receipt_verified", "custody_verified", "lineage_verified"], "properties": {"approved": {"const": true}, "immutable": {"const": true}, "receipt_verified": {"const": true}, "custody_verified": {"const": true}, "lineage_verified": {"const": true}}}
  }
}
