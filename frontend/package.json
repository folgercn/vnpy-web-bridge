{
  "name": "vnpy-web-bridge-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src",
    "lint:styles": "stylelint 'src/styles/**/*.css'",
    "check:contracts": "node scripts/verify-frontend-contracts.mjs",
    "test": "vitest run",
    "check": "npm run lint && npm run lint:styles && npm run check:contracts && npm run typecheck && npm test && vite build"
  },
  "dependencies": {
    "@vicons/antd": "^0.13.0",
    "katex": "^0.16.11",
    "lightweight-charts": "^5.2.0",
    "naive-ui": "^2.41.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
