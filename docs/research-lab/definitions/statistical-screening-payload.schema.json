{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "dataset_metadata": {
      "type": "object",
      "required": [
        "profile",
        "snapshot_locator",
        "snapshot_sha256",
        "snapshot_byte_length",
        "required_fields",
        "time_range",
        "sample_count",
        "provenance",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "research_lab.statistical_screening.v1"
        },
        "snapshot_locator": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot_byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "time_range": {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": { "type": "string" },
            "end": { "type": "string" }
          }
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "method_definition": {
      "type": "object",
      "required": [
        "profile",
        "methods",
        "parameters",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "research_lab.statistical_screening.v1"
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "coverage",
              "simple_correlation",
              "direction_consistency",
              "stability_split",
              "leakage_audit",
              "outlier_sensitivity",
              "cost_sensitivity"
            ]
          },
          "minItems": 1
        },
        "parameters": {
          "type": "object"
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment_lock": {
      "type": "object",
      "required": [
        "profile",
        "source_sha256",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "research_lab.statistical_screening.v1"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment_details": {
          "type": ["object", "string"]
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "replay_instructions": {
      "type": "object",
      "required": [
        "profile",
        "command",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "research_lab.statistical_screening.v1"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "entry_point": {
          "type": "string"
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "statistical_summary": {
      "type": "object",
      "required": [
        "profile",
        "sample_count",
        "methods_applied",
        "facts"
      ],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "research_lab.statistical_screening.v1"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "methods_applied": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "coverage",
              "simple_correlation",
              "direction_consistency",
              "stability_split",
              "leakage_audit",
              "outlier_sensitivity",
              "cost_sensitivity"
            ]
          },
          "minItems": 1
        },
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "coverage": {
              "type": "object",
              "required": [
                "total_rows",
                "valid_rows",
                "missing_rows",
                "coverage_ratio"
              ],
              "additionalProperties": false,
              "properties": {
                "total_rows": { "type": "integer", "minimum": 0 },
                "valid_rows": { "type": "integer", "minimum": 0 },
                "missing_rows": { "type": "integer", "minimum": 0 },
                "coverage_ratio": { "type": "string" },
                "start_time": { "type": ["string", "null"] },
                "end_time": { "type": ["string", "null"] }
              }
            },
            "simple_correlation": {
              "type": "object",
              "required": [
                "sample_size",
                "pearson_ic"
              ],
              "additionalProperties": false,
              "properties": {
                "sample_size": { "type": "integer", "minimum": 0 },
                "pearson_ic": { "type": ["string", "null"] }
              }
            },
            "direction_consistency": {
              "type": "object",
              "required": [
                "sample_size",
                "matching_pairs",
                "consistency_ratio"
              ],
              "additionalProperties": false,
              "properties": {
                "sample_size": { "type": "integer", "minimum": 0 },
                "matching_pairs": { "type": "integer", "minimum": 0 },
                "consistency_ratio": { "type": ["string", "null"] }
              }
            },
            "stability_split": {
              "type": "object",
              "required": [
                "split_point",
                "first_half_sample_size",
                "second_half_sample_size",
                "first_half_correlation",
                "second_half_correlation",
                "correlation_difference"
              ],
              "additionalProperties": false,
              "properties": {
                "split_point": { "type": "string" },
                "first_half_sample_size": { "type": "integer", "minimum": 0 },
                "second_half_sample_size": { "type": "integer", "minimum": 0 },
                "first_half_correlation": { "type": ["string", "null"] },
                "second_half_correlation": { "type": ["string", "null"] },
                "correlation_difference": { "type": ["string", "null"] }
              }
            },
            "leakage_audit": {
              "type": "object",
              "required": [
                "audit_status",
                "rows_checked",
                "audited_fields",
                "audit_coverage_ratio",
                "temporal_violation_count",
                "target_overlap_violation_count",
                "missing_availability_metadata",
                "unverifiable_rows"
              ],
              "additionalProperties": false,
              "properties": {
                "audit_status": {
                  "type": "string",
                  "enum": ["COMPLETED", "INSUFFICIENT_DATA"]
                },
                "rows_checked": { "type": "integer", "minimum": 0 },
                "audited_fields": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "audit_coverage_ratio": { "type": "string" },
                "temporal_violation_count": { "type": ["integer", "null"] },
                "target_overlap_violation_count": { "type": ["integer", "null"] },
                "missing_availability_metadata": { "type": "boolean" },
                "unverifiable_rows": { "type": "integer", "minimum": 0 }
              }
            },
            "outlier_sensitivity": {
              "type": "object",
              "required": [
                "baseline_ic",
                "trimmed_ic",
                "removed_count",
                "removed_ratio",
                "ic_delta",
                "baseline_direction",
                "trimmed_direction",
                "direction_preserved"
              ],
              "additionalProperties": false,
              "properties": {
                "baseline_ic": { "type": ["string", "null"] },
                "trimmed_ic": { "type": ["string", "null"] },
                "removed_count": { "type": "integer", "minimum": 0 },
                "removed_ratio": { "type": "string" },
                "ic_delta": { "type": ["string", "null"] },
                "baseline_direction": { "type": "string" },
                "trimmed_direction": { "type": "string" },
                "direction_preserved": { "type": "boolean" }
              }
            },
            "cost_sensitivity": {
              "type": "object",
              "required": [
                "position_rule",
                "expected_direction",
                "observations",
                "turnover",
                "gross_screening_return",
                "net_return_0bps",
                "net_return_1bps",
                "net_return_3bps",
                "net_return_5bps",
                "net_return_10bps",
                "breakeven_cost_bps"
              ],
              "additionalProperties": false,
              "properties": {
                "position_rule": { "type": "string" },
                "expected_direction": {
                  "type": "string",
                  "enum": ["positive", "negative"]
                },
                "observations": { "type": "integer", "minimum": 0 },
                "turnover": { "type": "string" },
                "gross_screening_return": { "type": "string" },
                "net_return_0bps": { "type": "string" },
                "net_return_1bps": { "type": "string" },
                "net_return_3bps": { "type": "string" },
                "net_return_5bps": { "type": "string" },
                "net_return_10bps": { "type": "string" },
                "breakeven_cost_bps": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    },
    "failure_diagnostics": {
      "type": "object",
      "required": [
        "profile",
        "error_type",
        "error_message"
      ],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "research_lab.statistical_screening.v1"
        },
        "error_type": {
          "type": "string",
          "minLength": 1
        },
        "error_message": {
          "type": "string",
          "minLength": 1
        },
        "missing_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "snapshot_reference": {
          "type": "string"
        }
      }
    }
  }
}
