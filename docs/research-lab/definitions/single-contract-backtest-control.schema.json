{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "research_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "hash_profile",
        "task_id",
        "revision",
        "research_type",
        "objective",
        "data_requirements",
        "task_content_hash"
      ],
      "properties": {
        "schema_version": {
          "const": "research_lab.task.v2"
        },
        "hash_profile": {
          "const": "research-json-v1"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^rev\\.[1-9][0-9]*$"
        },
        "research_type": {
          "const": "trading_backtest"
        },
        "task_profile": {
          "const": "research_lab.single_contract_backtest.v1"
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "data_requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "product",
            "exact_contract",
            "time_range",
            "snapshot_sha256",
            "snapshot_locator",
            "provenance"
          ],
          "properties": {
            "product": {
              "type": "string",
              "minLength": 1
            },
            "exact_contract": {
              "type": "string",
              "minLength": 1
            },
            "time_range": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date-time"
                },
                "end": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "snapshot_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "snapshot_locator": {
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "task_content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "experiment_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "hash_profile",
        "run_id",
        "run_status",
        "spec_id",
        "spec_revision",
        "spec_content_hash",
        "trial_context",
        "resolved_computation_manifest",
        "scientific_fingerprint",
        "timing",
        "process_exit_code",
        "run_content_hash"
      ],
      "properties": {
        "schema_version": {
          "const": "research_lab.run.v2"
        },
        "hash_profile": {
          "const": "research-json-v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "run_status": {
          "enum": [
            "COMPLETED",
            "FAILED"
          ]
        },
        "spec_id": {
          "type": "string",
          "minLength": 1
        },
        "spec_revision": {
          "type": "string",
          "pattern": "^rev\\.[1-9][0-9]*$"
        },
        "spec_content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "trial_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "research_stage",
            "trial_kind",
            "retry_of_run_id",
            "holdout_usage_state"
          ],
          "properties": {
            "research_stage": {
              "const": "validation"
            },
            "trial_kind": {
              "type": [
                "string",
                "null"
              ]
            },
            "retry_of_run_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "holdout_usage_state": {
              "type": "string"
            }
          }
        },
        "resolved_computation_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "product",
            "exact_contract",
            "strategy_name",
            "initial_capital",
            "multiplier",
            "price_tick",
            "currency",
            "snapshot_locator",
            "snapshot_sha256",
            "snapshot_byte_length",
            "provenance"
          ],
          "properties": {
            "profile": {
              "const": "research_lab.single_contract_backtest.v1"
            },
            "product": {
              "type": "string",
              "minLength": 1
            },
            "exact_contract": {
              "type": "string",
              "minLength": 1
            },
            "strategy_name": {
              "type": "string",
              "minLength": 1
            },
            "initial_capital": {
              "type": "string"
            },
            "multiplier": {
              "type": "string"
            },
            "price_tick": {
              "type": "string"
            },
            "currency": {
              "const": "CNY"
            },
            "commission_bps": {
              "type": "string"
            },
            "slippage_ticks": {
              "type": "integer"
            },
            "snapshot_locator": {
              "type": "string",
              "minLength": 1
            },
            "snapshot_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "snapshot_byte_length": {
              "type": "integer",
              "minimum": 1
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            },
            "stop_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "scientific_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "started_at",
            "completed_at",
            "recorded_at"
          ],
          "properties": {
            "started_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "completed_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "recorded_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "process_exit_code": {
          "type": "integer"
        },
        "run_content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "run_status": {
                "const": "COMPLETED"
              }
            }
          },
          "then": {
            "properties": {
              "process_exit_code": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "run_status": {
                "const": "FAILED"
              }
            }
          },
          "then": {
            "properties": {
              "process_exit_code": {
                "not": {
                  "const": 0
                }
              }
            }
          }
        }
      ]
    }
  }
}
