  "process_entries": {
    "frontend-edge": {
      "service_id": "frontend-edge",
      "image_id": "vnpy-web-bridge-frontend",
      "entrypoint": "nginx -c /etc/nginx/nginx.conf -g 'daemon off;'",
      "listen": "0.0.0.0:8080",
      "health": [
        "/health/live",
        "/health/ready",
        "/version"
      ]
    },
    "control-api": {
      "service_id": "control-api",
      "image_id": "vnpy-web-bridge-control-api",
      "entrypoint": "uvicorn app.control_api:app --host 0.0.0.0 --port 8081 --app-dir backend",
      "listen": "0.0.0.0:8081",
      "health": [
        "/health/live",
        "/health/ready",
        "/version"
      ]
    },
    "execution-orchestrator": {
      "service_id": "execution-orchestrator",
      "image_id": "vnpy-web-bridge-execution",
      "entrypoint": "python -m app.execution_orchestrator",
      "listen": "0.0.0.0:8090",
      "health": [
        "/health/live",
        "/health/ready",
        "/version"
      ]
    },
    "gateway-rpc-request-proxy": {
      "service_id": "gateway-rpc-request-proxy",
      "image_id": "vnpy-web-bridge-gateway-proxy",
      "entrypoint": "socat TCP-LISTEN:$PROXY_LISTEN_PORT,fork,reuseaddr TCP:$WINDOWS_RPC_REQ_ADDRESS",
      "listen": "0.0.0.0:$GATEWAY_RPC_REQ_PROXY_PORT,0.0.0.0:18080",
      "health": [
        "/health/live",
        "/health/ready",
        "/version"
      ]
    },
    "gateway-rpc-publish-proxy": {
      "service_id": "gateway-rpc-publish-proxy",
      "image_id": "vnpy-web-bridge-gateway-proxy",
      "entrypoint": "socat TCP-LISTEN:$PROXY_LISTEN_PORT,fork,reuseaddr TCP:$WINDOWS_RPC_PUB_ADDRESS",
      "listen": "0.0.0.0:$GATEWAY_RPC_PUB_PROXY_PORT,0.0.0.0:18080",
      "health": [
        "/health/live",
        "/health/ready",
        "/version"
      ]
    },
    "questdb": {
      "service_id": "questdb",
      "image_id": "questdb/questdb:9.4.3",
      "entrypoint": "image_default",
      "listen": "questdb:9000,questdb:8812,questdb:9009",
      "health": [
        "tcp:questdb:8812"
      ]
    },
    "postgres": {
      "service_id": "postgres",
      "image_id": "postgres:16-alpine",
      "entrypoint": "image_default",
      "listen": "postgres:5432",
      "health": [
        "pg_isready"
      ]
    },
    "windows-ctp-gateway": {
      "service_id": "windows-ctp-gateway",
      "image_id": "external:VnpyRpcService",
      "entrypoint": "external_service",
      "listen": "tcp://192.168.100.187:2014,tcp://192.168.100.187:4102",
      "health": [
        "typed_rpc_snapshot"
      ]
    }
  },
