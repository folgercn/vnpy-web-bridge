  "state_ownership": {
    "active_plan": {
      "owner": "execution-orchestrator",
      "store": "execution_durable_state",
      "non_owner_behavior": "control_api_read_only_projection_and_idempotent_command"
    },
    "effective_authority": {
      "owner": "execution-orchestrator",
      "store": "execution_durable_state",
      "non_owner_behavior": "control_api_requests_enable_or_revoke; signer_only_creates_immutable_bytes"
    },
    "send_intent": {
      "owner": "execution-orchestrator",
      "store": "execution_durable_state",
      "non_owner_behavior": "no_replay; timeout_requires_query_same_intent"
    },
    "unknown_outcome": {
      "owner": "execution-orchestrator",
      "store": "execution_durable_state",
      "non_owner_behavior": "all_mutation_blocked_until_broker_reconciliation"
    },
    "leader_lease_and_fencing": {
      "owner": "execution-orchestrator",
      "store": "execution_durable_state",
      "format": "JSON durable state with atomic fsync and compare_and_swap",
      "non_owner_behavior": "standby_read_only; Postgres is not a lease owner"
    },
    "broker_facts": {
      "owner": "windows-ctp-gateway",
      "store": "windows_gateway_durable_facts",
      "non_owner_behavior": "execution_persists_projection_and_reconciles; control_only_reads"
    },
    "audit_index": {
      "owner": "control-api",
      "store": "postgres_control_schema",
      "non_owner_behavior": "execution_emits_receipts; cannot rewrite_control_audit"
    }
  },
  "leader_fencing_contract": {
    "scope": "account_and_environment",
    "lease_store": "execution_durable_state_json",
    "acquisition": "compare_and_swap_owner_epoch_and_expiry",
    "epoch": "strictly_monotonic_never_reused",
    "fencing_token": "strictly_monotonic_account_scoped_never_reused",
    "mutation_binding": [
      "leader_epoch",
      "fencing_token",
      "plan_id",
      "plan_hash",
      "intent_id",
      "idempotency_key"
    ],
    "final_admission": "windows_gateway_rejects_missing_stale_or_unbound_token_for_send_and_cancel",
    "lease_loss": "fail_closed_and_stop_mutation",
    "db_unavailable": "fail_closed_and_stop_mutation",
    "clock_rollback": "fail_closed_and_stop_mutation",
    "restart": "HALTED_RECONCILE_REQUIRED_until_fresh_broker_snapshot_and_unknown_outcomes_closed",
    "rpc_timeout": "unknown_outcome_query_same_intent_no_new_send",
    "double_leader": "only_latest_cas_epoch_can_mutate; stale process rejected at gateway"
  },
