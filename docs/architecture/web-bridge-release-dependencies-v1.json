  "closure_requirements": {
    "container_copy": {
      "required": true,
      "containerfile_patterns": ["Dockerfile", "**/Dockerfile*", "**/Containerfile*"],
      "requirements": [
        "parse every COPY and ADD source after Docker ignore evaluation",
        "track named and numeric multi-stage COPY lineage",
        "map every repository source to each consuming build unit",
        "recompute closure when a build file, ignore file or build context changes",
        "block on wildcard expansion drift, missing source, remote ADD, generated untracked input or unresolved build argument",
        "verify the built OCI inventory matches the declared closure"
      ]
    },
    "python_import": {
      "required": true,
      "roots": ["backend/", "scripts/"],
      "requirements": [
        "resolve repository-local imports transitively from each entrypoint",
        "record optional and dynamic imports with explicit allowlisted manifests",
        "include package data, JSON schemas and files opened through repository-relative paths",
        "block when one source is imported by units not present in the release plan",
        "test import closure inside the built image"
      ]
    },
    "typescript_import": {
      "required": true,
      "roots": ["frontend/src/", "frontend/scripts/", "frontend/vite.config.ts"],
      "requirements": [
        "resolve TypeScript, Vue, CSS and JSON imports transitively",
        "include Vite public assets and HTML entrypoints",
        "include shared/trading_session_profiles.json",
        "treat package.json and package-lock.json as frontend build inputs",
        "block unresolved aliases, generated assets or files outside the declared build context"
      ]
    },
