{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:commodity-c-fast-p0-acceptance-v2",
  "title": "C_FAST query-v3 exact-evidence P0 acceptance v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "candidate_id", "parent_issue_number",
    "issue_number", "acceptance_id", "accepted_at", "signer_key_id",
    "signer_type", "reviewer_role", "human_signature",
    "acceptance_keyring_sha256", "release_id", "attempt_id",
    "readiness_packet_id", "snapshot_id", "audit_window", "consumed_at",
    "started_at", "final_revalidation_at", "ended_at", "keyring_sha256",
    "bundle_raw_sha256", "bundle_canonical_sha256", "artifact_sha256",
    "bundle_index_sha256", "external_archive",
    "external_archive_verification_state", "terminal_state",
    "query_execution_state", "child_exit_code",
    "production_query_attempted", "production_query_completed", "p0_pass",
    "proof_verified", "write_probe_attempted",
    "database_mutations_observed", "web_bridge_rpc_calls", "orders_sent",
    "positions_modified", "dispatch_changed", "p0_accepted",
    "p0_acceptance_scope", "source_terminal_integrity_scope",
    "acceptance_is_authority", "query_authorized",
    "t1_one_shot_child_launch_authorized", "replay_allowed",
    "collection_authorized", "execution_quality_collection_authorized",
    "runtime_activation_authorized", "web_bridge_rpc_authorized",
    "network_query_authorized", "readonly_production_query_authorized",
    "order_authorized", "order_submission_authorized",
    "position_mutation_authorized", "dispatch_authorized",
    "trading_authorized", "strategy_activation_authorized",
    "replacement_authorized", "production_authorized",
    "automatic_promotion_authorized", "dynamic_selection_allowed",
    "database_mutation_authorized", "deployment_mutation_authorized",
    "readonly_principal_deployment_authorized",
    "readonly_secret_file_installation_authorized",
    "questdb_restart_authorized", "questdb_recreate_authorized",
    "questdb_image_change_authorized", "writer_identity_mutation_authorized",
    "writer_secret_mutation_authorized", "network_mutation_authorized",
    "unscoped_deployment_mutation_authorized",
    "web_bridge_deployment_authorized", "signature"
  ],
  "properties": {
    "schema_version": {"const": "commodity_c_fast_p0_acceptance_v2"},
    "purpose": {"const": "c_fast_query_v3_p0_exact_evidence_acceptance"},
    "candidate_id": {"const": "C_FAST_CROSS_SECTION_NEUTRAL"},
    "parent_issue_number": {"const": 114},
    "issue_number": {"const": 136},
    "acceptance_id": {"type": "string", "pattern": "^p0-v2-accept-[0-9a-f]{64}$"},
    "accepted_at": {"$ref": "#/$defs/dateTime"},
    "signer_key_id": {"$ref": "#/$defs/id"},
    "signer_type": {"const": "human"},
    "reviewer_role": {"type": "string", "minLength": 1, "maxLength": 128},
    "human_signature": {"type": "string", "minLength": 1, "maxLength": 512},
    "acceptance_keyring_sha256": {"$ref": "#/$defs/sha256"},
    "release_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/attemptId"},
    "readiness_packet_id": {
      "type": "string",
      "pattern": "^readiness-v2-[0-9a-f]{64}$"
    },
    "snapshot_id": {"$ref": "#/$defs/id"},
    "audit_window": {"$ref": "#/$defs/auditWindow"},
    "consumed_at": {"$ref": "#/$defs/dateTime"},
    "started_at": {"$ref": "#/$defs/dateTime"},
    "final_revalidation_at": {"$ref": "#/$defs/dateTime"},
    "ended_at": {"$ref": "#/$defs/dateTime"},
    "keyring_sha256": {"$ref": "#/$defs/keyringHashes"},
    "bundle_raw_sha256": {"$ref": "#/$defs/rawBundleHashes"},
    "bundle_canonical_sha256": {"$ref": "#/$defs/canonicalBundleHashes"},
    "artifact_sha256": {"$ref": "#/$defs/artifactHashes"},
    "bundle_index_sha256": {"$ref": "#/$defs/sha256"},
    "external_archive": {"$ref": "#/$defs/externalArchive"},
    "external_archive_verification_state": {
      "const": "HUMAN_ASSERTION_NOT_MACHINE_VERIFIED"
    },
    "terminal_state": {"const": "COMPLETED_EVIDENCE_P0_PASS"},
    "query_execution_state": {"const": "COMPLETED"},
    "child_exit_code": {"const": 0},
    "production_query_attempted": {"const": true},
    "production_query_completed": {"const": true},
    "p0_pass": {"const": true},
    "proof_verified": {"const": true},
    "write_probe_attempted": {"const": false},
    "database_mutations_observed": {"const": 0},
    "web_bridge_rpc_calls": {"const": 0},
    "orders_sent": {"const": 0},
    "positions_modified": {"const": 0},
    "dispatch_changed": {"const": false},
    "p0_accepted": {"const": true},
    "p0_acceptance_scope": {
      "const": "HISTORICAL_QUERY_V3_EXACT_EVIDENCE_ONLY"
    },
    "source_terminal_integrity_scope": {
      "const": "CREATE_ONLY_LOCAL_RECORD_REQUIRES_EXTERNAL_CUSTODY"
    },
    "acceptance_is_authority": {"const": false},
    "query_authorized": {"const": false},
    "t1_one_shot_child_launch_authorized": {"const": false},
    "replay_allowed": {"const": false},
    "collection_authorized": {"const": false},
    "execution_quality_collection_authorized": {"const": false},
    "runtime_activation_authorized": {"const": false},
    "web_bridge_rpc_authorized": {"const": false},
    "network_query_authorized": {"const": false},
    "readonly_production_query_authorized": {"const": false},
    "order_authorized": {"const": false},
    "order_submission_authorized": {"const": false},
    "position_mutation_authorized": {"const": false},
    "dispatch_authorized": {"const": false},
    "trading_authorized": {"const": false},
    "strategy_activation_authorized": {"const": false},
    "replacement_authorized": {"const": false},
    "production_authorized": {"const": false},
    "automatic_promotion_authorized": {"const": false},
    "dynamic_selection_allowed": {"const": false},
    "database_mutation_authorized": {"const": false},
    "deployment_mutation_authorized": {"const": false},
    "readonly_principal_deployment_authorized": {"const": false},
    "readonly_secret_file_installation_authorized": {"const": false},
    "questdb_restart_authorized": {"const": false},
    "questdb_recreate_authorized": {"const": false},
    "questdb_image_change_authorized": {"const": false},
    "writer_identity_mutation_authorized": {"const": false},
    "writer_secret_mutation_authorized": {"const": false},
    "network_mutation_authorized": {"const": false},
    "unscoped_deployment_mutation_authorized": {"const": false},
    "web_bridge_deployment_authorized": {"const": false},
    "signature": {"type": "string", "minLength": 1, "maxLength": 256}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$"},
    "attemptId": {"type": "string", "pattern": "^attempt-[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dateTime": {"type": "string", "format": "date-time"},
    "auditWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end_exclusive", "trading_day"],
      "properties": {
        "start": {"$ref": "#/$defs/dateTime"},
        "end_exclusive": {"$ref": "#/$defs/dateTime"},
        "trading_day": {"type": "string", "pattern": "^[0-9]{8}$"}
      }
    },
    "keyringHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "provenance", "t1", "l3", "outcome"],
      "properties": {
        "query": {"$ref": "#/$defs/sha256"},
        "provenance": {"$ref": "#/$defs/sha256"},
        "t1": {"$ref": "#/$defs/sha256"},
        "l3": {"$ref": "#/$defs/sha256"},
        "outcome": {"$ref": "#/$defs/sha256"}
      }
    },
    "rawBundleHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_release", "query_trusted_keyring", "readiness_packet",
        "content_attestation", "provenance", "provenance_trusted_keyring",
        "t1_trusted_keyring", "l3_trusted_keyring", "l3_release", "outcome",
        "outcome_trusted_keyring", "manifest", "consume_marker",
        "child_launch_marker", "audit_child_invocation",
        "pre_connect_gate", "query_child_invocation", "terminal_seal",
        "audit_json", "audit_csv", "audit_markdown", "readonly_proof"
      ],
      "properties": {
        "query_release": {"$ref": "#/$defs/sha256"},
        "query_trusted_keyring": {"$ref": "#/$defs/sha256"},
        "readiness_packet": {"$ref": "#/$defs/sha256"},
        "content_attestation": {"$ref": "#/$defs/sha256"},
        "provenance": {"$ref": "#/$defs/sha256"},
        "provenance_trusted_keyring": {"$ref": "#/$defs/sha256"},
        "t1_trusted_keyring": {"$ref": "#/$defs/sha256"},
        "l3_trusted_keyring": {"$ref": "#/$defs/sha256"},
        "l3_release": {"$ref": "#/$defs/sha256"},
        "outcome": {"$ref": "#/$defs/sha256"},
        "outcome_trusted_keyring": {"$ref": "#/$defs/sha256"},
        "manifest": {"$ref": "#/$defs/sha256"},
        "consume_marker": {"$ref": "#/$defs/sha256"},
        "child_launch_marker": {"$ref": "#/$defs/sha256"},
        "audit_child_invocation": {"$ref": "#/$defs/sha256"},
        "pre_connect_gate": {"$ref": "#/$defs/sha256"},
        "query_child_invocation": {"$ref": "#/$defs/sha256"},
        "terminal_seal": {"$ref": "#/$defs/sha256"},
        "audit_json": {"$ref": "#/$defs/sha256"},
        "audit_csv": {"$ref": "#/$defs/sha256"},
        "audit_markdown": {"$ref": "#/$defs/sha256"},
        "readonly_proof": {"$ref": "#/$defs/sha256"}
      }
    },
    "canonicalBundleHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_release", "query_trusted_keyring", "readiness_packet",
        "content_attestation", "provenance", "provenance_trusted_keyring",
        "t1_trusted_keyring", "l3_trusted_keyring", "l3_release", "outcome",
        "outcome_trusted_keyring", "manifest", "consume_marker",
        "child_launch_marker", "audit_child_invocation",
        "pre_connect_gate", "query_child_invocation", "terminal_seal",
        "audit_json", "readonly_proof"
      ],
      "properties": {
        "query_release": {"$ref": "#/$defs/sha256"},
        "query_trusted_keyring": {"$ref": "#/$defs/sha256"},
        "readiness_packet": {"$ref": "#/$defs/sha256"},
        "content_attestation": {"$ref": "#/$defs/sha256"},
        "provenance": {"$ref": "#/$defs/sha256"},
        "provenance_trusted_keyring": {"$ref": "#/$defs/sha256"},
        "t1_trusted_keyring": {"$ref": "#/$defs/sha256"},
        "l3_trusted_keyring": {"$ref": "#/$defs/sha256"},
        "l3_release": {"$ref": "#/$defs/sha256"},
        "outcome": {"$ref": "#/$defs/sha256"},
        "outcome_trusted_keyring": {"$ref": "#/$defs/sha256"},
        "manifest": {"$ref": "#/$defs/sha256"},
        "consume_marker": {"$ref": "#/$defs/sha256"},
        "child_launch_marker": {"$ref": "#/$defs/sha256"},
        "audit_child_invocation": {"$ref": "#/$defs/sha256"},
        "pre_connect_gate": {"$ref": "#/$defs/sha256"},
        "query_child_invocation": {"$ref": "#/$defs/sha256"},
        "terminal_seal": {"$ref": "#/$defs/sha256"},
        "audit_json": {"$ref": "#/$defs/sha256"},
        "readonly_proof": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_json", "audit_csv", "audit_markdown", "readonly_proof"],
      "properties": {
        "audit_json": {"$ref": "#/$defs/sha256"},
        "audit_csv": {"$ref": "#/$defs/sha256"},
        "audit_markdown": {"$ref": "#/$defs/sha256"},
        "readonly_proof": {"$ref": "#/$defs/sha256"}
      }
    },
    "externalArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custody_id", "asserted_archive_type", "archive_locator_sha256",
        "custody_identity_raw_sha256",
        "custody_identity_canonical_sha256",
        "archived_bundle_index_sha256", "archived_at",
        "independent_custody_asserted", "immutability_asserted"
      ],
      "properties": {
        "custody_id": {"$ref": "#/$defs/id"},
        "asserted_archive_type": {
          "enum": ["ASSERTED_WORM", "ASSERTED_APPEND_ONLY"]
        },
        "archive_locator_sha256": {"$ref": "#/$defs/sha256"},
        "custody_identity_raw_sha256": {"$ref": "#/$defs/sha256"},
        "custody_identity_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "archived_bundle_index_sha256": {"$ref": "#/$defs/sha256"},
        "archived_at": {"$ref": "#/$defs/dateTime"},
        "independent_custody_asserted": {"const": true},
        "immutability_asserted": {"const": true}
      }
    }
  }
}
