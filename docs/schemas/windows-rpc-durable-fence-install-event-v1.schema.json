          {"properties": {"event_sequence": {"const": 2}, "publish_receipt_raw_sha256": {"type": "null"}, "restart_authorization_raw_sha256": {"type": "null"}, "restart_dispatch_nonce_sha256": {"type": "null"}, "service_config_transition_receipt_raw_sha256": {"type": "null"}, "scm_dispatch_evidence_raw_sha256": {"type": "null"}, "startup_receipt_raw_sha256": {"type": "null"}, "service_control_operation_id": {"type": "null"}}},
          {"properties": {"event_sequence": {"const": 3}, "publish_receipt_raw_sha256": {"type": "string"}, "restart_authorization_raw_sha256": {"type": "null"}, "restart_dispatch_nonce_sha256": {"type": "null"}, "service_config_transition_receipt_raw_sha256": {"type": "null"}, "scm_dispatch_evidence_raw_sha256": {"type": "null"}, "startup_receipt_raw_sha256": {"type": "null"}, "service_control_operation_id": {"type": "null"}}},
          {"properties": {"event_sequence": {"const": 4}, "publish_receipt_raw_sha256": {"type": "string"}, "restart_authorization_raw_sha256": {"type": "string"}, "restart_dispatch_nonce_sha256": {"type": "string"}, "service_config_transition_receipt_raw_sha256": {"type": "null"}, "scm_dispatch_evidence_raw_sha256": {"type": "null"}, "startup_receipt_raw_sha256": {"type": "null"}, "service_control_operation_id": {"type": "string"}}},
