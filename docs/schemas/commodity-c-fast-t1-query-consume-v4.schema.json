{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:commodity-c-fast-t1-query-consume-v4",
  "title": "C_FAST T1 readonly query consume marker v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "candidate_id", "release_id", "attempt_id",
    "release_raw_sha256", "release_canonical_sha256", "consumed_at",
    "readiness_packet_id", "readiness_packet_raw_sha256",
    "readiness_packet_canonical_sha256",
    "content_attestation_raw_sha256",
    "content_attestation_canonical_sha256",
    "provenance_raw_sha256", "provenance_canonical_sha256",
    "outcome_raw_sha256", "outcome_canonical_sha256", "manifest_raw_sha256",
    "manifest_canonical_sha256", "trusted_keyring_sha256",
    "custody_identity_sha256", "custody_path_sha256",
    "consume_precedes_final_revalidation", "query_started",
    "production_queried", "consume_is_authority", "replay_allowed"
  ],
  "properties": {
    "schema_version": {"const": "commodity_c_fast_t1_query_consume_v4"},
    "purpose": {"const": "c_fast_t1_query_v4_consume_before_final_revalidation"},
    "candidate_id": {"const": "C_FAST_CROSS_SECTION_NEUTRAL"},
    "release_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/attemptId"},
    "release_raw_sha256": {"$ref": "#/$defs/sha256"},
    "release_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "consumed_at": {"$ref": "#/$defs/dateTime"},
    "readiness_packet_id": {"type": "string", "pattern": "^readiness-v3-[0-9a-f]{64}$"},
    "readiness_packet_raw_sha256": {"$ref": "#/$defs/sha256"},
    "readiness_packet_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "content_attestation_raw_sha256": {"$ref": "#/$defs/sha256"},
    "content_attestation_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "provenance_raw_sha256": {"$ref": "#/$defs/sha256"},
    "provenance_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "outcome_raw_sha256": {"$ref": "#/$defs/sha256"},
    "outcome_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_raw_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "trusted_keyring_sha256": {"$ref": "#/$defs/sha256"},
    "custody_identity_sha256": {"$ref": "#/$defs/sha256"},
    "custody_path_sha256": {"$ref": "#/$defs/sha256"},
    "consume_precedes_final_revalidation": {"const": true},
    "query_started": {"const": false},
    "production_queried": {"const": false},
    "consume_is_authority": {"const": false},
    "replay_allowed": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$"},
    "attemptId": {"type": "string", "pattern": "^attempt-[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dateTime": {"type": "string", "format": "date-time"}
  }
}
