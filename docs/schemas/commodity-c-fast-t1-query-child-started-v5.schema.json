{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:commodity-c-fast-t1-query-child-started-v5",
  "title": "C_FAST query-v5 child launch claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "candidate_id", "release_id", "attempt_id", "claimed_at",
    "release_raw_sha256", "release_canonical_sha256", "consume_marker_raw_sha256",
    "consume_marker_canonical_sha256", "readiness_v4_raw_sha256",
    "readiness_v4_canonical_sha256", "l3_outcome_raw_sha256", "l3_outcome_canonical_sha256",
    "query_manifest_raw_sha256", "query_manifest_canonical_sha256", "runtime_identity_sha256",
    "custody_path_sha256", "custody_identity_sha256", "custody_directory_identity_sha256",
    "dsn_file_identity_attestation_raw_sha256", "dsn_file_identity_attestation_canonical_sha256",
    "expected_readonly_principal_sha256", "expected_endpoint_identity_sha256",
    "runtime_runner_sha256", "query_child_sha256", "audit_script_sha256",
    "query_child_invocation_raw_sha256", "query_child_invocation_canonical_sha256",
    "audit_invocation_raw_sha256", "audit_invocation_canonical_sha256",
    "pre_connect_gate_raw_sha256", "pre_connect_gate_canonical_sha256",
    "parent_launch_capability_sha256", "launch_marker_identity_sha256",
    "launch_capability_binding_sha256", "claim_precedes_final_revalidation",
    "claim_precedes_dsn_read", "claim_precedes_network", "final_revalidation_completed",
    "dsn_read", "network_attempted", "production_query_attempted", "launch_claim_is_authority",
    "database_mutation_authorized", "collection_authorized", "order_authorized",
    "position_mutation_authorized", "dispatch_authorized", "trading_authorized",
    "production_authorized", "replay_allowed"
  ],
  "properties": {
    "schema_version": {"const": "commodity_c_fast_t1_query_child_started_v5"},
    "purpose": {"const": "c_fast_t1_query_v5_child_claim_before_final_revalidation_and_dsn"},
    "candidate_id": {"const": "C_FAST_CROSS_SECTION_NEUTRAL"},
    "release_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/attemptId"},
    "claimed_at": {"type": "string", "format": "date-time"},
    "release_raw_sha256": {"$ref": "#/$defs/sha256"},
    "release_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "consume_marker_raw_sha256": {"$ref": "#/$defs/sha256"},
    "consume_marker_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "readiness_v4_raw_sha256": {"$ref": "#/$defs/sha256"},
    "readiness_v4_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "l3_outcome_raw_sha256": {"$ref": "#/$defs/sha256"},
    "l3_outcome_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "query_manifest_raw_sha256": {"$ref": "#/$defs/sha256"},
    "query_manifest_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_identity_sha256": {"$ref": "#/$defs/sha256"},
    "custody_path_sha256": {"$ref": "#/$defs/sha256"},
    "custody_identity_sha256": {"$ref": "#/$defs/sha256"},
    "custody_directory_identity_sha256": {"$ref": "#/$defs/sha256"},
    "dsn_file_identity_attestation_raw_sha256": {"$ref": "#/$defs/sha256"},
    "dsn_file_identity_attestation_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "expected_readonly_principal_sha256": {"$ref": "#/$defs/sha256"},
    "expected_endpoint_identity_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_runner_sha256": {"$ref": "#/$defs/sha256"},
    "query_child_sha256": {"$ref": "#/$defs/sha256"},
    "audit_script_sha256": {"$ref": "#/$defs/sha256"},
    "query_child_invocation_raw_sha256": {"$ref": "#/$defs/sha256"},
    "query_child_invocation_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "audit_invocation_raw_sha256": {"$ref": "#/$defs/sha256"},
    "audit_invocation_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "pre_connect_gate_raw_sha256": {"$ref": "#/$defs/sha256"},
    "pre_connect_gate_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "parent_launch_capability_sha256": {"$ref": "#/$defs/sha256"},
    "launch_marker_identity_sha256": {"$ref": "#/$defs/sha256"},
    "launch_capability_binding_sha256": {"$ref": "#/$defs/sha256"},
    "claim_precedes_final_revalidation": {"const": true},
    "claim_precedes_dsn_read": {"const": true},
    "claim_precedes_network": {"const": true},
    "final_revalidation_completed": {"const": false},
    "dsn_read": {"const": false},
    "network_attempted": {"const": false},
    "production_query_attempted": {"const": false},
    "launch_claim_is_authority": {"const": false},
    "database_mutation_authorized": {"const": false},
    "collection_authorized": {"const": false},
    "order_authorized": {"const": false},
    "position_mutation_authorized": {"const": false},
    "dispatch_authorized": {"const": false},
    "trading_authorized": {"const": false},
    "production_authorized": {"const": false},
    "replay_allowed": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "attemptId": {"type": "string", "pattern": "^attempt-[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
