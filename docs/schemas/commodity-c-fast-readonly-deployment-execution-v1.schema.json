{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:commodity-c-fast-readonly-deployment-execution-v1",
  "title": "C_FAST readonly deployment execution record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "candidate_id",
    "release_id",
    "attempt_id",
    "contract_source_commit_sha",
    "release_raw_sha256",
    "consume_marker_raw_sha256",
    "receipt_raw_sha256",
    "deployment_plan_raw_sha256",
    "questdb_target_identity_sha256",
    "questdb_image_digest_before",
    "questdb_image_digest_after",
    "questdb_container_identity_sha256_before",
    "questdb_container_identity_sha256_after",
    "deployment_started_at",
    "secret_installed_at",
    "restart_started_at",
    "restart_completed_at",
    "deployment_ended_at",
    "restart_method",
    "restart_count",
    "restart_exit_code",
    "readonly_principal_configuration_installed",
    "readonly_secret_file_installed",
    "questdb_recreated",
    "questdb_image_changed",
    "questdb_container_identity_changed",
    "rollback_invoked",
    "production_queries_executed",
    "readonly_queries_executed",
    "write_probes_attempted",
    "database_mutations",
    "web_bridge_rpc_calls",
    "orders_sent",
    "positions_modified",
    "dispatch_changed",
    "secret_content_included"
  ],
  "properties": {
    "schema_version": {"const": "commodity_c_fast_readonly_deployment_execution_v1"},
    "record_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"const": "C_FAST_CROSS_SECTION_NEUTRAL"},
    "release_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/attemptId"},
    "contract_source_commit_sha": {"$ref": "#/$defs/commit"},
    "release_raw_sha256": {"$ref": "#/$defs/sha256"},
    "consume_marker_raw_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "deployment_plan_raw_sha256": {"$ref": "#/$defs/sha256"},
    "questdb_target_identity_sha256": {"$ref": "#/$defs/sha256"},
    "questdb_image_digest_before": {"$ref": "#/$defs/imageDigest"},
    "questdb_image_digest_after": {"$ref": "#/$defs/imageDigest"},
    "questdb_container_identity_sha256_before": {"$ref": "#/$defs/sha256"},
    "questdb_container_identity_sha256_after": {"$ref": "#/$defs/sha256"},
    "deployment_started_at": {"$ref": "#/$defs/dateTime"},
    "secret_installed_at": {"$ref": "#/$defs/dateTime"},
    "restart_started_at": {"$ref": "#/$defs/dateTime"},
    "restart_completed_at": {"$ref": "#/$defs/dateTime"},
    "deployment_ended_at": {"$ref": "#/$defs/dateTime"},
    "restart_method": {"const": "exact_existing_questdb_service_restart_v1"},
    "restart_count": {"const": 1},
    "restart_exit_code": {"const": 0},
    "readonly_principal_configuration_installed": {"const": true},
    "readonly_secret_file_installed": {"const": true},
    "questdb_recreated": {"const": false},
    "questdb_image_changed": {"const": false},
    "questdb_container_identity_changed": {"const": false},
    "rollback_invoked": {"const": false},
    "production_queries_executed": {"const": 0},
    "readonly_queries_executed": {"const": 0},
    "write_probes_attempted": {"const": 0},
    "database_mutations": {"const": 0},
    "web_bridge_rpc_calls": {"const": 0},
    "orders_sent": {"const": 0},
    "positions_modified": {"const": 0},
    "dispatch_changed": {"const": false},
    "secret_content_included": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$"},
    "attemptId": {"type": "string", "pattern": "^attempt-[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "imageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dateTime": {"type": "string", "format": "date-time"}
  }
}
