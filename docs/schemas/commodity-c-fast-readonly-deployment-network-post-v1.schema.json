{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:commodity-c-fast-readonly-deployment-network-post-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attestation_id", "candidate_id", "release_id", "attempt_id",
    "release_raw_sha256", "consume_marker_raw_sha256", "receipt_raw_sha256",
    "captured_at", "capture_method", "isolated_network_identity_sha256",
    "driver", "internal", "runner_member_identity_sha256",
    "questdb_member_identity_sha256", "member_count",
    "unexpected_member_identity_sha256s", "docker_socket_connectivity",
    "rpc_connectivity", "trading_connectivity", "secret_content_included"
  ],
  "properties": {
    "schema_version": {"const": "commodity_c_fast_readonly_deployment_network_post_v1"},
    "attestation_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"const": "C_FAST_CROSS_SECTION_NEUTRAL"},
    "release_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/attemptId"},
    "release_raw_sha256": {"$ref": "#/$defs/sha256"},
    "consume_marker_raw_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "captured_at": {"$ref": "#/$defs/dateTime"},
    "capture_method": {"const": "isolated_network_post_restart_inspection_v1"},
    "isolated_network_identity_sha256": {"$ref": "#/$defs/sha256"},
    "driver": {"const": "bridge"},
    "internal": {"const": true},
    "runner_member_identity_sha256": {"$ref": "#/$defs/sha256"},
    "questdb_member_identity_sha256": {"$ref": "#/$defs/sha256"},
    "member_count": {"const": 2},
    "unexpected_member_identity_sha256s": {"type": "array", "maxItems": 0},
    "docker_socket_connectivity": {"const": false},
    "rpc_connectivity": {"const": false},
    "trading_connectivity": {"const": false},
    "secret_content_included": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$"},
    "attemptId": {"type": "string", "pattern": "^attempt-[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dateTime": {"type": "string", "format": "date-time"}
  }
}
