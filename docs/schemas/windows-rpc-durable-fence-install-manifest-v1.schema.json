{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vnpy.example/schemas/windows-rpc-durable-fence-install-manifest-v1.json",
  "title": "Signed Windows RPC durable fence install manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "manifest_id", "manifest_core_sha256",
    "install_attempt_id", "attempt_nonce_sha256", "issued_at_utc", "expires_at_utc", "trusted_clock_id",
    "service_name", "store_path_sha256", "store_volume_serial",
    "store_volume_identity_sha256",
    "store_id", "store_owner_sid_sha256", "store_directory_acl_sddl_sha256", "store_state_acl_sddl_sha256",
    "bundle_sha256", "publish_mode", "final_version_directory_path_sha256",
    "expected_final_owner_sid_sha256", "expected_final_directory_acl_sddl_sha256",
    "expected_component_acl_sddl_sha256", "extension_version",
    "wrapper_sha256", "wrapper_destination_path_sha256",
    "extension_sha256", "extension_destination_path_sha256", "launcher_sha256",
    "launcher_destination_path_sha256", "assembly_sha256",
    "assembly_destination_path_sha256", "config_sha256",
    "config_destination_path_sha256", "service_image_path_canonical_sha256",
    "service_config_canonical_sha256", "expected_service_config_owner_sid_sha256",
    "expected_service_config_acl_sddl_sha256", "installer_write_access_after_publish",
    "preinstall_service_image_path_canonical_sha256",
    "preinstall_service_config_canonical_sha256",
    "safety_service_config_canonical_sha256",
    "service_config_transition_plan_sha256",
    "service_config_mutation_before_dispatch_reservation_authorized",
    "service_config_transition_after_dispatch_reservation_authorized",
    "unbound_service_config_mutation_after_observer_seal_authorized",
    "target_service_start_type", "target_recovery_actions_disabled",
    "target_failure_actions_disabled", "automatic_policy_restore_authorized",
    "expected_installer_principal_sid_sha256",
    "expected_installer_process_image_sha256",
    "python_class_sha256", "python_path_sha256",
    "target_state_schema_version",
    "preflight_receipt_id", "preflight_receipt_raw_sha256",
    "install_authorized", "restart_authorized", "automatic_restart_allowed",
    "authority", "canonicalization_profile", "signature_domain_separator",
    "signature_algorithm", "signer_role", "signer_key_domain",
    "signer_key_id",
    "signer_public_key_sha256", "signature"
  ],
  "properties": {
    "schema_version": {"const": "windows_rpc_durable_fence_install_manifest_v1"},
    "purpose": {"const": "authorize_exact_windows_fence_files_and_one_post_reservation_service_config_transition_without_restart"},
    "manifest_id": {"type": "string", "pattern": "^windows-fence-install-manifest-[0-9a-f]{64}$"},
    "manifest_core_sha256": {"$ref": "#/$defs/sha256"},
    "install_attempt_id": {"$ref": "#/$defs/attemptId"},
    "attempt_nonce_sha256": {"$ref": "#/$defs/sha256"},
    "issued_at_utc": {"$ref": "#/$defs/utc"},
    "expires_at_utc": {"$ref": "#/$defs/utc"},
    "trusted_clock_id": {"$ref": "#/$defs/identifier"},
    "service_name": {"$ref": "#/$defs/serviceName"},
    "store_path_sha256": {"$ref": "#/$defs/sha256"},
    "store_volume_serial": {"type": "string", "pattern": "^[A-F0-9]{8,32}$"},
    "store_volume_identity_sha256": {"$ref": "#/$defs/sha256"},
    "store_id": {"type": "string", "pattern": "^windows-fence-store-[0-9a-f]{64}$"},
    "store_owner_sid_sha256": {"$ref": "#/$defs/sha256"},
    "store_directory_acl_sddl_sha256": {"$ref": "#/$defs/sha256"},
    "store_state_acl_sddl_sha256": {"$ref": "#/$defs/sha256"},
    "bundle_sha256": {"$ref": "#/$defs/sha256"},
    "publish_mode": {"const": "atomic_content_addressed_final_directory"},
    "final_version_directory_path_sha256": {"$ref": "#/$defs/sha256"},
    "expected_final_owner_sid_sha256": {"$ref": "#/$defs/sha256"},
    "expected_final_directory_acl_sddl_sha256": {"$ref": "#/$defs/sha256"},
    "expected_component_acl_sddl_sha256": {"$ref": "#/$defs/sha256"},
    "extension_version": {"const": "windows-rpc-durable-fence-foundation-v1"},
    "wrapper_sha256": {"$ref": "#/$defs/sha256"},
    "wrapper_destination_path_sha256": {"$ref": "#/$defs/sha256"},
    "extension_sha256": {"$ref": "#/$defs/sha256"},
    "extension_destination_path_sha256": {"$ref": "#/$defs/sha256"},
    "launcher_sha256": {"$ref": "#/$defs/sha256"},
    "launcher_destination_path_sha256": {"$ref": "#/$defs/sha256"},
    "assembly_sha256": {"$ref": "#/$defs/sha256"},
    "assembly_destination_path_sha256": {"$ref": "#/$defs/sha256"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "config_destination_path_sha256": {"$ref": "#/$defs/sha256"},
    "service_image_path_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "expected_service_config_owner_sid_sha256": {"$ref": "#/$defs/sha256"},
    "expected_service_config_acl_sddl_sha256": {"$ref": "#/$defs/sha256"},
    "installer_write_access_after_publish": {"const": false},
    "preinstall_service_image_path_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "preinstall_service_config_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "safety_service_config_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_transition_plan_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_mutation_before_dispatch_reservation_authorized": {"const": false},
    "service_config_transition_after_dispatch_reservation_authorized": {"const": true},
    "unbound_service_config_mutation_after_observer_seal_authorized": {"const": false},
    "target_service_start_type": {"const": "DEMAND_START"},
    "target_recovery_actions_disabled": {"const": true},
    "target_failure_actions_disabled": {"const": true},
    "automatic_policy_restore_authorized": {"const": false},
    "expected_installer_principal_sid_sha256": {"$ref": "#/$defs/sha256"},
    "expected_installer_process_image_sha256": {"$ref": "#/$defs/sha256"},
    "python_class_sha256": {"$ref": "#/$defs/sha256"},
    "python_path_sha256": {"$ref": "#/$defs/sha256"},
    "target_state_schema_version": {"const": "windows_rpc_durable_fence_state_v1"},
    "preflight_receipt_id": {"type": "string", "pattern": "^windows-fence-preflight-[0-9a-f]{64}$"},
    "preflight_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "install_authorized": {"const": true},
    "restart_authorized": {"const": false},
    "automatic_restart_allowed": {"const": false},
    "authority": {"$ref": "#/$defs/authority"},
    "canonicalization_profile": {"const": "windows-foundation-canonical-json-v1"},
    "signature_domain_separator": {"const": "vnpy.issue267.windows-foundation.install-manifest.v1"},
    "signature_algorithm": {"const": "Ed25519"},
    "signer_role": {"const": "windows-foundation-manifest-signer"},
    "signer_key_domain": {"const": "dedicated-windows-foundation-manifest-signing-v1"},
    "signer_key_id": {"type": "string", "pattern": "^windows-foundation-manifest-signer:[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "signer_public_key_sha256": {"$ref": "#/$defs/sha256"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attemptId": {"type": "string", "pattern": "^windows-fence-install-[0-9a-f]{64}$"},
    "serviceName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "keyId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["windows_fence_released", "authority_restore_allowed", "consume_authorized", "reconciliation_authorized", "deployment_authorized", "automatic_deploy_allowed", "production_allowed", "live_trading_authorized", "send_order_authorized", "cancel_order_authorized", "countable_forward"],
      "properties": {
        "windows_fence_released": {"const": false}, "authority_restore_allowed": {"const": false},
        "consume_authorized": {"const": false}, "reconciliation_authorized": {"const": false},
        "deployment_authorized": {"const": false}, "automatic_deploy_allowed": {"const": false},
        "production_allowed": {"const": false}, "live_trading_authorized": {"const": false},
        "send_order_authorized": {"const": false}, "cancel_order_authorized": {"const": false},
        "countable_forward": {"const": false}
      }
    }
  }
}
