{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:commodity-c-fast-readonly-deployment-outcome-v1",
  "title": "C_FAST independently signed readonly deployment post-outcome v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "candidate_id", "issue_number", "outcome_id",
    "issued_at", "signer_key_id", "signer_key_purpose", "signer_type",
    "reviewer_role", "human_signature", "outcome_keyring_sha256",
    "release_keyring_sha256", "t1_keyring_sha256",
    "outcome_contract_source_commit_assertion",
    "release_source_commit_sha",
    "verifier_sha256", "outcome_schema_sha256", "post_schema_sha256",
    "release_id", "attempt_id", "questdb_target_identity_sha256",
    "questdb_image_digest", "release_raw_sha256",
    "release_canonical_sha256", "consume_marker_raw_sha256",
    "receipt_raw_sha256", "pre_evidence_bundle_index_sha256",
    "pre_evidence_raw_sha256", "post_evidence_raw_sha256",
    "post_evidence_bundle_index_sha256", "consumed_at", "verified_at",
    "deployment_started_at", "restart_started_at", "restart_completed_at",
    "deployment_ended_at", "deployment_outcome_state", "deployment_executed",
    "restart_executed", "restart_count", "writer_continuity_verified",
    "post_restart_health_verified", "backlog_drain_verified",
    "readonly_principal_verified", "secret_file_verified",
    "isolated_network_verified", "production_queries_executed",
    "readonly_queries_executed", "write_probes_attempted",
    "database_mutations", "web_bridge_rpc_calls", "orders_sent",
    "positions_modified", "dispatch_changed", "receipt_is_authority",
    "outcome_is_authority", "raw_signed_release_required_for_audit",
    "replay_allowed", "readiness_authorized",
    "readonly_principal_deployment_authorized",
    "readonly_secret_file_installation_authorized",
    "questdb_restart_authorized", "questdb_recreate_authorized",
    "questdb_image_change_authorized", "writer_identity_mutation_authorized",
    "writer_secret_mutation_authorized", "network_mutation_authorized",
    "unscoped_deployment_mutation_authorized", "production_query_authorized",
    "readonly_query_authorized", "collection_authorized",
    "write_probe_authorized", "database_mutation_authorized",
    "order_authorized", "position_mutation_authorized",
    "dispatch_authorized", "trading_authorized",
    "strategy_activation_authorized", "automatic_promotion_authorized",
    "web_bridge_deployment_authorized", "deployment_mutation_authorized",
    "runtime_activation_authorized", "dynamic_selection_allowed",
    "replacement_authorized", "production_authorized", "signature"
  ],
  "properties": {
    "schema_version": {"const": "commodity_c_fast_readonly_deployment_outcome_v1"},
    "purpose": {"const": "c_fast_questdb_readonly_deployment_post_outcome"},
    "candidate_id": {"const": "C_FAST_CROSS_SECTION_NEUTRAL"},
    "issue_number": {"const": 114},
    "outcome_id": {"type": "string", "pattern": "^readonly-outcome-[0-9a-f]{64}$"},
    "issued_at": {"$ref": "#/$defs/dateTime"},
    "signer_key_id": {"$ref": "#/$defs/id"},
    "signer_key_purpose": {"const": "readonly_deployment_outcome_signer"},
    "signer_type": {"const": "human"},
    "reviewer_role": {"type": "string", "minLength": 1, "maxLength": 128},
    "human_signature": {"type": "string", "minLength": 1, "maxLength": 512},
    "outcome_keyring_sha256": {"$ref": "#/$defs/sha256"},
    "release_keyring_sha256": {"$ref": "#/$defs/sha256"},
    "t1_keyring_sha256": {"$ref": "#/$defs/sha256"},
    "outcome_contract_source_commit_assertion": {"$ref": "#/$defs/commit"},
    "release_source_commit_sha": {"$ref": "#/$defs/commit"},
    "verifier_sha256": {"$ref": "#/$defs/sha256"},
    "outcome_schema_sha256": {"$ref": "#/$defs/sha256"},
    "post_schema_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution", "writer_post", "health_post", "backlog_post", "principal_secret_post", "network_post"],
      "properties": {
        "execution": {"$ref": "#/$defs/sha256"},
        "writer_post": {"$ref": "#/$defs/sha256"},
        "health_post": {"$ref": "#/$defs/sha256"},
        "backlog_post": {"$ref": "#/$defs/sha256"},
        "principal_secret_post": {"$ref": "#/$defs/sha256"},
        "network_post": {"$ref": "#/$defs/sha256"}
      }
    },
    "release_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/attemptId"},
    "questdb_target_identity_sha256": {"$ref": "#/$defs/sha256"},
    "questdb_image_digest": {"$ref": "#/$defs/imageDigest"},
    "release_raw_sha256": {"$ref": "#/$defs/sha256"},
    "release_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "consume_marker_raw_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "pre_evidence_bundle_index_sha256": {"$ref": "#/$defs/sha256"},
    "pre_evidence_raw_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questdb_image_attestation", "readonly_principal_identity_attestation",
        "secret_file_identity_attestation", "writer_continuity_pre_evidence",
        "writer_continuity_post_evidence", "health_evidence",
        "backlog_evidence", "rollback_plan",
        "root_pin_identity_attestation", "custody_path_identity_attestation",
        "isolated_network_attestation", "deployment_plan"
      ],
      "properties": {
        "questdb_image_attestation": {"$ref": "#/$defs/sha256"},
        "readonly_principal_identity_attestation": {"$ref": "#/$defs/sha256"},
        "secret_file_identity_attestation": {"$ref": "#/$defs/sha256"},
        "writer_continuity_pre_evidence": {"$ref": "#/$defs/sha256"},
        "writer_continuity_post_evidence": {"$ref": "#/$defs/sha256"},
        "health_evidence": {"$ref": "#/$defs/sha256"},
        "backlog_evidence": {"$ref": "#/$defs/sha256"},
        "rollback_plan": {"$ref": "#/$defs/sha256"},
        "root_pin_identity_attestation": {"$ref": "#/$defs/sha256"},
        "custody_path_identity_attestation": {"$ref": "#/$defs/sha256"},
        "isolated_network_attestation": {"$ref": "#/$defs/sha256"},
        "deployment_plan": {"$ref": "#/$defs/sha256"}
      }
    },
    "post_evidence_raw_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution", "writer_post", "health_post", "backlog_post", "principal_secret_post", "network_post"],
      "properties": {
        "execution": {"$ref": "#/$defs/sha256"},
        "writer_post": {"$ref": "#/$defs/sha256"},
        "health_post": {"$ref": "#/$defs/sha256"},
        "backlog_post": {"$ref": "#/$defs/sha256"},
        "principal_secret_post": {"$ref": "#/$defs/sha256"},
        "network_post": {"$ref": "#/$defs/sha256"}
      }
    },
    "post_evidence_bundle_index_sha256": {"$ref": "#/$defs/sha256"},
    "consumed_at": {"$ref": "#/$defs/dateTime"},
    "verified_at": {"$ref": "#/$defs/dateTime"},
    "deployment_started_at": {"$ref": "#/$defs/dateTime"},
    "restart_started_at": {"$ref": "#/$defs/dateTime"},
    "restart_completed_at": {"$ref": "#/$defs/dateTime"},
    "deployment_ended_at": {"$ref": "#/$defs/dateTime"},
    "deployment_outcome_state": {"const": "SUCCEEDED_POSTCHECKS_VERIFIED"},
    "deployment_executed": {"const": true},
    "restart_executed": {"const": true},
    "restart_count": {"const": 1},
    "writer_continuity_verified": {"const": true},
    "post_restart_health_verified": {"const": true},
    "backlog_drain_verified": {"const": true},
    "readonly_principal_verified": {"const": true},
    "secret_file_verified": {"const": true},
    "isolated_network_verified": {"const": true},
    "production_queries_executed": {"const": 0},
    "readonly_queries_executed": {"const": 0},
    "write_probes_attempted": {"const": 0},
    "database_mutations": {"const": 0},
    "web_bridge_rpc_calls": {"const": 0},
    "orders_sent": {"const": 0},
    "positions_modified": {"const": 0},
    "dispatch_changed": {"const": false},
    "receipt_is_authority": {"const": false},
    "outcome_is_authority": {"const": false},
    "raw_signed_release_required_for_audit": {"const": true},
    "replay_allowed": {"const": false},
    "readiness_authorized": {"const": false},
    "readonly_principal_deployment_authorized": {"const": false},
    "readonly_secret_file_installation_authorized": {"const": false},
    "questdb_restart_authorized": {"const": false},
    "questdb_recreate_authorized": {"const": false},
    "questdb_image_change_authorized": {"const": false},
    "writer_identity_mutation_authorized": {"const": false},
    "writer_secret_mutation_authorized": {"const": false},
    "network_mutation_authorized": {"const": false},
    "unscoped_deployment_mutation_authorized": {"const": false},
    "production_query_authorized": {"const": false},
    "readonly_query_authorized": {"const": false},
    "collection_authorized": {"const": false},
    "write_probe_authorized": {"const": false},
    "database_mutation_authorized": {"const": false},
    "order_authorized": {"const": false},
    "position_mutation_authorized": {"const": false},
    "dispatch_authorized": {"const": false},
    "trading_authorized": {"const": false},
    "strategy_activation_authorized": {"const": false},
    "automatic_promotion_authorized": {"const": false},
    "web_bridge_deployment_authorized": {"const": false},
    "deployment_mutation_authorized": {"const": false},
    "runtime_activation_authorized": {"const": false},
    "dynamic_selection_allowed": {"const": false},
    "replacement_authorized": {"const": false},
    "production_authorized": {"const": false},
    "signature": {"type": "string", "minLength": 1, "maxLength": 256}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$"},
    "attemptId": {"type": "string", "pattern": "^attempt-[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "imageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dateTime": {"type": "string", "format": "date-time"}
  }
}
