{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:web-bridge-safe-restart-online-recheck-v1",
  "title": "Web Bridge safe restart online recheck v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "purpose", "online_recheck_id", "recheck_core_sha256", "receipt_id", "receipt_raw_sha256", "original_checkpoint_raw_sha256", "recheck_checkpoint_raw_sha256", "request_id", "runtime_instance_id", "drain_epoch", "execution_epoch", "deployment_attempt_id", "release_plan_core_sha256", "restart_action_sha256", "windows_server_instance_id", "owner_challenge_sha256", "fresh_challenge_sha256", "original_rpc_generation", "recheck_rpc_generation", "original_execution_facts_canonical_sha256", "recheck_execution_facts_canonical_sha256", "original_state_sha256", "recheck_state_sha256", "original_active_orders_snapshot_sha256", "recheck_active_orders_snapshot_sha256", "original_positions_snapshot_sha256", "recheck_positions_snapshot_sha256", "checked_at", "semantic_safety_unchanged", "one_shot_consume_allowed", "reconciliation_authorized", "deployment_authorized", "automatic_deploy_allowed", "production_allowed", "live_trading_authorized", "countable_forward"],
  "properties": {
    "schema_version": {"const": "web_bridge_safe_restart_online_recheck_v1"},
    "purpose": {"const": "record_non_authorizing_fresh_online_restart_recheck"},
    "online_recheck_id": {"type": "string", "pattern": "^safe-restart-online-recheck-(?!0{64}$)[0-9a-f]{64}$"},
    "recheck_core_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_id": {"type": "string", "pattern": "^safe-restart-(?!0{64}$)[0-9a-f]{64}$"},
    "receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "original_checkpoint_raw_sha256": {"$ref": "#/$defs/sha256"},
    "recheck_checkpoint_raw_sha256": {"$ref": "#/$defs/sha256"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "runtime_instance_id": {"$ref": "#/$defs/identifier"},
    "drain_epoch": {"type": "integer", "minimum": 1},
    "execution_epoch": {"type": "integer", "minimum": 1},
    "deployment_attempt_id": {"$ref": "#/$defs/identifier"},
    "release_plan_core_sha256": {"$ref": "#/$defs/sha256"},
    "restart_action_sha256": {"$ref": "#/$defs/sha256"},
    "windows_server_instance_id": {"$ref": "#/$defs/identifier"},
    "owner_challenge_sha256": {"$ref": "#/$defs/sha256"},
    "fresh_challenge_sha256": {"$ref": "#/$defs/sha256"},
    "original_rpc_generation": {"type": "integer", "minimum": 0},
    "recheck_rpc_generation": {"type": "integer", "minimum": 0},
    "original_execution_facts_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "recheck_execution_facts_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "original_state_sha256": {"$ref": "#/$defs/sha256"},
    "recheck_state_sha256": {"$ref": "#/$defs/sha256"},
    "original_active_orders_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "recheck_active_orders_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "original_positions_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "recheck_positions_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "checked_at": {"$ref": "#/$defs/dateTime"},
    "semantic_safety_unchanged": {"const": true},
    "one_shot_consume_allowed": {"const": false},
    "reconciliation_authorized": {"const": false},
    "deployment_authorized": {"const": false},
    "automatic_deploy_allowed": {"const": false},
    "production_allowed": {"const": false},
    "live_trading_authorized": {"const": false},
    "countable_forward": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "dateTime": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
