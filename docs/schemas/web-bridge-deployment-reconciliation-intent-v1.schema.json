  "required": [
    "schema_version",
    "purpose",
    "mode",
    "intent_id",
    "intent_slot_sha256",
    "intent_core_sha256",
    "intent_path",
    "reconciliation_run_id",
    "operator",
    "reason",
    "custody_inventory_id",
    "custody_inventory_core_sha256",
    "custody_inventory_raw_sha256",
    "custody_inventory_digest_sha256",
    "genesis_commitment_raw_sha256",
    "current_state_commitment_raw_sha256",
    "current_state_raw_sha256",
    "current_epoch_anchor_raw_sha256",
    "current_state_generation",
    "current_runtime_instance_id",
    "current_execution_epoch",
    "owner_binding_raw_sha256",
    "owner_binding",
    "rpc_request_id",
    "owner_challenge",
