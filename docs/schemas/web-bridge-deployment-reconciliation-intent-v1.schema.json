      "title": "Custody Inventory Core Sha256",
      "type": "string"
    },
    "custody_inventory_raw_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Custody Inventory Raw Sha256",
      "type": "string"
    },
    "custody_inventory_digest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
