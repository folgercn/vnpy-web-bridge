      "type": "integer"
    },
    "previous_activation_head_id": {
      "title": "Previous Activation Head Id",
      "type": "null"
    },
    "previous_activation_head_raw_sha256": {
      "title": "Previous Activation Head Raw Sha256",
      "type": "null"
    },
    "previous_activation_head_core_sha256": {
      "title": "Previous Activation Head Core Sha256",
      "type": "null"
    },
    "external_high_water_verified": {
      "const": false,
      "title": "External High Water Verified",
      "type": "boolean"
    },
    "target_runtime_verified": {
