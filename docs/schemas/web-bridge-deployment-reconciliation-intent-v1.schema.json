    "reconciliation_run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$",
      "title": "Reconciliation Run Id",
      "type": "string"
    },
    "operator": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Operator",
      "type": "string"
    },
    "reason": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "custody_inventory_id": {
      "pattern": "^deployment-reconciliation-custody-inventory-[0-9a-f]{64}$",
      "title": "Custody Inventory Id",
      "type": "string"
