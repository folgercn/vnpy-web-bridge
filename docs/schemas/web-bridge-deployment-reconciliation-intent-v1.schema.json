    "genesis_commitment_raw_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Genesis Commitment Raw Sha256",
      "type": "string"
    },
    "current_state_commitment_raw_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Current State Commitment Raw Sha256",
      "type": "string"
    },
    "current_state_raw_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Current State Raw Sha256",
      "type": "string"
    },
    "current_epoch_anchor_raw_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Current Epoch Anchor Raw Sha256",
      "type": "string"
    },
    "current_state_generation": {
      "minimum": 2,
      "title": "Current State Generation",
      "type": "integer"
    },
    "current_runtime_instance_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$",
      "title": "Current Runtime Instance Id",
      "type": "string"
    },
    "current_execution_epoch": {
      "minimum": 1,
      "title": "Current Execution Epoch",
      "type": "integer"
    },
    "owner_binding_raw_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Owner Binding Raw Sha256",
      "type": "string"
    },
    "owner_binding": {
      "$ref": "#/$defs/DeploymentReconciliationOwnerBindingDTO"
    },
    "rpc_request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$",
      "title": "Rpc Request Id",
      "type": "string"
    },
    "owner_challenge": {
      "pattern": "^[A-Za-z0-9_-]{16,128}$",
      "title": "Owner Challenge",
      "type": "string"
    },
    "initial_capture_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$",
      "title": "Initial Capture Id",
      "type": "string"
    },
    "initial_challenge": {
      "pattern": "^[A-Za-z0-9_-]{16,128}$",
      "title": "Initial Challenge",
      "type": "string"
    },
    "fresh_capture_id": {
      "pattern": "^deployment-recheck-[0-9a-f]{64}$",
