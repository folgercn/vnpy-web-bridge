{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:commodity-c-fast-t1-query-v5-pre-dsn-gate-receipt-v1",
  "title": "C_FAST query-v5 final pre-DSN gate receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "candidate_id", "release_id", "attempt_id",
    "verified_at", "release_raw_sha256", "release_canonical_sha256",
    "release_signer_public_key_sha256", "provenance_raw_sha256",
    "provenance_canonical_sha256", "provenance_signer_public_key_sha256",
    "composition_attestation_raw_sha256",
    "composition_attestation_canonical_sha256", "runtime_source_commit_sha",
    "runtime_image_reference", "runtime_image_digest", "runtime_image_id",
    "final_oci_layout_archive_sha256", "registry_identity_sha256",
    "registry_push_receipt_sha256",
    "composition_attestation_runtime_image_digest",
    "composition_attestation_runtime_identity_sha256",
    "composition_attestation_runtime_repo_digest_verified",
    "exact_registry_repo_digest_bound", "key_domains_separated",
    "release_consumed", "query_child_implemented", "dsn_read",
    "network_attempted", "production_query_attempted",
    "production_query_completed", "receipt_is_authority",
    "authority_granted", "runtime_activation_authorized",
    "database_mutation_authorized", "collection_authorized",
    "order_authorized", "position_mutation_authorized",
    "dispatch_authorized", "trading_authorized", "production_authorized",
    "database_mutations", "orders_sent", "positions_modified",
    "dispatch_changed"
  ],
  "properties": {
    "schema_version": {"const": "commodity_c_fast_t1_query_v5_pre_dsn_gate_receipt_v1"},
    "status": {"const": "RELEASE_V5_AND_EXACT_FINAL_IMAGE_PROVENANCE_VERIFIED_PRE_DSN_STOP"},
    "candidate_id": {"const": "C_FAST_CROSS_SECTION_NEUTRAL"},
    "release_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"type": "string", "pattern": "^attempt-[0-9a-f]{64}$"},
    "verified_at": {"type": "string", "format": "date-time"},
    "release_raw_sha256": {"$ref": "#/$defs/sha256"},
    "release_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "release_signer_public_key_sha256": {"$ref": "#/$defs/sha256"},
    "provenance_raw_sha256": {"$ref": "#/$defs/sha256"},
    "provenance_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "provenance_signer_public_key_sha256": {"$ref": "#/$defs/sha256"},
    "composition_attestation_raw_sha256": {"$ref": "#/$defs/sha256"},
    "composition_attestation_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_source_commit_sha": {"$ref": "#/$defs/commit"},
    "runtime_image_reference": {"$ref": "#/$defs/imageReference"},
    "runtime_image_digest": {"$ref": "#/$defs/ociDigest"},
    "runtime_image_id": {"$ref": "#/$defs/ociDigest"},
    "final_oci_layout_archive_sha256": {"$ref": "#/$defs/sha256"},
    "registry_identity_sha256": {"$ref": "#/$defs/sha256"},
    "registry_push_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "composition_attestation_runtime_image_digest": {"$ref": "#/$defs/ociDigest"},
    "composition_attestation_runtime_identity_sha256": {"$ref": "#/$defs/sha256"},
    "composition_attestation_runtime_repo_digest_verified": {"const": true},
    "exact_registry_repo_digest_bound": {"const": true},
    "key_domains_separated": {"const": true},
    "release_consumed": {"const": false},
    "query_child_implemented": {"const": false},
    "dsn_read": {"const": false},
    "network_attempted": {"const": false},
    "production_query_attempted": {"const": false},
    "production_query_completed": {"const": false},
    "receipt_is_authority": {"const": false},
    "authority_granted": {"const": false},
    "runtime_activation_authorized": {"const": false},
    "database_mutation_authorized": {"const": false},
    "collection_authorized": {"const": false},
    "order_authorized": {"const": false},
    "position_mutation_authorized": {"const": false},
    "dispatch_authorized": {"const": false},
    "trading_authorized": {"const": false},
    "production_authorized": {"const": false},
    "database_mutations": {"const": 0},
    "orders_sent": {"const": 0},
    "positions_modified": {"const": 0},
    "dispatch_changed": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ociDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "imageReference": {"type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"}
  }
}
