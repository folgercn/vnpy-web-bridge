{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:commodity-c-fast-p0-acceptance-v2-trusted-keys-v1",
  "title": "C_FAST P0 acceptance-v2 dedicated trusted Ed25519 keys",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {
      "const": "commodity_c_fast_p0_acceptance_v2_trusted_keys_v1"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "purpose", "public_key_base64"],
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{8,128}$"
          },
          "purpose": {
            "const": "c_fast_query_v3_p0_acceptance_v2_signer"
          },
          "public_key_base64": {
            "type": "string",
            "minLength": 44,
            "maxLength": 44
          }
        }
      }
    }
  }
}
