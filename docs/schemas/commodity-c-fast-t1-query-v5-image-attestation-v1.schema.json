{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:commodity-c-fast-t1-query-v5-image-attestation-v1",
  "title": "C_FAST T1 query-v5 replayed base and final OCI composition attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "query_v4_source_commit_sha",
    "source_commit_sha", "query_v4_content_attestation_raw_sha256",
    "query_v4_content_attestation_canonical_sha256",
    "query_v4_oci_layout_archive_sha256", "source_bundle_archive_sha256",
    "source_manifest_raw_sha256", "source_manifest_canonical_sha256",
    "external_evidence_sha256", "evidence_captured_at",
    "containerfile_sha256", "verifier_sha256", "attestation_runtime",
    "source_manifest_schema_sha256", "evidence_schema_sha256",
    "attestation_schema_sha256", "query_v4_image_reference",
    "query_v4_image_digest", "query_v4_image_id", "image_reference",
    "image_digest", "image_id", "query_v4_rootfs_layer_digests",
    "query_v4_rootfs_diff_ids", "overlay_layer_digests",
    "overlay_diff_ids", "overlay_layer_header_contract_sha256",
    "rootfs_layer_digests", "rootfs_diff_ids",
    "overlay_touched_paths", "python_execution_closure_sha256",
    "python_execution_closure_entries", "runtime_bundle_sha256",
    "runtime_bundle_index_sha256", "checks", "image_built_here",
    "cryptographic_approval_present", "sensitive_material_present",
    "authority_granted", "network_authorized",
    "production_query_authorized", "collection_authorized",
    "deployment_mutation_authorized", "runtime_activation_authorized",
    "order_authorized", "position_mutation_authorized",
    "dispatch_authorized", "trading_authorized", "production_authorized",
    "database_mutations", "orders_sent", "positions_modified",
    "dispatch_changed"
  ],
  "properties": {
    "schema_version": {"const": "commodity_c_fast_t1_query_v5_image_attestation_v1"},
    "status": {"const": "QUERY_V5_BASE_AND_OVERLAY_OCI_COMPOSITION_VERIFIED_NO_BUILD_OR_REGISTRY_PROVENANCE"},
    "query_v4_source_commit_sha": {"$ref": "#/$defs/commit"},
    "source_commit_sha": {"$ref": "#/$defs/commit"},
    "query_v4_content_attestation_raw_sha256": {"$ref": "#/$defs/sha256"},
    "query_v4_content_attestation_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "query_v4_oci_layout_archive_sha256": {"$ref": "#/$defs/sha256"},
    "source_bundle_archive_sha256": {"$ref": "#/$defs/sha256"},
    "source_manifest_raw_sha256": {"$ref": "#/$defs/sha256"},
    "source_manifest_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "external_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_captured_at": {"type": "string", "format": "date-time"},
    "containerfile_sha256": {"$ref": "#/$defs/sha256"},
    "verifier_sha256": {"$ref": "#/$defs/sha256"},
    "attestation_runtime": {"$ref": "#/$defs/attestationRuntime"},
    "source_manifest_schema_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_schema_sha256": {"$ref": "#/$defs/sha256"},
    "attestation_schema_sha256": {"$ref": "#/$defs/sha256"},
    "query_v4_image_reference": {"$ref": "#/$defs/imageReference"},
    "query_v4_image_digest": {"$ref": "#/$defs/ociDigest"},
    "query_v4_image_id": {"$ref": "#/$defs/ociDigest"},
    "image_reference": {"$ref": "#/$defs/imageReference"},
    "image_digest": {"$ref": "#/$defs/ociDigest"},
    "image_id": {"$ref": "#/$defs/ociDigest"},
    "query_v4_rootfs_layer_digests": {"$ref": "#/$defs/digestList"},
    "query_v4_rootfs_diff_ids": {"$ref": "#/$defs/digestList"},
    "overlay_layer_digests": {"$ref": "#/$defs/digestList"},
    "overlay_diff_ids": {"$ref": "#/$defs/digestList"},
    "overlay_layer_header_contract_sha256": {"$ref": "#/$defs/shaList"},
    "rootfs_layer_digests": {"$ref": "#/$defs/digestList"},
    "rootfs_diff_ids": {"$ref": "#/$defs/digestList"},
    "overlay_touched_paths": {"$ref": "#/$defs/pathList"},
    "python_execution_closure_sha256": {"$ref": "#/$defs/sha256"},
    "python_execution_closure_entries": {"type": "integer", "minimum": 1, "maximum": 100000},
    "runtime_bundle_sha256": {"$ref": "#/$defs/runtimeBundle"},
    "runtime_bundle_index_sha256": {"$ref": "#/$defs/sha256"},
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": [
        "query_v4_content_attestation_replayed", "query_v4_raw_oci_recomputed",
        "source_bundle_and_manifest_recomputed",
        "containerfile_instruction_contract_matched",
        "oci_manifest_config_and_layers_recomputed",
        "query_v4_layer_descriptor_prefix_verified",
        "query_v4_diff_id_prefix_verified",
        "inherited_oci_config_fields_frozen", "overlay_whiteouts_absent",
        "overlay_base_overwrites_absent", "overlay_path_allowlist_verified",
        "overlay_links_and_special_files_absent",
        "overlay_layers_strict_ustar_verified",
        "all_overlay_layer_contents_sensitive_free",
        "merged_python_execution_closure_frozen",
        "runtime_bundle_matches_source_bundle",
        "immutable_image_reference_matched", "build_provenance_verified",
        "registry_provenance_verified"
      ],
      "properties": {
        "query_v4_content_attestation_replayed": {"const": true},
        "query_v4_raw_oci_recomputed": {"const": true},
        "source_bundle_and_manifest_recomputed": {"const": true},
        "containerfile_instruction_contract_matched": {"const": true},
        "oci_manifest_config_and_layers_recomputed": {"const": true},
        "query_v4_layer_descriptor_prefix_verified": {"const": true},
        "query_v4_diff_id_prefix_verified": {"const": true},
        "inherited_oci_config_fields_frozen": {"const": true},
        "overlay_whiteouts_absent": {"const": true},
        "overlay_base_overwrites_absent": {"const": true},
        "overlay_path_allowlist_verified": {"const": true},
        "overlay_links_and_special_files_absent": {"const": true},
        "overlay_layers_strict_ustar_verified": {"const": true},
        "all_overlay_layer_contents_sensitive_free": {"const": true},
        "merged_python_execution_closure_frozen": {"const": true},
        "runtime_bundle_matches_source_bundle": {"const": true},
        "immutable_image_reference_matched": {"const": true},
        "build_provenance_verified": {"const": false},
        "registry_provenance_verified": {"const": false}
      }
    },
    "image_built_here": {"const": false},
    "cryptographic_approval_present": {"const": false},
    "sensitive_material_present": {"const": false},
    "authority_granted": {"const": false},
    "network_authorized": {"const": false},
    "production_query_authorized": {"const": false},
    "collection_authorized": {"const": false},
    "deployment_mutation_authorized": {"const": false},
    "runtime_activation_authorized": {"const": false},
    "order_authorized": {"const": false},
    "position_mutation_authorized": {"const": false},
    "dispatch_authorized": {"const": false},
    "trading_authorized": {"const": false},
    "production_authorized": {"const": false},
    "database_mutations": {"const": 0},
    "orders_sent": {"const": 0},
    "positions_modified": {"const": 0},
    "dispatch_changed": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ociDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "imageReference": {"type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"},
    "digestList": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {"$ref": "#/$defs/ociDigest"}
    },
    "shaList": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "pathList": {
      "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/(?:opt/c-fast-query-v5|run/c-fast-t1-query-v5-pins)(?:/[A-Za-z0-9._/-]+)?$"}
    },
    "runtimeBundle": {
      "type": "object", "minProperties": 1, "maxProperties": 16,
      "propertyNames": {"pattern": "^/opt/c-fast-query-v5/[A-Za-z0-9._/-]+$"},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "attestationRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "runtime_image_digest", "pin_manifest_sha256",
        "launcher_sha256", "verifier_sha256", "query_v4_verifier_sha256",
        "query_v4_delegate_sha256", "query_v5_validator_sha256",
        "query_v4_validator_sha256", "bootstrap_pin_sha256",
        "python_executable_path_sha256",
        "python_executable_sha256", "loaded_executable_sha256",
        "python_runtime_root_path_sha256", "python_runtime_closure_sha256",
        "native_runtime_root_path_sha256", "native_runtime_closure_sha256",
        "source_root_path_sha256", "source_root_identity_sha256",
        "source_closure_manifest_sha256", "bootstrap_source_closure_sha256",
        "dependency_root_path_sha256",
        "dependency_root_identity_sha256", "dependency_closure_manifest_sha256",
        "bootstrap_dependency_closure_sha256", "isolated_flags_verified",
        "pre_import_runtime_verified", "source_closure_retained",
        "immutable_runtime_verified", "runtime_identity_sha256"
      ],
      "properties": {
        "schema_version": {"const": "commodity_c_fast_t1_query_v5_image_attestation_runtime_identity_v1"},
        "runtime_image_digest": {"$ref": "#/$defs/ociDigest"},
        "pin_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "launcher_sha256": {"$ref": "#/$defs/sha256"},
        "verifier_sha256": {"$ref": "#/$defs/sha256"},
        "query_v4_verifier_sha256": {"$ref": "#/$defs/sha256"},
        "query_v4_delegate_sha256": {"$ref": "#/$defs/sha256"},
        "query_v5_validator_sha256": {"$ref": "#/$defs/sha256"},
        "query_v4_validator_sha256": {"$ref": "#/$defs/sha256"},
        "bootstrap_pin_sha256": {"$ref": "#/$defs/sha256"},
        "python_executable_path_sha256": {"$ref": "#/$defs/sha256"},
        "python_executable_sha256": {"$ref": "#/$defs/sha256"},
        "loaded_executable_sha256": {"$ref": "#/$defs/sha256"},
        "python_runtime_root_path_sha256": {"$ref": "#/$defs/sha256"},
        "python_runtime_closure_sha256": {"$ref": "#/$defs/sha256"},
        "native_runtime_root_path_sha256": {"$ref": "#/$defs/sha256"},
        "native_runtime_closure_sha256": {"$ref": "#/$defs/sha256"},
        "source_root_path_sha256": {"$ref": "#/$defs/sha256"},
        "source_root_identity_sha256": {"$ref": "#/$defs/sha256"},
        "source_closure_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "bootstrap_source_closure_sha256": {"$ref": "#/$defs/sha256"},
        "dependency_root_path_sha256": {"$ref": "#/$defs/sha256"},
        "dependency_root_identity_sha256": {"$ref": "#/$defs/sha256"},
        "dependency_closure_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "bootstrap_dependency_closure_sha256": {"$ref": "#/$defs/sha256"},
        "isolated_flags_verified": {"const": true},
        "pre_import_runtime_verified": {"const": true},
        "source_closure_retained": {"const": true},
        "immutable_runtime_verified": {"const": true},
        "runtime_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
