{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "issue-291-phase-b-custody-record-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sequence", "writer_id", "writer_epoch", "artifact", "receipt", "receipt_sha256", "previous_record_sha256", "production", "live", "countable_forward"],
  "properties": {
    "schema_version": {"const": "web-bridge-custody-record-v1"},
    "sequence": {"type": "integer", "minimum": 1},
    "writer_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"},
    "writer_epoch": {"type": "integer", "minimum": 1},
    "artifact": {"type": ["object", "null"]},
    "receipt": {"type": "object"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_record_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "production": {"const": false},
    "live": {"const": false},
    "countable_forward": {"const": false}
  }
}
