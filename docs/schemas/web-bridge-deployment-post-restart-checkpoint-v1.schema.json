{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:web-bridge-deployment-post-restart-checkpoint-v1",
  "title": "Web Bridge deployment post-restart checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "mode", "reconciliation_run_id", "checkpoint_id", "checkpoint_core_sha256",
    "consume_intent_id", "consume_intent_raw_sha256", "consume_intent_core_sha256",
    "consume_marker_id", "consume_marker_raw_sha256", "consume_marker_core_sha256",
    "receipt_id", "receipt_raw_sha256", "receipt_core_sha256",
    "online_recheck_id", "online_recheck_raw_sha256", "online_recheck_core_sha256",
    "request_id", "deployment_attempt_id", "release_plan_core_sha256", "restart_action_sha256",
    "drain_epoch", "previous_runtime_instance_id", "previous_execution_epoch",
    "current_runtime_instance_id", "current_execution_epoch",
    "consumed_windows_server_instance_id", "consumed_owner_challenge_sha256",
    "consumed_recheck_id", "consumed_fresh_challenge_sha256",
    "consumed_rpc_generation", "consumed_execution_facts_canonical_sha256",
    "consumed_execution_state_sha256", "consumed_active_orders_snapshot_sha256",
    "consumed_positions_snapshot_sha256", "current_state_commitment_id",
    "current_state_commitment_raw_sha256", "current_epoch_anchor_raw_sha256", "current_state_generation",
    "current_drain_state", "current_drain_state_raw_sha256",
    "post_restart_recheck_id", "post_restart_fresh_challenge_sha256", "windows_rpc",
    "current_active_orders_snapshot_sha256", "current_positions_snapshot_sha256", "captured_at",
    "windows_execution_admission_frozen", "semantic_safety_unchanged",
    "target_runtime_verified", "execution_facts_reconciliation_completed",
    "reconciliation_completed", "windows_fence_released", "authority_restore_allowed", "consume_authorized",
    "reconciliation_authorized", "deployment_authorized", "automatic_deploy_allowed",
    "production_allowed", "live_trading_authorized", "countable_forward"
  ],
  "properties": {
    "schema_version": {"const": "web_bridge_deployment_post_restart_checkpoint_v1"},
    "purpose": {"const": "record_non_authorizing_planned_restart_reconciliation_checkpoint"},
    "mode": {"const": "PLANNED_RESTART"},
    "reconciliation_run_id": {"$ref": "#/$defs/identifier"},
    "checkpoint_id": {"type": "string", "pattern": "^deployment-post-restart-checkpoint-(?!0{64}$)[0-9a-f]{64}$"},
    "checkpoint_core_sha256": {"$ref": "#/$defs/sha256"},
    "consume_intent_id": {"type": "string", "pattern": "^safe-restart-consume-intent-(?!0{64}$)[0-9a-f]{64}$"},
    "consume_intent_raw_sha256": {"$ref": "#/$defs/sha256"},
    "consume_intent_core_sha256": {"$ref": "#/$defs/sha256"},
    "consume_marker_id": {"type": "string", "pattern": "^safe-restart-consume-marker-(?!0{64}$)[0-9a-f]{64}$"},
    "consume_marker_raw_sha256": {"$ref": "#/$defs/sha256"},
    "consume_marker_core_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_id": {"type": "string", "pattern": "^safe-restart-(?!0{64}$)[0-9a-f]{64}$"},
    "receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_core_sha256": {"$ref": "#/$defs/sha256"},
    "online_recheck_id": {"type": "string", "pattern": "^safe-restart-online-recheck-(?!0{64}$)[0-9a-f]{64}$"},
    "online_recheck_raw_sha256": {"$ref": "#/$defs/sha256"},
    "online_recheck_core_sha256": {"$ref": "#/$defs/sha256"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "deployment_attempt_id": {"$ref": "#/$defs/identifier"},
    "release_plan_core_sha256": {"$ref": "#/$defs/sha256"},
    "restart_action_sha256": {"$ref": "#/$defs/sha256"},
    "drain_epoch": {"type": "integer", "minimum": 1},
    "previous_runtime_instance_id": {"$ref": "#/$defs/identifier"},
    "previous_execution_epoch": {"type": "integer", "minimum": 1},
    "current_runtime_instance_id": {"$ref": "#/$defs/identifier"},
    "current_execution_epoch": {"type": "integer", "minimum": 2},
    "consumed_windows_server_instance_id": {"$ref": "#/$defs/identifier"},
    "consumed_owner_challenge_sha256": {"$ref": "#/$defs/sha256"},
    "consumed_recheck_id": {"type": "string", "pattern": "^deployment-recheck-(?!0{64}$)[0-9a-f]{64}$"},
    "consumed_fresh_challenge_sha256": {"$ref": "#/$defs/sha256"},
    "consumed_rpc_generation": {"type": "integer", "minimum": 0},
    "consumed_execution_facts_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "consumed_execution_state_sha256": {"$ref": "#/$defs/sha256"},
    "consumed_active_orders_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "consumed_positions_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "current_state_commitment_id": {"type": "string", "pattern": "^deployment-drain-state-commitment-(?!0{64}$)[0-9a-f]{64}$"},
    "current_state_commitment_raw_sha256": {"$ref": "#/$defs/sha256"},
    "current_epoch_anchor_raw_sha256": {"$ref": "#/$defs/sha256"},
    "current_state_generation": {"type": "integer", "minimum": 1},
    "current_drain_state": {"$ref": "#/$defs/drainStateV3"},
    "current_drain_state_raw_sha256": {"$ref": "#/$defs/sha256"},
    "post_restart_recheck_id": {"type": "string", "pattern": "^deployment-recheck-(?!0{64}$)[0-9a-f]{64}$"},
    "post_restart_fresh_challenge_sha256": {"$ref": "#/$defs/sha256"},
    "windows_rpc": {"$ref": "#/$defs/rpcRecheckFacts"},
    "current_active_orders_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "current_positions_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "captured_at": {"$ref": "#/$defs/dateTime"},
    "windows_execution_admission_frozen": {"const": true},
    "semantic_safety_unchanged": {"const": true},
    "target_runtime_verified": {"const": false},
    "execution_facts_reconciliation_completed": {"const": true},
    "reconciliation_completed": {"const": false},
    "windows_fence_released": {"const": false},
    "authority_restore_allowed": {"const": false},
    "consume_authorized": {"const": false},
    "reconciliation_authorized": {"const": false},
    "deployment_authorized": {"const": false},
    "automatic_deploy_allowed": {"const": false},
    "production_allowed": {"const": false},
    "live_trading_authorized": {"const": false},
    "countable_forward": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "nonce": {"type": "string", "pattern": "^(?!0+$)[A-Za-z0-9_-]{16,128}$"},
    "dateTime": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "utcDateTime": {"type": "string", "format": "date-time", "pattern": "(Z|\\+00:00)$"},
    "rows": {"type": "array", "items": {"type": "object"}},
    "drainStateV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "state_generation", "previous_state_commitment_raw_sha256", "state",
        "drain_epoch", "execution_epoch", "runtime_instance_id", "active_request_id", "active_request_sha256",
        "active_receipt_id", "active_receipt_raw_sha256", "receipt_consumed", "consumed_at", "consume_id",
        "consumed_receipt_id", "consume_intent_raw_sha256", "consume_marker_raw_sha256",
        "consume_state_projection_sha256", "consumed_online_recheck_id", "consumed_online_recheck_raw_sha256",
        "preconsume_state_commitment_raw_sha256", "active_online_recheck_id", "active_online_recheck_raw_sha256",
        "active_recheck_checkpoint_raw_sha256", "online_rechecked_at", "last_invalidated_online_recheck_id",
        "last_invalidated_receipt_id", "blockers", "expires_at", "freeze_reason", "updated_at"
      ],
      "properties": {
        "schema_version": {"const": "web_bridge_deployment_drain_state_v3"},
        "state_generation": {"type": "integer", "minimum": 1},
        "previous_state_commitment_raw_sha256": {"$ref": "#/$defs/sha256"},
        "state": {"const": "RESTARTED_FROZEN"},
        "drain_epoch": {"type": "integer", "minimum": 1},
        "execution_epoch": {"type": "integer", "minimum": 2},
        "runtime_instance_id": {"$ref": "#/$defs/identifier"},
        "active_request_id": {"$ref": "#/$defs/identifier"},
        "active_request_sha256": {"$ref": "#/$defs/sha256"},
        "active_receipt_id": {"type": "null"},
        "active_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_consumed": {"const": true},
        "consumed_at": {"$ref": "#/$defs/utcDateTime"},
        "consume_id": {"type": "string", "pattern": "^safe-restart-consume-marker-(?!0{64}$)[0-9a-f]{64}$"},
        "consumed_receipt_id": {"type": "string", "pattern": "^safe-restart-(?!0{64}$)[0-9a-f]{64}$"},
        "consume_intent_raw_sha256": {"$ref": "#/$defs/sha256"},
        "consume_marker_raw_sha256": {"$ref": "#/$defs/sha256"},
        "consume_state_projection_sha256": {"$ref": "#/$defs/sha256"},
        "consumed_online_recheck_id": {"type": "string", "pattern": "^safe-restart-online-recheck-(?!0{64}$)[0-9a-f]{64}$"},
        "consumed_online_recheck_raw_sha256": {"$ref": "#/$defs/sha256"},
        "preconsume_state_commitment_raw_sha256": {"$ref": "#/$defs/sha256"},
        "active_online_recheck_id": {"type": "null"},
        "active_online_recheck_raw_sha256": {"type": "null"},
        "active_recheck_checkpoint_raw_sha256": {"type": "null"},
        "online_rechecked_at": {"type": "null"},
        "last_invalidated_online_recheck_id": {"type": "string", "pattern": "^safe-restart-online-recheck-(?!0{64}$)[0-9a-f]{64}$"},
        "last_invalidated_receipt_id": {"type": "string", "pattern": "^safe-restart-(?!0{64}$)[0-9a-f]{64}$"},
        "blockers": {"const": ["process_restarted_consumed_receipt_requires_reconciliation"]},
        "expires_at": {"$ref": "#/$defs/utcDateTime"},
        "freeze_reason": {"const": "process_restarted_consumed_receipt_requires_reconciliation"},
        "updated_at": {"$ref": "#/$defs/utcDateTime"}
      }
    },
    "rpcRecheckFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "owner_challenge", "recheck_id", "fresh_challenge", "original_server_instance_id", "original_fact_generation", "original_execution_facts_canonical_sha256", "server_instance_id", "fact_generation", "execution_facts_canonical_sha256", "captured_at", "execution_admission_frozen", "pending_send_outcomes", "strategy_execution_enabled", "account_hashes", "orders", "active_orders", "trades", "positions"],
      "properties": {
        "schema_version": {"const": "windows_rpc_deployment_safety_recheck_v1"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "owner_challenge": {"$ref": "#/$defs/nonce"},
        "recheck_id": {"type": "string", "pattern": "^deployment-recheck-(?!0{64}$)[0-9a-f]{64}$"},
        "fresh_challenge": {"$ref": "#/$defs/nonce"},
        "original_server_instance_id": {"$ref": "#/$defs/identifier"},
        "original_fact_generation": {"type": "integer", "minimum": 0},
        "original_execution_facts_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "server_instance_id": {"$ref": "#/$defs/identifier"},
        "fact_generation": {"type": "integer", "minimum": 0},
        "execution_facts_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "captured_at": {"$ref": "#/$defs/dateTime"},
        "execution_admission_frozen": {"const": true},
        "pending_send_outcomes": {"const": 0},
        "strategy_execution_enabled": {"const": false},
        "account_hashes": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "orders": {"$ref": "#/$defs/rows"},
        "active_orders": {"type": "array", "maxItems": 0},
        "trades": {"$ref": "#/$defs/rows"},
        "positions": {"$ref": "#/$defs/rows"}
      }
    }
  }
}
