{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bktrader.local/schemas/research-warehouse-source-registry-v1.schema.json",
  "title": "Research Warehouse SHFE/INE source registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "published_at",
    "timezone",
    "timestamp_storage",
    "authority",
    "sources"
  ],
  "properties": {
    "schema_version": {"const": "vnpy_research_source_registry_v1"},
    "registry_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "published_at": {"type": "string", "format": "date-time"},
    "timezone": {"const": "Asia/Shanghai"},
    "timestamp_storage": {"const": "UTC"},
    "authority": {"$ref": "#/$defs/authority"},
    "sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "account_data_authorized",
        "control_authorized",
        "deployment_authorized",
        "dispatch_authorized",
        "execution_authorized",
        "order_authorized",
        "permit_authorized",
        "position_authorized",
        "production_authorized",
        "rpc_authorized",
        "trading_authorized"
      ],
      "properties": {
        "class": {"const": "RESEARCH_DATA_CUSTODY_EVIDENCE_ONLY"},
        "account_data_authorized": {"const": false},
        "control_authorized": {"const": false},
        "deployment_authorized": {"const": false},
        "dispatch_authorized": {"const": false},
        "execution_authorized": {"const": false},
        "order_authorized": {"const": false},
        "permit_authorized": {"const": false},
        "position_authorized": {"const": false},
        "production_authorized": {"const": false},
        "rpc_authorized": {"const": false},
        "trading_authorized": {"const": false}
      }
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^#]+$"
    },
    "uniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "exchange",
        "owner",
        "owner_reference_url",
        "license_policy",
        "use_terms_url",
        "endpoint_template",
        "documentation_url",
        "allowed_hosts",
        "media_type",
        "endpoint_schema_version",
        "availability_policy",
        "required_top_level_fields",
        "required_row_fields"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "exchange": {"enum": ["SHFE", "INE"]},
        "owner": {"$ref": "#/$defs/nonEmptyString"},
        "owner_reference_url": {"$ref": "#/$defs/httpsUrl"},
        "license_policy": {
          "const": "OFFICIAL_PUBLIC_ENDPOINT_USE_TERMS_APPLY"
        },
        "use_terms_url": {"$ref": "#/$defs/httpsUrl"},
        "endpoint_template": {
          "type": "string",
          "pattern": "^https://[^#]*\\{yyyymmdd\\}[^#]*$"
        },
        "documentation_url": {"$ref": "#/$defs/httpsUrl"},
        "allowed_hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["www.shfe.com.cn", "www.ine.cn"]
          }
        },
        "media_type": {
          "enum": ["application/json", "application/octet-stream"]
        },
        "endpoint_schema_version": {"$ref": "#/$defs/nonEmptyString"},
        "availability_policy": {"$ref": "#/$defs/nonEmptyString"},
        "required_top_level_fields": {"$ref": "#/$defs/uniqueStrings"},
        "required_row_fields": {"$ref": "#/$defs/uniqueStrings"}
      }
    }
  }
}
