{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vnpy.example/schemas/windows-rpc-durable-fence-publish-receipt-v1.json",
  "title": "Signed Windows RPC durable fence exact-file publish receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "receipt_id", "receipt_core_sha256",
    "install_attempt_id", "install_manifest_raw_sha256",
    "preflight_receipt_raw_sha256", "bundle_sha256", "publish_mode",
    "published_at_utc", "seal_challenge_id", "seal_challenge_nonce_sha256",
    "seal_challenge_issued_at_utc", "sealed_at_utc", "seal_expires_at_utc",
    "trusted_clock_id", "maximum_seal_to_dispatch_seconds", "seal_single_use",
    "seal_replay_guard_id", "service_name", "final_version_directory_path_sha256",
    "final_directory_owner_sid_sha256", "final_directory_acl_sddl_sha256",
    "final_directory_acl_readback_sddl_sha256", "final_directory_unsafe_write_principals",
    "final_directory_create_only", "final_directory_overwrite_allowed",
    "installer_write_access_after_publish", "final_directory_reparse_point",
    "final_directory_hardlink_target", "preinstall_service_image_path_canonical_sha256",
    "preinstall_service_image_path_readback_sha256",
    "preinstall_service_config_canonical_sha256", "preinstall_service_config_readback_sha256",
    "target_service_image_path_canonical_sha256", "target_service_config_canonical_sha256",
    "safety_service_config_canonical_sha256",
    "service_config_transition_plan_sha256", "active_service_config_matches_preinstall",
    "target_service_config_not_applied",
    "service_config_owner_sid_sha256", "service_config_acl_sddl_sha256",
    "service_config_acl_readback_sddl_sha256", "service_config_unsafe_write_principals",
    "service_config_transition_plan_manifest_bound",
    "service_config_mutation_before_dispatch_reservation_authorized",
    "unbound_service_config_mutation_after_observer_seal_authorized",
    "components", "publish_complete",
    "restart_authorized", "automatic_restart_allowed", "authority",
    "canonicalization_profile", "signature_domain_separator", "signature_algorithm",
    "signer_role", "signer_key_domain", "signer_key_id",
    "signer_public_key_sha256", "signature"
  ],
  "properties": {
    "schema_version": {"const": "windows_rpc_durable_fence_publish_receipt_v1"},
    "purpose": {"const": "prove_exact_windows_fence_files_published_and_read_back_without_restart"},
    "receipt_id": {"type": "string", "pattern": "^windows-fence-publish-receipt-[0-9a-f]{64}$"},
    "receipt_core_sha256": {"$ref": "#/$defs/sha256"},
    "install_attempt_id": {"$ref": "#/$defs/attemptId"},
    "install_manifest_raw_sha256": {"$ref": "#/$defs/sha256"},
    "preflight_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "bundle_sha256": {"$ref": "#/$defs/sha256"},
    "publish_mode": {"const": "atomic_content_addressed_final_directory"},
    "published_at_utc": {"$ref": "#/$defs/utc"},
    "seal_challenge_id": {"type": "string", "pattern": "^windows-fence-publish-seal-challenge-[0-9a-f]{64}$"},
    "seal_challenge_nonce_sha256": {"$ref": "#/$defs/sha256"},
    "seal_challenge_issued_at_utc": {"$ref": "#/$defs/utc"},
    "sealed_at_utc": {"$ref": "#/$defs/utc"},
    "seal_expires_at_utc": {"$ref": "#/$defs/utc"},
    "trusted_clock_id": {"$ref": "#/$defs/identifier"},
    "maximum_seal_to_dispatch_seconds": {"const": 30},
    "seal_single_use": {"const": true},
    "seal_replay_guard_id": {"type": "string", "pattern": "^windows-fence-publish-seal-replay-[0-9a-f]{64}$"},
    "service_name": {"$ref": "#/$defs/serviceName"},
    "final_version_directory_path_sha256": {"$ref": "#/$defs/sha256"},
    "final_directory_owner_sid_sha256": {"$ref": "#/$defs/sha256"},
    "final_directory_acl_sddl_sha256": {"$ref": "#/$defs/sha256"},
    "final_directory_acl_readback_sddl_sha256": {"$ref": "#/$defs/sha256"},
    "final_directory_unsafe_write_principals": {"type": "array", "maxItems": 0},
    "final_directory_create_only": {"const": true},
    "final_directory_overwrite_allowed": {"const": false},
    "installer_write_access_after_publish": {"const": false},
    "final_directory_reparse_point": {"const": false},
    "final_directory_hardlink_target": {"const": false},
    "preinstall_service_image_path_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "preinstall_service_image_path_readback_sha256": {"$ref": "#/$defs/sha256"},
    "preinstall_service_config_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "preinstall_service_config_readback_sha256": {"$ref": "#/$defs/sha256"},
    "target_service_image_path_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "target_service_config_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "safety_service_config_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_transition_plan_sha256": {"$ref": "#/$defs/sha256"},
    "active_service_config_matches_preinstall": {"const": true},
    "target_service_config_not_applied": {"const": true},
    "service_config_owner_sid_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_acl_sddl_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_acl_readback_sddl_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_unsafe_write_principals": {"type": "array", "maxItems": 0},
    "service_config_transition_plan_manifest_bound": {"const": true},
    "service_config_mutation_before_dispatch_reservation_authorized": {"const": false},
    "unbound_service_config_mutation_after_observer_seal_authorized": {"const": false},
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extension", "launcher", "assembly", "config"],
      "properties": {
        "extension": {"$ref": "#/$defs/component"},
        "launcher": {"$ref": "#/$defs/component"},
        "assembly": {"$ref": "#/$defs/component"},
        "config": {"$ref": "#/$defs/component"}
      }
    },
    "publish_complete": {"const": true},
    "restart_authorized": {"const": false},
    "automatic_restart_allowed": {"const": false},
    "authority": {"$ref": "#/$defs/authority"},
    "canonicalization_profile": {"const": "windows-foundation-canonical-json-v1"},
    "signature_domain_separator": {"const": "vnpy.issue267.windows-foundation.publish-receipt.v1"},
    "signature_algorithm": {"const": "Ed25519"},
    "signer_role": {"const": "windows-foundation-observer-evidence"},
    "signer_key_domain": {"const": "dedicated-windows-foundation-observer-evidence-v1"},
    "signer_key_id": {"type": "string", "pattern": "^windows-foundation-observer-evidence:[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "signer_public_key_sha256": {"$ref": "#/$defs/sha256"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attemptId": {"type": "string", "pattern": "^windows-fence-install-[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "serviceName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "keyId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destination_path_sha256", "manifest_sha256", "published_sha256",
        "readback_sha256", "size_bytes", "acl_sddl_sha256",
        "acl_readback_sddl_sha256", "owner_sid_sha256",
        "unsafe_write_principals", "regular_file", "reparse_point",
        "hardlink_count", "parent_chain_reparse_free", "hash_readback_verified",
        "acl_readback_verified"
      ],
      "properties": {
        "destination_path_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "published_sha256": {"$ref": "#/$defs/sha256"},
        "readback_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "acl_sddl_sha256": {"$ref": "#/$defs/sha256"},
        "acl_readback_sddl_sha256": {"$ref": "#/$defs/sha256"},
        "owner_sid_sha256": {"$ref": "#/$defs/sha256"},
        "unsafe_write_principals": {"type": "array", "maxItems": 0},
        "regular_file": {"const": true},
        "reparse_point": {"const": false},
        "hardlink_count": {"const": 1},
        "parent_chain_reparse_free": {"const": true},
        "hash_readback_verified": {"const": true},
        "acl_readback_verified": {"const": true}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows_fence_released", "authority_restore_allowed", "consume_authorized",
        "reconciliation_authorized", "deployment_authorized", "automatic_deploy_allowed",
        "production_allowed", "live_trading_authorized", "send_order_authorized",
        "cancel_order_authorized", "countable_forward"
      ],
      "properties": {
        "windows_fence_released": {"const": false},
        "authority_restore_allowed": {"const": false},
        "consume_authorized": {"const": false},
        "reconciliation_authorized": {"const": false},
        "deployment_authorized": {"const": false},
        "automatic_deploy_allowed": {"const": false},
        "production_allowed": {"const": false},
        "live_trading_authorized": {"const": false},
        "send_order_authorized": {"const": false},
        "cancel_order_authorized": {"const": false},
        "countable_forward": {"const": false}
      }
    }
  }
}
