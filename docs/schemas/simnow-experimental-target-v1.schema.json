{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIMNOW experimental target v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "strategy_id", "source_month", "generated_at", "targets", "target_id", "monthly_quantity_sha256", "daily_route_sha256", "production", "live_trading_authorized", "countable_forward", "official_forward_claimed"],
  "properties": {
    "schema_version": {"const": "simnow-experimental-target-v1"},
    "strategy_id": {"const": "STATIC_CORE_EQUAL"},
    "source_month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "target_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "monthly_quantity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "daily_route_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "production": {"const": false},
    "live_trading_authorized": {"const": false},
    "countable_forward": {"const": false},
    "official_forward_claimed": {"const": false},
    "target_mode": {"const": "SIMNOW_EXPERIMENTAL_TEST"},
    "strategy_output_claim": {"const": "NOT OFFICIAL STRATEGY OUTPUT"},
    "test_quantity_overrides": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "ag": {"type": "integer", "minimum": -500, "maximum": 500},
        "al": {"type": "integer", "minimum": -500, "maximum": 500},
        "au": {"type": "integer", "minimum": -500, "maximum": 500},
        "bu": {"type": "integer", "minimum": -500, "maximum": 500},
        "cu": {"type": "integer", "minimum": -500, "maximum": 500},
        "rb": {"type": "integer", "minimum": -500, "maximum": 500},
        "ru": {"type": "integer", "minimum": -500, "maximum": 500},
        "sc": {"type": "integer", "minimum": -500, "maximum": 500},
        "sp": {"type": "integer", "minimum": -500, "maximum": 500},
        "zn": {"type": "integer", "minimum": -500, "maximum": 500}
      }
    },
    "targets": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["product", "exact_contract", "quantity"],
        "properties": {
          "product": {"enum": ["ag", "al", "au", "bu", "cu", "rb", "ru", "sc", "sp", "zn"]},
          "exact_contract": {"type": "string", "pattern": "^(SHFE|INE)\\.[a-z]{2}[0-9]{4}$"},
          "quantity": {"type": "integer", "minimum": -500, "maximum": 500}
        }
      }
    }
  },
  "allOf": [{
    "if": {"required": ["target_mode"]},
    "then": {"required": ["target_mode", "strategy_output_claim", "test_quantity_overrides"]}
  }]
}
