{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:commodity-c-fast-t1-query-child-launched-v6",
  "title": "C_FAST query-v6 one-shot child launch claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "candidate_id",
    "release_id",
    "attempt_id",
    "claimed_at",
    "consume_marker_raw_sha256",
    "consume_marker_canonical_sha256",
    "executable_release_raw_sha256",
    "foundation_raw_sha256",
    "pin_set_manifest_sha256",
    "execution_adapter_sha256",
    "adapter_package_manifest_sha256",
    "adapter_package_root_identity_sha256",
    "python_executable_sha256",
    "python_dependency_closure_sha256",
    "invocation_binding_sha256",
    "launch_capability_sha256",
    "consume_verified_before_claim",
    "final_revalidation_completed_before_claim",
    "launch_claimed",
    "dsn_secret_read",
    "network_attempted",
    "production_query_attempted",
    "launch_marker_is_authority",
    "database_mutation_authorized",
    "web_bridge_rpc_authorized",
    "order_authorized",
    "position_mutation_authorized",
    "dispatch_authorized",
    "trading_authorized",
    "production_authorized",
    "replay_allowed"
  ],
  "properties": {
    "schema_version": {"const": "commodity_c_fast_t1_query_child_launched_v6"},
    "purpose": {"const": "c_fast_t1_query_v6_one_shot_launch_claim"},
    "candidate_id": {"const": "C_FAST_CROSS_SECTION_NEUTRAL"},
    "release_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/attemptId"},
    "claimed_at": {"$ref": "#/$defs/dateTime"},
    "consume_marker_raw_sha256": {"$ref": "#/$defs/sha256"},
    "consume_marker_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "executable_release_raw_sha256": {"$ref": "#/$defs/sha256"},
    "foundation_raw_sha256": {"$ref": "#/$defs/sha256"},
    "pin_set_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "execution_adapter_sha256": {"$ref": "#/$defs/sha256"},
    "adapter_package_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "adapter_package_root_identity_sha256": {"$ref": "#/$defs/sha256"},
    "python_executable_sha256": {"$ref": "#/$defs/sha256"},
    "python_dependency_closure_sha256": {"$ref": "#/$defs/sha256"},
    "invocation_binding_sha256": {"$ref": "#/$defs/sha256"},
    "launch_capability_sha256": {"$ref": "#/$defs/sha256"},
    "consume_verified_before_claim": {"const": true},
    "final_revalidation_completed_before_claim": {"const": true},
    "launch_claimed": {"const": true},
    "dsn_secret_read": {"const": false},
    "network_attempted": {"const": false},
    "production_query_attempted": {"const": false},
    "launch_marker_is_authority": {"const": false},
    "database_mutation_authorized": {"const": false},
    "web_bridge_rpc_authorized": {"const": false},
    "order_authorized": {"const": false},
    "position_mutation_authorized": {"const": false},
    "dispatch_authorized": {"const": false},
    "trading_authorized": {"const": false},
    "production_authorized": {"const": false},
    "replay_allowed": {"const": false}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "attemptId": {"type": "string", "pattern": "^attempt-[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dateTime": {"type": "string", "format": "date-time"}
  }
}
