{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vnpy-web-bridge.invalid/schemas/web-bridge-artifact-envelope-v1.schema.json",
  "title": "Web Bridge immutable artifact envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "artifact_type", "trust_domain", "producer_id", "producer_version", "schema_ref", "canonical_sha256", "raw_sha256", "predecessor_refs", "lineage", "generated_at", "scope", "payload"],
  "properties": {
    "schema_version": {"const": "web-bridge-artifact-envelope-v1"},
    "artifact_id": {"type": "string", "pattern": "^artifact-[0-9a-f]{64}$"},
    "artifact_type": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"},
    "trust_domain": {"type": "string", "minLength": 1},
    "producer_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"},
    "producer_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"},
    "schema_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predecessor_refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "canonical_sha256"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^artifact-[0-9a-f]{64}$"},
          "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "lineage": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "generated_at": {"type": "string", "format": "date-time"},
    "scope": {"type": "object"},
    "payload": {}
  }
}
