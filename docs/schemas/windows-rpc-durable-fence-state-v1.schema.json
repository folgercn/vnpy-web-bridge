{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vnpy.example/schemas/windows-rpc-durable-fence-state-v1.json",
  "title": "Windows RPC durable fail-closed fence state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "state_id", "state_core_sha256",
    "store_id", "store_format_version", "state_sequence",
    "previous_state_raw_sha256", "install_attempt_id", "attempt_nonce_sha256",
    "bundle_sha256",
    "install_manifest_id", "install_manifest_raw_sha256",
    "preflight_receipt_id", "preflight_receipt_raw_sha256",
    "service_name", "store_path_sha256", "store_volume_serial",
    "store_volume_identity_sha256",
    "extension_sha256", "launcher_sha256", "assembly_sha256", "config_sha256",
    "fence_epoch", "admission_state", "token_state",
    "staged_token", "active_token", "authority_grant",
    "staged_token_inventory", "active_token_inventory", "grant_inventory",
    "expected_account_sha256", "raw_account_row_sha256",
    "gateway_name", "gateway_scope_sha256",
    "preflight_server_instance_id", "preflight_fact_generation",
    "preflight_execution_facts_sha256", "pending_send_outcomes",
    "active_orders", "created_at_utc", "trusted_clock_id", "authority"
  ],
  "properties": {
    "schema_version": {"const": "windows_rpc_durable_fence_state_v1"},
    "purpose": {"const": "persist_windows_rpc_fail_closed_fence_genesis"},
    "state_id": {"type": "string", "pattern": "^windows-fence-state-[0-9a-f]{64}$"},
    "state_core_sha256": {"$ref": "#/$defs/sha256"},
    "store_id": {"type": "string", "pattern": "^windows-fence-store-[0-9a-f]{64}$"},
    "store_format_version": {"const": 1},
    "state_sequence": {"const": 1},
    "previous_state_raw_sha256": {"type": "null"},
    "install_attempt_id": {"$ref": "#/$defs/attemptId"},
    "attempt_nonce_sha256": {"$ref": "#/$defs/sha256"},
    "bundle_sha256": {"$ref": "#/$defs/sha256"},
    "install_manifest_id": {"type": "string", "pattern": "^windows-fence-install-manifest-[0-9a-f]{64}$"},
    "install_manifest_raw_sha256": {"$ref": "#/$defs/sha256"},
    "preflight_receipt_id": {"type": "string", "pattern": "^windows-fence-preflight-[0-9a-f]{64}$"},
    "preflight_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "service_name": {"$ref": "#/$defs/serviceName"},
    "store_path_sha256": {"$ref": "#/$defs/sha256"},
    "store_volume_serial": {"type": "string", "pattern": "^[A-F0-9]{8,32}$"},
    "store_volume_identity_sha256": {"$ref": "#/$defs/sha256"},
    "extension_sha256": {"$ref": "#/$defs/sha256"},
    "launcher_sha256": {"$ref": "#/$defs/sha256"},
    "assembly_sha256": {"$ref": "#/$defs/sha256"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "fence_epoch": {"const": 1},
    "admission_state": {"const": "FROZEN"},
    "token_state": {"const": "NONE"},
    "staged_token": {"type": "null"},
    "active_token": {"type": "null"},
    "authority_grant": {"type": "null"},
    "staged_token_inventory": {"type": "array", "maxItems": 0},
    "active_token_inventory": {"type": "array", "maxItems": 0},
    "grant_inventory": {"type": "array", "maxItems": 0},
    "expected_account_sha256": {"$ref": "#/$defs/sha256"},
    "raw_account_row_sha256": {"$ref": "#/$defs/sha256"},
    "gateway_name": {"$ref": "#/$defs/gatewayName"},
    "gateway_scope_sha256": {"$ref": "#/$defs/sha256"},
    "preflight_server_instance_id": {"$ref": "#/$defs/identifier"},
    "preflight_fact_generation": {"type": "integer", "minimum": 0},
    "preflight_execution_facts_sha256": {"$ref": "#/$defs/sha256"},
    "pending_send_outcomes": {"const": 0},
    "active_orders": {"type": "array", "maxItems": 0},
    "created_at_utc": {"$ref": "#/$defs/utc"},
    "trusted_clock_id": {"$ref": "#/$defs/identifier"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attemptId": {"type": "string", "pattern": "^windows-fence-install-[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "serviceName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "gatewayName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["windows_fence_released", "authority_restore_allowed", "consume_authorized", "reconciliation_authorized", "deployment_authorized", "automatic_deploy_allowed", "production_allowed", "live_trading_authorized", "send_order_authorized", "cancel_order_authorized", "countable_forward"],
      "properties": {
        "windows_fence_released": {"const": false}, "authority_restore_allowed": {"const": false},
        "consume_authorized": {"const": false}, "reconciliation_authorized": {"const": false},
        "deployment_authorized": {"const": false}, "automatic_deploy_allowed": {"const": false},
        "production_allowed": {"const": false}, "live_trading_authorized": {"const": false},
        "send_order_authorized": {"const": false}, "cancel_order_authorized": {"const": false},
        "countable_forward": {"const": false}
      }
    }
  }
}
