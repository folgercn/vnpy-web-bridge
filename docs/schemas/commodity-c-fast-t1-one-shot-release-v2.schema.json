{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:commodity-c-fast-t1-one-shot-release-v2",
  "title": "C_FAST T1 exact-readiness release v2 foundation (no query)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "candidate_id", "issue_number", "release_id",
    "attempt_id", "issued_at", "not_before", "expires_at", "signer_key_id",
    "signer_type", "reviewer_role", "human_signature",
    "trusted_keyring_sha256", "pin_root_path_sha256",
    "custody_identity_sha256", "custody_path_sha256", "runner_sha256",
    "release_schema_sha256", "consume_schema_sha256",
    "harness_terminal_schema_sha256", "readiness_verifier_sha256",
    "readiness_schema_sha256", "readiness", "namespaces",
    "readiness_source_bundle_index_sha256", "manifest_raw_sha256",
    "manifest_canonical_sha256", "snapshot_id", "audit_window",
    "endpoint_identity_sha256", "questdb_build_sha256",
    "connect_timeout_seconds", "statement_timeout_ms",
    "max_rows_per_contract", "max_runtime_seconds",
    "minimum_launch_margin_seconds", "query_plan_scope",
    "t1_one_shot_child_launch_planned", "network_query_planned",
    "readonly_production_query_planned",
    "local_audit_artifact_write_planned", "foundation_is_authority",
    "packet_is_authority", "authority_granted", "readiness_authorized",
    "t1_one_shot_child_launch_authorized", "network_query_authorized",
    "readonly_production_query_authorized",
    "local_audit_artifact_write_authorized", "network_authorized",
    "production_query_authorized", "readonly_query_authorized",
    "write_probe_authorized", "database_mutation_authorized",
    "deployment_mutation_authorized",
    "readonly_principal_deployment_authorized",
    "readonly_secret_file_installation_authorized",
    "questdb_restart_authorized", "questdb_recreate_authorized",
    "questdb_image_change_authorized", "writer_identity_mutation_authorized",
    "writer_secret_mutation_authorized",
    "network_mutation_authorized",
    "unscoped_deployment_mutation_authorized",
    "web_bridge_deployment_authorized", "collection_authorized",
    "execution_quality_collection_authorized", "runtime_activation_authorized",
    "web_bridge_rpc_authorized", "order_authorized",
    "order_submission_authorized", "position_mutation_authorized",
    "dispatch_authorized", "trading_authorized",
    "strategy_activation_authorized", "replacement_authorized",
    "production_authorized", "dynamic_selection_allowed",
    "automatic_promotion_authorized", "replay_allowed", "signature"
  ],
  "properties": {
    "schema_version": {"const": "commodity_c_fast_t1_one_shot_release_v2"},
    "purpose": {"const": "c_fast_l1_l5_t1_release_v2_foundation_no_query"},
    "candidate_id": {"const": "C_FAST_CROSS_SECTION_NEUTRAL"},
    "issue_number": {"const": 114},
    "release_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/attemptId"},
    "issued_at": {"$ref": "#/$defs/dateTime"},
    "not_before": {"$ref": "#/$defs/dateTime"},
    "expires_at": {"$ref": "#/$defs/dateTime"},
    "signer_key_id": {"$ref": "#/$defs/id"},
    "signer_type": {"const": "human"},
    "reviewer_role": {"type": "string", "minLength": 1, "maxLength": 128},
    "human_signature": {"type": "string", "minLength": 1, "maxLength": 512},
    "trusted_keyring_sha256": {"$ref": "#/$defs/sha256"},
    "pin_root_path_sha256": {"$ref": "#/$defs/sha256"},
    "custody_identity_sha256": {"$ref": "#/$defs/sha256"},
    "custody_path_sha256": {"$ref": "#/$defs/sha256"},
    "runner_sha256": {"$ref": "#/$defs/sha256"},
    "release_schema_sha256": {"$ref": "#/$defs/sha256"},
    "consume_schema_sha256": {"$ref": "#/$defs/sha256"},
    "harness_terminal_schema_sha256": {"$ref": "#/$defs/sha256"},
    "readiness_verifier_sha256": {"$ref": "#/$defs/sha256"},
    "readiness_schema_sha256": {"$ref": "#/$defs/sha256"},
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id", "packet_raw_sha256", "packet_canonical_sha256",
        "generated_at", "expires_at", "content_attestation_raw_sha256",
        "content_attestation_canonical_sha256", "provenance_raw_sha256",
        "provenance_canonical_sha256", "provenance_signer_public_key_sha256",
        "outcome_raw_sha256", "outcome_canonical_sha256",
        "outcome_signer_public_key_sha256"
      ],
      "properties": {
        "packet_id": {"type": "string", "pattern": "^readiness-v2-[0-9a-f]{64}$"},
        "packet_raw_sha256": {"$ref": "#/$defs/sha256"},
        "packet_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "generated_at": {"$ref": "#/$defs/dateTime"},
        "expires_at": {"$ref": "#/$defs/dateTime"},
        "content_attestation_raw_sha256": {"$ref": "#/$defs/sha256"},
        "content_attestation_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "provenance_raw_sha256": {"$ref": "#/$defs/sha256"},
        "provenance_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "provenance_signer_public_key_sha256": {"$ref": "#/$defs/sha256"},
        "outcome_raw_sha256": {"$ref": "#/$defs/sha256"},
        "outcome_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "outcome_signer_public_key_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "namespaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t1_runtime_source_commit_sha", "t1_runtime_image_digest",
        "l3_contract_source_commit_sha",
        "outcome_contract_source_commit_assertion", "questdb_image_digest"
      ],
      "properties": {
        "t1_runtime_source_commit_sha": {"$ref": "#/$defs/commit"},
        "t1_runtime_image_digest": {"$ref": "#/$defs/ociDigest"},
        "l3_contract_source_commit_sha": {"$ref": "#/$defs/commit"},
        "outcome_contract_source_commit_assertion": {"$ref": "#/$defs/commit"},
        "questdb_image_digest": {"$ref": "#/$defs/ociDigest"}
      }
    },
    "readiness_source_bundle_index_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_raw_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "snapshot_id": {"$ref": "#/$defs/id"},
    "audit_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end_exclusive", "trading_day"],
      "properties": {
        "start": {"$ref": "#/$defs/dateTime"},
        "end_exclusive": {"$ref": "#/$defs/dateTime"},
        "trading_day": {"type": "string", "pattern": "^[0-9]{8}$"}
      }
    },
    "endpoint_identity_sha256": {"$ref": "#/$defs/sha256"},
    "questdb_build_sha256": {"$ref": "#/$defs/sha256"},
    "connect_timeout_seconds": {"const": 10},
    "statement_timeout_ms": {"const": 60000},
    "max_rows_per_contract": {"const": 500000},
    "max_runtime_seconds": {"type": "integer", "minimum": 60, "maximum": 1800},
    "minimum_launch_margin_seconds": {"const": 30},
    "query_plan_scope": {"const": "FUTURE_EXACT_SIGNED_MANIFEST_ONE_SHOT_PLANNED_ONLY"},
    "t1_one_shot_child_launch_planned": {"const": true},
    "network_query_planned": {"const": true},
    "readonly_production_query_planned": {"const": true},
    "local_audit_artifact_write_planned": {
      "const": true,
      "description": "Plans only the future query evidence bundle; excludes mandatory create-only foundation custody control records."
    },
    "foundation_is_authority": {"const": false},
    "packet_is_authority": {"const": false},
    "authority_granted": {"const": false},
    "readiness_authorized": {"const": false},
    "t1_one_shot_child_launch_authorized": {"const": false},
    "network_query_authorized": {"const": false},
    "readonly_production_query_authorized": {"const": false},
    "local_audit_artifact_write_authorized": {
      "const": false,
      "description": "No query evidence JSON/CSV/Markdown may be written; consume and harness-terminal custody control records are not query evidence."
    },
    "network_authorized": {"const": false},
    "production_query_authorized": {"const": false},
    "readonly_query_authorized": {"const": false},
    "write_probe_authorized": {"const": false},
    "database_mutation_authorized": {"const": false},
    "deployment_mutation_authorized": {"const": false},
    "readonly_principal_deployment_authorized": {"const": false},
    "readonly_secret_file_installation_authorized": {"const": false},
    "questdb_restart_authorized": {"const": false},
    "questdb_recreate_authorized": {"const": false},
    "questdb_image_change_authorized": {"const": false},
    "writer_identity_mutation_authorized": {"const": false},
    "writer_secret_mutation_authorized": {"const": false},
    "network_mutation_authorized": {"const": false},
    "unscoped_deployment_mutation_authorized": {"const": false},
    "web_bridge_deployment_authorized": {"const": false},
    "collection_authorized": {"const": false},
    "execution_quality_collection_authorized": {"const": false},
    "runtime_activation_authorized": {"const": false},
    "web_bridge_rpc_authorized": {"const": false},
    "order_authorized": {"const": false},
    "order_submission_authorized": {"const": false},
    "position_mutation_authorized": {"const": false},
    "dispatch_authorized": {"const": false},
    "trading_authorized": {"const": false},
    "strategy_activation_authorized": {"const": false},
    "replacement_authorized": {"const": false},
    "production_authorized": {"const": false},
    "dynamic_selection_allowed": {"const": false},
    "automatic_promotion_authorized": {"const": false},
    "replay_allowed": {"const": false},
    "signature": {"type": "string", "minLength": 1, "maxLength": 256}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$"},
    "attemptId": {"type": "string", "pattern": "^attempt-[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ociDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dateTime": {"type": "string", "format": "date-time"}
  }
}
