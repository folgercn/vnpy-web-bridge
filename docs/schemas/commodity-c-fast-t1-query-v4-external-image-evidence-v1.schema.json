{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:commodity-c-fast-t1-query-v4-external-image-evidence-v1",
  "title": "C_FAST T1 query-v4 unsigned external OCI layout claims v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_kind",
    "captured_at",
    "producer",
    "build_provenance_verified",
    "registry_provenance_verified",
    "source_commit_sha",
    "source_bundle_archive_sha256",
    "source_manifest_raw_sha256",
    "source_manifest_canonical_sha256",
    "build",
    "image",
    "sensitive_material_present",
    "authority_granted"
  ],
  "properties": {
    "schema_version": {
      "const": "commodity_c_fast_t1_query_v4_external_image_evidence_v1"
    },
    "capture_kind": {
      "const": "unsigned_external_query_v4_oci_layout_capture_v1"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "tool_version"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._+-]+$"
        },
        "tool_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._+-]+$"
        }
      }
    },
    "build_provenance_verified": {
      "const": false
    },
    "registry_provenance_verified": {
      "const": false
    },
    "source_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_bundle_archive_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_manifest_raw_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_manifest_canonical_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "context_kind",
        "containerfile_sha256",
        "base_image_digest",
        "direct_dependencies"
      ],
      "properties": {
        "platform": {
          "const": "linux/amd64"
        },
        "context_kind": {
          "const": "exact_query_v4_source_bundle_v1"
        },
        "containerfile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "base_image_digest": {
          "$ref": "#/$defs/ociDigest"
        },
        "direct_dependencies": {
          "const": {
            "cryptography": "48.0.0",
            "jsonschema": "4.26.0",
            "psycopg[binary]": "3.2.3",
            "referencing": "0.37.0"
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "digest",
        "id",
        "export_sha256",
        "rootfs_layer_digests",
        "config",
        "bundle_files",
        "forbidden_path_matches",
        "unexpected_bundle_paths",
        "signer_or_private_key_paths"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
        },
        "digest": {
          "$ref": "#/$defs/ociDigest"
        },
        "id": {
          "$ref": "#/$defs/ociDigest"
        },
        "export_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rootfs_layer_digests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ociDigest"
          }
        },
        "config": {
          "$ref": "#/$defs/config"
        },
        "bundle_files": {
          "$ref": "#/$defs/runtimeBundle"
        },
        "forbidden_path_matches": {
          "type": "array",
          "maxItems": 0
        },
        "unexpected_bundle_paths": {
          "type": "array",
          "maxItems": 0
        },
        "signer_or_private_key_paths": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "sensitive_material_present": {
      "const": false
    },
    "authority_granted": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ociDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user",
        "working_dir",
        "entrypoint",
        "relevant_environment",
        "labels"
      ],
      "properties": {
        "user": {
          "const": "65532:65532"
        },
        "working_dir": {
          "const": "/opt/c-fast-t1"
        },
        "entrypoint": {
          "const": [
            "/usr/local/bin/python3.12",
            "-I",
            "/opt/c-fast-t1/scripts/commodity_c_fast_t1_query_v4.py"
          ]
        },
        "relevant_environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "io.vnpy-web-bridge.c-fast-t1.authority-granted",
            "io.vnpy-web-bridge.c-fast-t1.query-v4-runtime",
            "org.opencontainers.image.revision",
            "org.opencontainers.image.title"
          ],
          "properties": {
            "io.vnpy-web-bridge.c-fast-t1.authority-granted": {
              "const": "false"
            },
            "io.vnpy-web-bridge.c-fast-t1.query-v4-runtime": {
              "const": "true"
            },
            "org.opencontainers.image.revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "org.opencontainers.image.title": {
              "const": "vnpy-web-bridge C_FAST T1 query-v4 runner"
            }
          }
        }
      }
    },
    "runtimeBundle": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {
        "pattern": "^/opt/c-fast-t1/[A-Za-z0-9._/-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    }
  }
}
