        "execution_plan_hash": {
          "const": null,
          "type": "null"
        },
        "plan_version": {
          "const": 0,
          "type": "integer"
        },
        "web_trade_enabled": {
          "const": false,
          "type": "boolean"
        },
        "execution_authority_revoked": {
          "const": true,
          "type": "boolean"
        },
        "auto_dispatch_stopped": {
          "const": true,
          "type": "boolean"
        },
        "unknown_outcome": {
          "const": false,
          "type": "boolean"
        },
        "reconcile_required": {
          "const": false,
          "type": "boolean"
        },
        "rpc_generation": {
          "minimum": 0,
          "type": "integer"
        },
        "active_orders_snapshot_sha256": {
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
          "type": "string"
        },
        "positions_snapshot_sha256": {
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "commodity_state_version",
        "commodity_state_checkpoint_sha256",
        "execution_plan_status",
        "execution_plan_hash",
        "plan_version",
        "web_trade_enabled",
        "execution_authority_revoked",
        "auto_dispatch_stopped",
        "unknown_outcome",
        "reconcile_required",
        "rpc_generation",
        "active_orders_snapshot_sha256",
        "positions_snapshot_sha256"
      ],
      "type": "object"
    },
    "DeploymentDrainStateCommitmentDTO": {
