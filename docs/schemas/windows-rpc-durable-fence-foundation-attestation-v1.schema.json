{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vnpy.example/schemas/windows-rpc-durable-fence-foundation-attestation-v1.json",
  "title": "Post-restart Windows RPC durable fence foundation attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "attestation_id", "attestation_core_sha256",
    "install_attempt_id", "challenge", "captured_at_utc", "served_at_utc", "trusted_clock_id",
    "install_manifest_raw_sha256", "preflight_receipt_raw_sha256",
    "fence_state_raw_sha256", "publish_receipt_raw_sha256",
    "service_config_transition_receipt_raw_sha256",
    "start_observed_event_id",
    "start_observed_event_raw_sha256", "start_observed_event_type",
    "restart_authorization_raw_sha256", "startup_receipt_raw_sha256", "restart_dispatch_nonce_sha256",
    "service_control_operation_id",
    "service_name", "store_id", "store_path_sha256", "store_volume_serial",
    "store_volume_identity_sha256", "store_inventory_sha256",
    "extension_sha256", "launcher_sha256", "assembly_sha256", "config_sha256",
    "service_image_path_canonical_sha256", "service_config_canonical_sha256",
    "service_start_type", "service_recovery_actions_disabled",
    "service_failure_actions_disabled", "automatic_policy_restore_authorized",
    "process_image_sha256", "loaded_extension_sha256", "effective_config_sha256",
    "host_boot_id", "host_boot_started_at_utc", "service_instance_id",
    "service_process_id", "service_process_started_at_utc", "server_instance_id",
    "gateway_name", "gateway_scope_canonical_json_base64", "gateway_scope_sha256",
    "gateway_session_id", "ctp_front_id", "ctp_session_id", "trading_day",
    "raw_account_row_canonical_json_base64", "raw_account_row_sha256",
    "expected_account_sha256", "fact_generation",
    "execution_facts_canonical_sha256", "pending_send_outcomes", "active_orders",
    "admission_state", "token_state", "staged_token", "active_token",
    "authority_grant", "staged_token_inventory", "active_token_inventory",
    "grant_inventory", "send_without_active_token_rejected",
    "cancel_without_active_token_rejected", "final_registry_admission_proof",
    "foundation_evidence_verified",
    "authority", "canonicalization_profile", "signature_domain_separator",
    "signature_algorithm", "attester_role", "attester_key_domain",
    "attester_key_id",
    "attester_public_key_sha256", "signature"
  ],
  "properties": {
    "schema_version": {"const": "windows_rpc_durable_fence_foundation_attestation_v1"},
    "purpose": {"const": "prove_post_restart_windows_fence_held_without_tokens"},
    "attestation_id": {"type": "string", "pattern": "^windows-fence-foundation-attestation-[0-9a-f]{64}$"},
    "attestation_core_sha256": {"$ref": "#/$defs/sha256"},
    "install_attempt_id": {"$ref": "#/$defs/attemptId"},
    "challenge": {"$ref": "#/$defs/identifier"},
    "captured_at_utc": {"$ref": "#/$defs/utc"},
    "served_at_utc": {"$ref": "#/$defs/utc"},
    "trusted_clock_id": {"$ref": "#/$defs/identifier"},
    "install_manifest_raw_sha256": {"$ref": "#/$defs/sha256"},
    "preflight_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "fence_state_raw_sha256": {"$ref": "#/$defs/sha256"},
    "publish_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_transition_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "start_observed_event_id": {"type": "string", "pattern": "^windows-fence-install-event-[0-9a-f]{64}$"},
    "start_observed_event_raw_sha256": {"$ref": "#/$defs/sha256"},
    "start_observed_event_type": {"const": "START_OBSERVED"},
    "restart_authorization_raw_sha256": {"$ref": "#/$defs/sha256"},
    "startup_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "restart_dispatch_nonce_sha256": {"$ref": "#/$defs/sha256"},
    "service_control_operation_id": {"$ref": "#/$defs/identifier"},
    "service_name": {"$ref": "#/$defs/serviceName"},
    "store_id": {"type": "string", "pattern": "^windows-fence-store-[0-9a-f]{64}$"},
    "store_path_sha256": {"$ref": "#/$defs/sha256"},
    "store_volume_serial": {"type": "string", "pattern": "^[A-F0-9]{8,32}$"},
    "store_volume_identity_sha256": {"$ref": "#/$defs/sha256"},
    "store_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "extension_sha256": {"$ref": "#/$defs/sha256"},
    "launcher_sha256": {"$ref": "#/$defs/sha256"},
    "assembly_sha256": {"$ref": "#/$defs/sha256"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "service_image_path_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "service_start_type": {"const": "DEMAND_START"},
    "service_recovery_actions_disabled": {"const": true},
    "service_failure_actions_disabled": {"const": true},
    "automatic_policy_restore_authorized": {"const": false},
    "process_image_sha256": {"$ref": "#/$defs/sha256"},
    "loaded_extension_sha256": {"$ref": "#/$defs/sha256"},
    "effective_config_sha256": {"$ref": "#/$defs/sha256"},
    "host_boot_id": {"$ref": "#/$defs/identifier"},
    "host_boot_started_at_utc": {"$ref": "#/$defs/utc"},
    "service_instance_id": {"$ref": "#/$defs/identifier"},
    "service_process_id": {"type": "integer", "minimum": 1},
    "service_process_started_at_utc": {"$ref": "#/$defs/utc"},
    "server_instance_id": {"$ref": "#/$defs/identifier"},
    "gateway_name": {"$ref": "#/$defs/gatewayName"},
    "gateway_scope_canonical_json_base64": {"$ref": "#/$defs/base64"},
    "gateway_scope_sha256": {"$ref": "#/$defs/sha256"},
    "gateway_session_id": {"$ref": "#/$defs/identifier"},
    "ctp_front_id": {"type": "integer", "minimum": 0},
    "ctp_session_id": {"type": "integer", "minimum": 0},
    "trading_day": {"type": "string", "pattern": "^[0-9]{8}$"},
    "raw_account_row_canonical_json_base64": {"$ref": "#/$defs/base64"},
    "raw_account_row_sha256": {"$ref": "#/$defs/sha256"},
    "expected_account_sha256": {"$ref": "#/$defs/sha256"},
    "fact_generation": {"type": "integer", "minimum": 0},
    "execution_facts_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "pending_send_outcomes": {"const": 0},
    "active_orders": {"type": "array", "maxItems": 0},
    "admission_state": {"const": "FROZEN"},
    "token_state": {"const": "NONE"},
    "staged_token": {"type": "null"},
    "active_token": {"type": "null"},
    "authority_grant": {"type": "null"},
    "staged_token_inventory": {"type": "array", "maxItems": 0},
    "active_token_inventory": {"type": "array", "maxItems": 0},
    "grant_inventory": {"type": "array", "maxItems": 0},
    "send_without_active_token_rejected": {"const": true},
    "cancel_without_active_token_rejected": {"const": true},
    "final_registry_admission_proof": {"$ref": "#/$defs/finalRegistryAdmissionProof"},
    "foundation_evidence_verified": {"const": true},
    "authority": {"$ref": "#/$defs/authority"},
    "canonicalization_profile": {"const": "windows-foundation-canonical-json-v1"},
    "signature_domain_separator": {"const": "vnpy.issue267.windows-foundation.attestation.v1"},
    "signature_algorithm": {"const": "Ed25519"},
    "attester_role": {"const": "windows-foundation-observer-evidence"},
    "attester_key_domain": {"const": "dedicated-windows-foundation-observer-evidence-v1"},
    "attester_key_id": {"type": "string", "pattern": "^windows-foundation-observer-evidence:[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "attester_public_key_sha256": {"$ref": "#/$defs/sha256"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attemptId": {"type": "string", "pattern": "^windows-fence-install-[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "serviceName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "gatewayName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "keyId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
    "base64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$", "minLength": 4},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "finalRegistryAdmissionProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_mode", "live_mutation_rpc_probe_performed",
        "registry_canonical_sha256", "registry_owner_identity_sha256",
        "send_handler_identity_sha256", "cancel_handler_identity_sha256",
        "send_challenge_sha256", "send_request_canonical_sha256",
        "send_response_raw_sha256", "send_rejection_code",
        "cancel_challenge_sha256", "cancel_request_canonical_sha256",
        "cancel_response_raw_sha256", "cancel_rejection_code",
        "gateway_trace_canonical_sha256", "gateway_send_calls_before",
        "gateway_send_calls_after", "gateway_cancel_calls_before",
        "gateway_cancel_calls_after", "gateway_mutation_calls_before",
        "gateway_mutation_calls_after", "underlying_gateway_invoked",
        "non_forwarding_verified"
      ],
      "properties": {
        "proof_mode": {"const": "in_process_final_registry_handler_non_forwarding"},
        "live_mutation_rpc_probe_performed": {"const": false},
        "registry_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "registry_owner_identity_sha256": {"$ref": "#/$defs/sha256"},
        "send_handler_identity_sha256": {"$ref": "#/$defs/sha256"},
        "cancel_handler_identity_sha256": {"$ref": "#/$defs/sha256"},
        "send_challenge_sha256": {"$ref": "#/$defs/sha256"},
        "send_request_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "send_response_raw_sha256": {"$ref": "#/$defs/sha256"},
        "send_rejection_code": {"const": "WINDOWS_FENCE_ACTIVE_TOKEN_REQUIRED"},
        "cancel_challenge_sha256": {"$ref": "#/$defs/sha256"},
        "cancel_request_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "cancel_response_raw_sha256": {"$ref": "#/$defs/sha256"},
        "cancel_rejection_code": {"const": "WINDOWS_FENCE_ACTIVE_TOKEN_REQUIRED"},
        "gateway_trace_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "gateway_send_calls_before": {"const": 0},
        "gateway_send_calls_after": {"const": 0},
        "gateway_cancel_calls_before": {"const": 0},
        "gateway_cancel_calls_after": {"const": 0},
        "gateway_mutation_calls_before": {"const": 0},
        "gateway_mutation_calls_after": {"const": 0},
        "underlying_gateway_invoked": {"const": false},
        "non_forwarding_verified": {"const": true}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["windows_fence_released", "authority_restore_allowed", "consume_authorized", "reconciliation_authorized", "deployment_authorized", "automatic_deploy_allowed", "production_allowed", "live_trading_authorized", "send_order_authorized", "cancel_order_authorized", "countable_forward"],
      "properties": {
        "windows_fence_released": {"const": false}, "authority_restore_allowed": {"const": false},
        "consume_authorized": {"const": false}, "reconciliation_authorized": {"const": false},
        "deployment_authorized": {"const": false}, "automatic_deploy_allowed": {"const": false},
        "production_allowed": {"const": false}, "live_trading_authorized": {"const": false},
        "send_order_authorized": {"const": false}, "cancel_order_authorized": {"const": false},
        "countable_forward": {"const": false}
      }
    }
  }
}
