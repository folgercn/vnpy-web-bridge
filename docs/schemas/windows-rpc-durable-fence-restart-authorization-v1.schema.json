{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vnpy.example/schemas/windows-rpc-durable-fence-restart-authorization-v1.json",
  "title": "Single-dispatch Windows RPC durable fence restart authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "authorization_id", "authorization_core_sha256",
    "install_attempt_id", "install_manifest_raw_sha256", "preflight_receipt_raw_sha256",
    "publish_receipt_raw_sha256", "service_config_transition_plan_sha256", "publish_seal_challenge_id",
    "publish_seal_expires_at_utc",
    "install_event_head_raw_sha256", "service_name", "expected_host_boot_id", "expected_service_process_id",
    "expected_service_process_started_at_utc", "service_control_operation_id",
    "issued_at_utc", "not_before_utc", "expires_at_utc", "trusted_clock_id", "dispatch_nonce_sha256",
    "maximum_restart_dispatches", "dispatch_consumption_required",
    "restart_authorized", "automatic_restart_allowed", "authority",
    "canonicalization_profile", "signature_domain_separator", "signature_algorithm",
    "restart_authorizer_role", "restart_authorizer_key_domain",
    "signer_key_id", "signer_public_key_sha256", "signature"
  ],
  "properties": {
    "schema_version": {"const": "windows_rpc_durable_fence_restart_authorization_v1"},
    "purpose": {"const": "authorize_one_exact_windows_service_restart_dispatch"},
    "authorization_id": {"type": "string", "pattern": "^windows-fence-restart-authorization-[0-9a-f]{64}$"},
    "authorization_core_sha256": {"$ref": "#/$defs/sha256"},
    "install_attempt_id": {"$ref": "#/$defs/attemptId"},
    "install_manifest_raw_sha256": {"$ref": "#/$defs/sha256"},
    "preflight_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "publish_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_transition_plan_sha256": {"$ref": "#/$defs/sha256"},
    "publish_seal_challenge_id": {"type": "string", "pattern": "^windows-fence-publish-seal-challenge-[0-9a-f]{64}$"},
    "publish_seal_expires_at_utc": {"$ref": "#/$defs/utc"},
    "install_event_head_raw_sha256": {"$ref": "#/$defs/sha256"},
    "service_name": {"$ref": "#/$defs/serviceName"},
    "expected_host_boot_id": {"$ref": "#/$defs/identifier"},
    "expected_service_process_id": {"type": "integer", "minimum": 1},
    "expected_service_process_started_at_utc": {"$ref": "#/$defs/utc"},
    "service_control_operation_id": {"$ref": "#/$defs/identifier"},
    "issued_at_utc": {"$ref": "#/$defs/utc"},
    "not_before_utc": {"$ref": "#/$defs/utc"},
    "expires_at_utc": {"$ref": "#/$defs/utc"},
    "trusted_clock_id": {"$ref": "#/$defs/identifier"},
    "dispatch_nonce_sha256": {"$ref": "#/$defs/sha256"},
    "maximum_restart_dispatches": {"const": 1},
    "dispatch_consumption_required": {"const": true},
    "restart_authorized": {"const": true},
    "automatic_restart_allowed": {"const": false},
    "authority": {"$ref": "#/$defs/authority"},
    "canonicalization_profile": {"const": "windows-foundation-canonical-json-v1"},
    "signature_domain_separator": {"const": "vnpy.issue267.windows-foundation.restart-authorization.v1"},
    "signature_algorithm": {"const": "Ed25519"},
    "restart_authorizer_role": {"const": "windows-foundation-restart-authorizer"},
    "restart_authorizer_key_domain": {"const": "dedicated-windows-foundation-restart-authorization-v1"},
    "signer_key_id": {"type": "string", "pattern": "^windows-foundation-restart-authorizer:[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "signer_public_key_sha256": {"$ref": "#/$defs/sha256"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attemptId": {"type": "string", "pattern": "^windows-fence-install-[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "serviceName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows_fence_released", "authority_restore_allowed", "consume_authorized",
        "reconciliation_authorized", "deployment_authorized", "automatic_deploy_allowed",
        "production_allowed", "live_trading_authorized", "send_order_authorized",
        "cancel_order_authorized", "countable_forward"
      ],
      "properties": {
        "windows_fence_released": {"const": false},
        "authority_restore_allowed": {"const": false},
        "consume_authorized": {"const": false},
        "reconciliation_authorized": {"const": false},
        "deployment_authorized": {"const": false},
        "automatic_deploy_allowed": {"const": false},
        "production_allowed": {"const": false},
        "live_trading_authorized": {"const": false},
        "send_order_authorized": {"const": false},
        "cancel_order_authorized": {"const": false},
        "countable_forward": {"const": false}
      }
    }
  }
}
