{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vnpy.example/schemas/windows-rpc-durable-fence-zero-order-preflight-v1.json",
  "title": "Windows RPC durable fence zero-order host preflight receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "receipt_id", "receipt_core_sha256",
    "install_attempt_id", "attempt_nonce_sha256", "bundle_sha256",
    "store_path_sha256", "store_volume_serial", "store_volume_identity_sha256",
    "service_image_path_canonical_sha256", "service_config_canonical_sha256",
    "service_config_owner_sid_sha256", "service_config_acl_sddl_sha256",
    "challenge_id", "challenge_nonce_sha256",
    "challenge_issued_at_utc", "snapshot_served_at_utc", "observed_at_utc",
    "challenge_expires_at_utc", "trusted_clock_id",
    "maximum_preflight_age_seconds", "challenge_single_use", "replay_guard_id",
    "host_observer_id",
    "host_boot_id", "service_name", "service_process_id",
    "service_process_started_at_utc", "server_instance_id", "fact_generation",
    "execution_facts_canonical_sha256", "snapshot_raw_sha256",
    "owner_request_id", "owner_challenge_sha256",
    "raw_account_row_canonical_json_base64", "raw_account_row_sha256",
    "expected_account_sha256", "gateway_name",
    "gateway_scope_canonical_json_base64", "gateway_scope_sha256",
    "linux_frozen_evidence_raw_sha256", "old_runtime_frozen",
    "web_trade_enabled", "execution_authority_revoked",
    "pending_send_outcomes", "active_orders", "zero_order_preflight_verified",
    "authority", "canonicalization_profile", "signature_domain_separator",
    "signature_algorithm", "signer_role", "signer_key_domain",
    "signer_key_id",
    "signer_public_key_sha256", "signature"
  ],
  "properties": {
    "schema_version": {"const": "windows_rpc_durable_fence_zero_order_preflight_v1"},
    "purpose": {"const": "prove_old_runtime_frozen_and_zero_order_before_fence_install"},
    "receipt_id": {"type": "string", "pattern": "^windows-fence-preflight-[0-9a-f]{64}$"},
    "receipt_core_sha256": {"$ref": "#/$defs/sha256"},
    "install_attempt_id": {"$ref": "#/$defs/attemptId"},
    "attempt_nonce_sha256": {"$ref": "#/$defs/sha256"},
    "bundle_sha256": {"$ref": "#/$defs/sha256"},
    "store_path_sha256": {"$ref": "#/$defs/sha256"},
    "store_volume_serial": {"type": "string", "pattern": "^[A-F0-9]{8,32}$"},
    "store_volume_identity_sha256": {"$ref": "#/$defs/sha256"},
    "service_image_path_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_owner_sid_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_acl_sddl_sha256": {"$ref": "#/$defs/sha256"},
    "challenge_id": {"type": "string", "pattern": "^windows-fence-preflight-challenge-[0-9a-f]{64}$"},
    "challenge_nonce_sha256": {"$ref": "#/$defs/sha256"},
    "challenge_issued_at_utc": {"$ref": "#/$defs/utc"},
    "snapshot_served_at_utc": {"$ref": "#/$defs/utc"},
    "observed_at_utc": {"$ref": "#/$defs/utc"},
    "challenge_expires_at_utc": {"$ref": "#/$defs/utc"},
    "trusted_clock_id": {"$ref": "#/$defs/identifier"},
    "maximum_preflight_age_seconds": {"const": 30},
    "challenge_single_use": {"const": true},
    "replay_guard_id": {"type": "string", "pattern": "^windows-fence-preflight-replay-[0-9a-f]{64}$"},
    "host_observer_id": {"$ref": "#/$defs/identifier"},
    "host_boot_id": {"$ref": "#/$defs/identifier"},
    "service_name": {"$ref": "#/$defs/serviceName"},
    "service_process_id": {"type": "integer", "minimum": 1},
    "service_process_started_at_utc": {"$ref": "#/$defs/utc"},
    "server_instance_id": {"$ref": "#/$defs/identifier"},
    "fact_generation": {"type": "integer", "minimum": 0},
    "execution_facts_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "snapshot_raw_sha256": {"$ref": "#/$defs/sha256"},
    "owner_request_id": {"$ref": "#/$defs/identifier"},
    "owner_challenge_sha256": {"$ref": "#/$defs/sha256"},
    "raw_account_row_canonical_json_base64": {"$ref": "#/$defs/base64"},
    "raw_account_row_sha256": {"$ref": "#/$defs/sha256"},
    "expected_account_sha256": {"$ref": "#/$defs/sha256"},
    "gateway_name": {"$ref": "#/$defs/gatewayName"},
    "gateway_scope_canonical_json_base64": {"$ref": "#/$defs/base64"},
    "gateway_scope_sha256": {"$ref": "#/$defs/sha256"},
    "linux_frozen_evidence_raw_sha256": {"$ref": "#/$defs/sha256"},
    "old_runtime_frozen": {"const": true},
    "web_trade_enabled": {"const": false},
    "execution_authority_revoked": {"const": true},
    "pending_send_outcomes": {"const": 0},
    "active_orders": {"type": "array", "maxItems": 0},
    "zero_order_preflight_verified": {"const": true},
    "authority": {"$ref": "#/$defs/authority"},
    "canonicalization_profile": {"const": "windows-foundation-canonical-json-v1"},
    "signature_domain_separator": {"const": "vnpy.issue267.windows-foundation.zero-order-preflight.v1"},
    "signature_algorithm": {"const": "Ed25519"},
    "signer_role": {"const": "windows-foundation-observer-evidence"},
    "signer_key_domain": {"const": "dedicated-windows-foundation-observer-evidence-v1"},
    "signer_key_id": {"type": "string", "pattern": "^windows-foundation-observer-evidence:[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "signer_public_key_sha256": {"$ref": "#/$defs/sha256"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attemptId": {"type": "string", "pattern": "^windows-fence-install-[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "serviceName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "gatewayName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "keyId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
    "base64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$", "minLength": 4},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["windows_fence_released", "authority_restore_allowed", "consume_authorized", "reconciliation_authorized", "deployment_authorized", "automatic_deploy_allowed", "production_allowed", "live_trading_authorized", "send_order_authorized", "cancel_order_authorized", "countable_forward"],
      "properties": {
        "windows_fence_released": {"const": false}, "authority_restore_allowed": {"const": false},
        "consume_authorized": {"const": false}, "reconciliation_authorized": {"const": false},
        "deployment_authorized": {"const": false}, "automatic_deploy_allowed": {"const": false},
        "production_allowed": {"const": false}, "live_trading_authorized": {"const": false},
        "send_order_authorized": {"const": false}, "cancel_order_authorized": {"const": false},
        "countable_forward": {"const": false}
      }
    }
  }
}
