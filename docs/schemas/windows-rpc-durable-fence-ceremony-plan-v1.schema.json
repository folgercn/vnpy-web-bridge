{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vnpy.example/schemas/windows-rpc-durable-fence-ceremony-plan-v1.json",
  "title": "Windows durable fence one-shot ceremony dry-run result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "install_attempt_id", "service_name", "completed_events", "restart_dispatches"],
  "properties": {
    "mode": {"const": "dry-run"},
    "install_attempt_id": {"type": "string", "pattern": "^windows-fence-install-[0-9a-f]{64}$"},
    "service_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "completed_events": {"const": [1, 2, 3, 4, 5, 6, 7]},
    "restart_dispatches": {"type": "integer", "minimum": 0, "maximum": 1}
  },
  "oneOf": [
    {"properties": {"mode": {"const": "dry-run"}, "restart_dispatches": {"const": 0}}}
  ]
}
