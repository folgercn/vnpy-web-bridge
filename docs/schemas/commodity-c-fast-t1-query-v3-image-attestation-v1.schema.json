{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:commodity-c-fast-t1-query-v3-image-attestation-v1",
  "title": "C_FAST T1 query-v3 exact source bundle and OCI content attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "source_commit_sha",
    "source_bundle_archive_sha256",
    "source_manifest_raw_sha256",
    "source_manifest_canonical_sha256",
    "external_evidence_sha256",
    "evidence_captured_at",
    "containerfile_sha256",
    "verifier_sha256",
    "source_manifest_schema_sha256",
    "evidence_schema_sha256",
    "attestation_schema_sha256",
    "base_image_digest",
    "base_platform_manifest_digest",
    "base_rootfs_layer_digests",
    "base_rootfs_diff_ids",
    "python_execution_closure_sha256",
    "python_execution_closure_entries",
    "installed_dependency_metadata_versions",
    "oci_layout_archive_sha256",
    "image_reference",
    "image_digest",
    "image_id",
    "rootfs_layer_digests",
    "runtime_bundle_sha256",
    "runtime_bundle_index_sha256",
    "checks",
    "image_built_here",
    "cryptographic_approval_present",
    "sensitive_material_present",
    "authority_granted",
    "network_authorized",
    "production_query_authorized",
    "collection_authorized",
    "deployment_mutation_authorized",
    "runtime_activation_authorized",
    "order_authorized",
    "position_mutation_authorized",
    "dispatch_authorized",
    "trading_authorized",
    "production_authorized",
    "database_mutations",
    "orders_sent",
    "positions_modified",
    "dispatch_changed"
  ],
  "properties": {
    "schema_version": {
      "const": "commodity_c_fast_t1_query_v3_image_attestation_v1"
    },
    "status": {
      "const": "QUERY_V3_SOURCE_BUNDLE_AND_OCI_CONTENT_VERIFIED_NO_BUILD_OR_REGISTRY_PROVENANCE"
    },
    "source_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_bundle_archive_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_manifest_raw_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_manifest_canonical_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "external_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "containerfile_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "verifier_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_manifest_schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "attestation_schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "base_image_digest": {
      "$ref": "#/$defs/ociDigest"
    },
    "base_platform_manifest_digest": {
      "$ref": "#/$defs/ociDigest"
    },
    "base_rootfs_layer_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ociDigest"
      }
    },
    "base_rootfs_diff_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ociDigest"
      }
    },
    "python_execution_closure_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "python_execution_closure_entries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "installed_dependency_metadata_versions": {
      "const": {
        "attrs": "26.1.0",
        "cffi": "2.1.0",
        "cryptography": "48.0.0",
        "jsonschema": "4.26.0",
        "jsonschema-specifications": "2025.9.1",
        "psycopg": "3.2.3",
        "psycopg-binary": "3.2.3",
        "pycparser": "3.0",
        "referencing": "0.37.0",
        "rpds-py": "2026.6.3",
        "typing-extensions": "4.16.0"
      }
    },
    "oci_layout_archive_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "image_reference": {
      "type": "string",
      "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
    },
    "image_digest": {
      "$ref": "#/$defs/ociDigest"
    },
    "image_id": {
      "$ref": "#/$defs/ociDigest"
    },
    "rootfs_layer_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ociDigest"
      }
    },
    "runtime_bundle_sha256": {
      "$ref": "#/$defs/runtimeBundle"
    },
    "runtime_bundle_index_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_bundle_archive_recomputed",
        "source_manifest_schema_valid",
        "source_manifest_identity_recomputed",
        "source_bundle_exact_allowlist_verified",
        "source_bundle_metadata_canonical",
        "source_commit_assertion_bound",
        "git_binary_required",
        "git_commit_independently_resolved",
        "containerfile_instruction_contract_matched",
        "oci_archive_sha256_recomputed",
        "oci_manifest_config_and_layers_recomputed",
        "pinned_base_rootfs_prefix_verified",
        "post_base_delta_allowlist_verified",
        "python_startup_closure_verified",
        "python_execution_closure_frozen",
        "immutable_image_reference_matched",
        "runtime_files_recomputed_from_layers",
        "runtime_bundle_matches_source_bundle",
        "forbidden_and_signer_paths_absent",
        "build_provenance_verified",
        "registry_provenance_verified"
      ],
      "properties": {
        "source_bundle_archive_recomputed": {
          "const": true
        },
        "source_manifest_schema_valid": {
          "const": true
        },
        "source_manifest_identity_recomputed": {
          "const": true
        },
        "source_bundle_exact_allowlist_verified": {
          "const": true
        },
        "source_bundle_metadata_canonical": {
          "const": true
        },
        "source_commit_assertion_bound": {
          "const": true
        },
        "git_binary_required": {
          "const": false
        },
        "git_commit_independently_resolved": {
          "const": false
        },
        "containerfile_instruction_contract_matched": {
          "const": true
        },
        "oci_archive_sha256_recomputed": {
          "const": true
        },
        "oci_manifest_config_and_layers_recomputed": {
          "const": true
        },
        "pinned_base_rootfs_prefix_verified": {
          "const": true
        },
        "post_base_delta_allowlist_verified": {
          "const": true
        },
        "python_startup_closure_verified": {
          "const": true
        },
        "python_execution_closure_frozen": {
          "const": true
        },
        "immutable_image_reference_matched": {
          "const": true
        },
        "runtime_files_recomputed_from_layers": {
          "const": true
        },
        "runtime_bundle_matches_source_bundle": {
          "const": true
        },
        "forbidden_and_signer_paths_absent": {
          "const": true
        },
        "build_provenance_verified": {
          "const": false
        },
        "registry_provenance_verified": {
          "const": false
        }
      }
    },
    "image_built_here": {
      "const": false
    },
    "cryptographic_approval_present": {
      "const": false
    },
    "sensitive_material_present": {
      "const": false
    },
    "authority_granted": {
      "const": false
    },
    "network_authorized": {
      "const": false
    },
    "production_query_authorized": {
      "const": false
    },
    "collection_authorized": {
      "const": false
    },
    "deployment_mutation_authorized": {
      "const": false
    },
    "runtime_activation_authorized": {
      "const": false
    },
    "order_authorized": {
      "const": false
    },
    "position_mutation_authorized": {
      "const": false
    },
    "dispatch_authorized": {
      "const": false
    },
    "trading_authorized": {
      "const": false
    },
    "production_authorized": {
      "const": false
    },
    "database_mutations": {
      "const": 0
    },
    "orders_sent": {
      "const": 0
    },
    "positions_modified": {
      "const": 0
    },
    "dispatch_changed": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ociDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runtimeBundle": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {
        "pattern": "^/opt/c-fast-t1/[A-Za-z0-9._/-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    }
  }
}
