{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vnpy.example/schemas/windows-rpc-durable-fence-service-config-transition-receipt-v1.json",
  "title": "Post-reservation Windows service configuration transition receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "receipt_id", "receipt_core_sha256",
    "install_attempt_id", "install_manifest_raw_sha256",
    "preflight_receipt_raw_sha256", "publish_receipt_raw_sha256",
    "restart_authorization_raw_sha256", "reservation_event_id",
    "reservation_event_raw_sha256", "service_name", "host_boot_id",
    "service_control_operation_id", "restart_dispatch_nonce_sha256",
    "transition_plan_sha256", "applied_at_utc", "readback_at_utc", "trusted_clock_id",
    "preinstall_service_image_path_canonical_sha256",
    "preinstall_service_config_canonical_sha256",
    "safety_service_config_canonical_sha256",
    "safety_service_config_readback_sha256",
    "safety_service_image_path_readback_sha256",
    "target_service_image_path_canonical_sha256",
    "target_service_image_path_readback_sha256",
    "target_service_config_canonical_sha256",
    "target_service_config_readback_sha256", "service_config_owner_sid_sha256",
    "service_config_acl_sddl_sha256", "service_config_acl_readback_sddl_sha256",
    "service_config_unsafe_write_principals", "authorized_changed_fields",
    "safety_transition_applied_before_target_image_path",
    "target_service_start_type", "target_recovery_actions_disabled",
    "target_failure_actions_disabled", "automatic_policy_restore_authorized",
    "service_account_unchanged", "dependencies_unchanged",
    "expected_service_process_id",
    "expected_service_process_started_at_utc", "service_process_identity_unchanged",
    "transition_manifest_bound", "transition_applied_once",
    "target_readback_verified", "post_transition_mutation_authorized",
    "restart_dispatched", "authority"
  ],
  "properties": {
    "schema_version": {"const": "windows_rpc_durable_fence_service_config_transition_receipt_v1"},
    "purpose": {"const": "prove_one_exact_post_reservation_service_config_transition_without_restart"},
    "receipt_id": {"type": "string", "pattern": "^windows-fence-service-config-transition-[0-9a-f]{64}$"},
    "receipt_core_sha256": {"$ref": "#/$defs/sha256"},
    "install_attempt_id": {"$ref": "#/$defs/attemptId"},
    "install_manifest_raw_sha256": {"$ref": "#/$defs/sha256"},
    "preflight_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "publish_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "restart_authorization_raw_sha256": {"$ref": "#/$defs/sha256"},
    "reservation_event_id": {"type": "string", "pattern": "^windows-fence-install-event-[0-9a-f]{64}$"},
    "reservation_event_raw_sha256": {"$ref": "#/$defs/sha256"},
    "service_name": {"$ref": "#/$defs/serviceName"},
    "host_boot_id": {"$ref": "#/$defs/identifier"},
    "service_control_operation_id": {"$ref": "#/$defs/identifier"},
    "restart_dispatch_nonce_sha256": {"$ref": "#/$defs/sha256"},
    "transition_plan_sha256": {"$ref": "#/$defs/sha256"},
    "applied_at_utc": {"$ref": "#/$defs/utc"},
    "readback_at_utc": {"$ref": "#/$defs/utc"},
    "trusted_clock_id": {"$ref": "#/$defs/identifier"},
    "preinstall_service_image_path_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "preinstall_service_config_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "safety_service_config_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "safety_service_config_readback_sha256": {"$ref": "#/$defs/sha256"},
    "safety_service_image_path_readback_sha256": {"$ref": "#/$defs/sha256"},
    "target_service_image_path_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "target_service_image_path_readback_sha256": {"$ref": "#/$defs/sha256"},
    "target_service_config_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "target_service_config_readback_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_owner_sid_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_acl_sddl_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_acl_readback_sddl_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_unsafe_write_principals": {"type": "array", "maxItems": 0},
    "authorized_changed_fields": {"const": ["FailureActions", "ImagePath", "RecoveryActions", "StartType"]},
    "safety_transition_applied_before_target_image_path": {"const": true},
    "target_service_start_type": {"const": "DEMAND_START"},
    "target_recovery_actions_disabled": {"const": true},
    "target_failure_actions_disabled": {"const": true},
    "automatic_policy_restore_authorized": {"const": false},
    "service_account_unchanged": {"const": true},
    "dependencies_unchanged": {"const": true},
    "expected_service_process_id": {"type": "integer", "minimum": 1},
    "expected_service_process_started_at_utc": {"$ref": "#/$defs/utc"},
    "service_process_identity_unchanged": {"const": true},
    "transition_manifest_bound": {"const": true},
    "transition_applied_once": {"const": true},
    "target_readback_verified": {"const": true},
    "post_transition_mutation_authorized": {"const": false},
    "restart_dispatched": {"const": false},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attemptId": {"type": "string", "pattern": "^windows-fence-install-[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "serviceName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows_fence_released", "authority_restore_allowed", "consume_authorized",
        "reconciliation_authorized", "deployment_authorized", "automatic_deploy_allowed",
        "production_allowed", "live_trading_authorized", "send_order_authorized",
        "cancel_order_authorized", "countable_forward"
      ],
      "properties": {
        "windows_fence_released": {"const": false},
        "authority_restore_allowed": {"const": false},
        "consume_authorized": {"const": false},
        "reconciliation_authorized": {"const": false},
        "deployment_authorized": {"const": false},
        "automatic_deploy_allowed": {"const": false},
        "production_allowed": {"const": false},
        "live_trading_authorized": {"const": false},
        "send_order_authorized": {"const": false},
        "cancel_order_authorized": {"const": false},
        "countable_forward": {"const": false}
      }
    }
  }
}
