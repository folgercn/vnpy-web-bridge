{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:commodity-c-fast-t1-one-shot-query-executable-release-v6",
  "title": "C_FAST query-v6 distinct executable one-shot release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "candidate_id",
    "parent_issue_number",
    "issue_number",
    "release_id",
    "attempt_id",
    "issued_at",
    "not_before",
    "expires_at",
    "signer_key_id",
    "signer_type",
    "reviewer_role",
    "human_signature",
    "trusted_keyring_sha256",
    "foundation",
    "execution",
    "one_shot",
    "maximum_uses",
    "replay_allowed",
    "server_enforced_readonly_required",
    "consume_before_dsn_secret_read",
    "consume_before_network",
    "final_revalidation_before_network",
    "pre_and_post_readonly_proof_required",
    "foundation_is_authority",
    "authority_granted",
    "release_consumption_authorized",
    "t1_one_shot_child_launch_authorized",
    "network_authorized",
    "network_query_authorized",
    "readonly_production_query_authorized",
    "production_query_authorized",
    "readonly_query_authorized",
    "local_query_evidence_write_authorized",
    "write_probe_authorized",
    "database_mutation_authorized",
    "collection_authorized",
    "web_bridge_rpc_authorized",
    "order_authorized",
    "order_submission_authorized",
    "position_mutation_authorized",
    "dispatch_authorized",
    "trading_authorized",
    "strategy_activation_authorized",
    "production_authorized",
    "p0_acceptance_authorized",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "commodity_c_fast_t1_one_shot_query_executable_release_v6"
    },
    "purpose": {"const": "c_fast_t1_query_v6_distinct_executable_one_shot"},
    "candidate_id": {"const": "C_FAST_CROSS_SECTION_NEUTRAL"},
    "parent_issue_number": {"const": 114},
    "issue_number": {"const": 216},
    "release_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/attemptId"},
    "issued_at": {"$ref": "#/$defs/dateTime"},
    "not_before": {"$ref": "#/$defs/dateTime"},
    "expires_at": {"$ref": "#/$defs/dateTime"},
    "signer_key_id": {"$ref": "#/$defs/id"},
    "signer_type": {"const": "human"},
    "reviewer_role": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "not": {"pattern": "^PENDING_"}
    },
    "human_signature": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512,
      "not": {"pattern": "^PENDING_"}
    },
    "trusted_keyring_sha256": {"$ref": "#/$defs/sha256"},
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id", "attempt_id", "raw_sha256", "canonical_sha256",
        "signer_public_key_sha256", "trusted_keyring_sha256", "authority_state",
        "provenance_raw_sha256", "provenance_canonical_sha256",
        "composition_attestation_raw_sha256", "composition_attestation_canonical_sha256",
        "readiness_v4_raw_sha256", "readiness_v4_canonical_sha256",
        "l3_outcome_raw_sha256", "l3_outcome_canonical_sha256",
        "query_manifest_raw_sha256", "query_manifest_canonical_sha256",
        "snapshot_id", "audit_window", "runtime_source_commit_sha",
        "runtime_image_reference", "runtime_image_digest", "runtime_image_id",
        "runtime_pin_generation_id", "runtime_pin_manifest_sha256",
        "runtime_identity_sha256", "custody_absolute_path", "custody_path_sha256",
        "custody_id", "custody_identity_sha256", "custody_directory_identity_sha256",
        "dsn_file_identity_attestation_raw_sha256",
        "dsn_file_identity_attestation_canonical_sha256", "dsn_file_identity_sha256",
        "expected_readonly_principal_sha256", "expected_endpoint_identity_sha256",
        "query_child_sha256", "audit_script_sha256", "readonly_proof_schema_sha256"
      ],
      "properties": {
        "release_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/attemptId"},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "signer_public_key_sha256": {"$ref": "#/$defs/sha256"},
        "trusted_keyring_sha256": {"$ref": "#/$defs/sha256"},
        "authority_state": {"const": "FOUNDATION_ONLY_NO_QUERY_AUTHORITY"},
        "provenance_raw_sha256": {"$ref": "#/$defs/sha256"},
        "provenance_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "composition_attestation_raw_sha256": {"$ref": "#/$defs/sha256"},
        "composition_attestation_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "readiness_v4_raw_sha256": {"$ref": "#/$defs/sha256"},
        "readiness_v4_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "l3_outcome_raw_sha256": {"$ref": "#/$defs/sha256"},
        "l3_outcome_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "query_manifest_raw_sha256": {"$ref": "#/$defs/sha256"},
        "query_manifest_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_id": {"$ref": "#/$defs/id"},
        "audit_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end_exclusive", "trading_day"],
          "properties": {
            "start": {"$ref": "#/$defs/dateTime"},
            "end_exclusive": {"$ref": "#/$defs/dateTime"},
            "trading_day": {"type": "string", "pattern": "^[0-9]{8}$"}
          }
        },
        "runtime_source_commit_sha": {"$ref": "#/$defs/commit"},
        "runtime_image_reference": {"$ref": "#/$defs/imageReference"},
        "runtime_image_digest": {"$ref": "#/$defs/ociDigest"},
        "runtime_image_id": {"$ref": "#/$defs/ociDigest"},
        "runtime_pin_generation_id": {"$ref": "#/$defs/id"},
        "runtime_pin_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_identity_sha256": {"$ref": "#/$defs/sha256"},
        "custody_absolute_path": {"type": "string", "pattern": "^/[^\\u0000]+$"},
        "custody_path_sha256": {"$ref": "#/$defs/sha256"},
        "custody_id": {"$ref": "#/$defs/id"},
        "custody_identity_sha256": {"$ref": "#/$defs/sha256"},
        "custody_directory_identity_sha256": {"$ref": "#/$defs/sha256"},
        "dsn_file_identity_attestation_raw_sha256": {"$ref": "#/$defs/sha256"},
        "dsn_file_identity_attestation_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "dsn_file_identity_sha256": {"$ref": "#/$defs/sha256"},
        "expected_readonly_principal_sha256": {"$ref": "#/$defs/sha256"},
        "expected_endpoint_identity_sha256": {"$ref": "#/$defs/sha256"},
        "query_child_sha256": {"$ref": "#/$defs/sha256"},
        "audit_script_sha256": {"$ref": "#/$defs/sha256"},
        "readonly_proof_schema_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pin_set_generation_id", "pin_set_manifest_sha256",
        "executable_signer_sha256", "executable_verifier_sha256",
        "executable_runner_sha256", "executable_release_schema_sha256",
        "executable_keyring_schema_sha256", "consume_schema_sha256",
        "terminal_schema_sha256", "audit_evidence_schema_sha256",
        "legacy_audit_evidence_schema_sha256", "readonly_proof_schema_sha256",
        "child_launch_schema_sha256", "adapter_package_schema_sha256",
        "adapter_package_builder_sha256", "execution_adapter_sha256",
        "execution_adapter_absolute_path", "adapter_package_manifest_absolute_path",
        "adapter_package_manifest_sha256", "adapter_package_root_identity_sha256",
        "python_executable_path", "python_executable_sha256",
        "python_dependency_closure_sha256", "questdb_build_sha256",
        "connect_timeout_seconds", "statement_timeout_ms",
        "maximum_runtime_seconds", "minimum_launch_margin_seconds"
      ],
      "properties": {
        "pin_set_generation_id": {"$ref": "#/$defs/id"},
        "pin_set_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "executable_signer_sha256": {"$ref": "#/$defs/sha256"},
        "executable_verifier_sha256": {"$ref": "#/$defs/sha256"},
        "executable_runner_sha256": {"$ref": "#/$defs/sha256"},
        "executable_release_schema_sha256": {"$ref": "#/$defs/sha256"},
        "executable_keyring_schema_sha256": {"$ref": "#/$defs/sha256"},
        "consume_schema_sha256": {"$ref": "#/$defs/sha256"},
        "terminal_schema_sha256": {"$ref": "#/$defs/sha256"},
        "audit_evidence_schema_sha256": {"$ref": "#/$defs/sha256"},
        "legacy_audit_evidence_schema_sha256": {"$ref": "#/$defs/sha256"},
        "readonly_proof_schema_sha256": {"$ref": "#/$defs/sha256"},
        "child_launch_schema_sha256": {"$ref": "#/$defs/sha256"},
        "adapter_package_schema_sha256": {"$ref": "#/$defs/sha256"},
        "adapter_package_builder_sha256": {"$ref": "#/$defs/sha256"},
        "execution_adapter_sha256": {"$ref": "#/$defs/sha256"},
        "execution_adapter_absolute_path": {"type": "string", "pattern": "^/[^\\u0000]+$"},
        "adapter_package_manifest_absolute_path": {"type": "string", "pattern": "^/[^\\u0000]+$"},
        "adapter_package_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "adapter_package_root_identity_sha256": {"$ref": "#/$defs/sha256"},
        "python_executable_path": {"type": "string", "pattern": "^/[^\\u0000]+$"},
        "python_executable_sha256": {"$ref": "#/$defs/sha256"},
        "python_dependency_closure_sha256": {"$ref": "#/$defs/sha256"},
        "questdb_build_sha256": {"$ref": "#/$defs/sha256"},
        "connect_timeout_seconds": {"const": 10},
        "statement_timeout_ms": {"const": 60000},
        "maximum_runtime_seconds": {"const": 600},
        "minimum_launch_margin_seconds": {
          "type": "integer", "minimum": 1, "maximum": 120
        }
      }
    },
    "one_shot": {"const": true},
    "maximum_uses": {"const": 1},
    "replay_allowed": {"const": false},
    "server_enforced_readonly_required": {"const": true},
    "consume_before_dsn_secret_read": {"const": true},
    "consume_before_network": {"const": true},
    "final_revalidation_before_network": {"const": true},
    "pre_and_post_readonly_proof_required": {"const": true},
    "foundation_is_authority": {"const": false},
    "authority_granted": {"const": true},
    "release_consumption_authorized": {"const": true},
    "t1_one_shot_child_launch_authorized": {"const": true},
    "network_authorized": {"const": true},
    "network_query_authorized": {"const": true},
    "readonly_production_query_authorized": {"const": true},
    "production_query_authorized": {"const": true},
    "readonly_query_authorized": {"const": true},
    "local_query_evidence_write_authorized": {"const": true},
    "write_probe_authorized": {"const": false},
    "database_mutation_authorized": {"const": false},
    "collection_authorized": {"const": false},
    "web_bridge_rpc_authorized": {"const": false},
    "order_authorized": {"const": false},
    "order_submission_authorized": {"const": false},
    "position_mutation_authorized": {"const": false},
    "dispatch_authorized": {"const": false},
    "trading_authorized": {"const": false},
    "strategy_activation_authorized": {"const": false},
    "production_authorized": {"const": false},
    "p0_acceptance_authorized": {"const": false},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "id": {
      "type": "string", "minLength": 8, "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "attemptId": {"type": "string", "pattern": "^attempt-[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ociDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "imageReference": {
      "type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
    },
    "dateTime": {"type": "string", "format": "date-time"},
    "signature": {
      "type": "string",
      "minLength": 88,
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  }
}
