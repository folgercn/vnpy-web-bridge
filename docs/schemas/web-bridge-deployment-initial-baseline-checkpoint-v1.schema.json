        "account_hashes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/sha256"}}, "orders": {"$ref": "#/$defs/rows"}, "active_orders": {"const": []}, "trades": {"$ref": "#/$defs/rows"}, "positions": {"$ref": "#/$defs/rows"}
      }
    },
    "rpcRecheckFacts": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "request_id", "owner_challenge", "recheck_id", "fresh_challenge", "original_server_instance_id", "original_fact_generation", "original_execution_facts_canonical_sha256", "server_instance_id", "fact_generation", "execution_facts_canonical_sha256", "captured_at", "execution_admission_frozen", "pending_send_outcomes", "strategy_execution_enabled", "account_hashes", "orders", "active_orders", "trades", "positions"],
      "properties": {
        "schema_version": {"const": "windows_rpc_deployment_safety_recheck_v1"}, "request_id": {"$ref": "#/$defs/identifier"}, "owner_challenge": {"$ref": "#/$defs/nonce"},
        "recheck_id": {"type": "string", "pattern": "^deployment-recheck-(?!0{64}$)[0-9a-f]{64}$"}, "fresh_challenge": {"$ref": "#/$defs/nonce"},
        "original_server_instance_id": {"$ref": "#/$defs/identifier"}, "original_fact_generation": {"type": "integer", "minimum": 0}, "original_execution_facts_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "server_instance_id": {"$ref": "#/$defs/identifier"}, "fact_generation": {"type": "integer", "minimum": 0}, "execution_facts_canonical_sha256": {"$ref": "#/$defs/sha256"}, "captured_at": {"$ref": "#/$defs/dateTime"},
        "execution_admission_frozen": {"const": true}, "pending_send_outcomes": {"const": 0}, "strategy_execution_enabled": {"const": false},
        "account_hashes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/sha256"}}, "orders": {"$ref": "#/$defs/rows"}, "active_orders": {"const": []}, "trades": {"$ref": "#/$defs/rows"}, "positions": {"$ref": "#/$defs/rows"}
      }
    }
  }
}
