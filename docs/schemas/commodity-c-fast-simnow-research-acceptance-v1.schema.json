{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bktrader.local/schemas/commodity-c-fast-simnow-research-acceptance-v1.schema.json",
  "title": "C_FAST SimNow Research Control Acceptance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "candidate_id",
    "parent_issue_number",
    "issue_number",
    "acceptance_id",
    "accepted_at",
    "not_before",
    "expires_at",
    "execution_day",
    "acceptance_state",
    "acceptance_scope",
    "execution_permit_required",
    "source_artifacts_exact_raw_reverified",
    "signer_type",
    "reviewer_role",
    "human_signature",
    "signer_key_id",
    "research_bundle_id",
    "research_bundle_raw_sha256",
    "research_bundle_canonical_sha256",
    "research_keyring_raw_sha256",
    "research_install_claim_id",
    "research_install_claim_raw_sha256",
    "research_install_claim_canonical_sha256",
    "research_install_receipt_raw_sha256",
    "research_install_receipt_canonical_sha256",
    "research_artifact_bindings",
    "research_artifact_index_sha256",
    "formula_target_binding_sha256",
    "custody_root_path_sha256",
    "custody_identity_sha256",
    "research_install_files_identity_sha256",
    "acceptance_keyring_raw_sha256",
    "acceptance_verifier_sha256",
    "acceptance_signer_sha256",
    "acceptance_schema_sha256",
    "acceptance_keyring_schema_sha256",
    "consume_schema_sha256",
    "receipt_schema_sha256",
    "expected_simnow_account_sha256",
    "selected_products",
    "selected_targets",
    "selected_target_index_sha256",
    "acceptance_is_deployment_authority",
    "acceptance_is_execution_authority",
    "countable_forward",
    "official_forward_claimed",
    "production_allowed",
    "deployment_authorized",
    "execution_permit_issued",
    "simnow_execution_authorized",
    "runtime_activation_authorized",
    "network_authorized",
    "web_bridge_rpc_authorized",
    "order_authorized",
    "order_submission_authorized",
    "position_read_authorized",
    "position_mutation_authorized",
    "dispatch_authorized",
    "trading_authorized",
    "replacement_authorized",
    "production_authorized",
    "automatic_promotion_authorized",
    "dynamic_selection_allowed",
    "replay_allowed",
    "account_data_read",
    "execution_data_read",
    "orders_sent",
    "positions_modified",
    "web_bridge_rpc_calls",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "commodity_c_fast_simnow_research_acceptance_v1"
    },
    "purpose": {
      "const": "c_fast_simnow_research_control_acceptance"
    },
    "candidate_id": {"const": "C_FAST_CROSS_SECTION_NEUTRAL"},
    "parent_issue_number": {"const": 114},
    "issue_number": {"const": 162},
    "acceptance_id": {
      "type": "string",
      "pattern": "^cfast-simnow-research-accept-v1-[0-9a-f]{64}$"
    },
    "accepted_at": {"$ref": "#/$defs/dateTime"},
    "not_before": {"$ref": "#/$defs/dateTime"},
    "expires_at": {"$ref": "#/$defs/dateTime"},
    "execution_day": {"$ref": "#/$defs/date"},
    "acceptance_state": {
      "const": "READY_FOR_HUMAN_SIMNOW_EXECUTION_PERMIT_ONLY"
    },
    "acceptance_scope": {
      "const": "CONTROL_PLANE_RESEARCH_EVIDENCE_ONLY"
    },
    "execution_permit_required": {"const": true},
    "source_artifacts_exact_raw_reverified": {"const": true},
    "signer_type": {"const": "human"},
    "reviewer_role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {"pattern": "^PENDING_"}
    },
    "human_signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {"pattern": "^PENDING_"}
    },
    "signer_key_id": {"$ref": "#/$defs/id"},
    "research_bundle_id": {
      "type": "string",
      "pattern": "^cfast-simnow-research-v1-[0-9a-f]{64}$"
    },
    "research_bundle_raw_sha256": {"$ref": "#/$defs/sha256"},
    "research_bundle_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "research_keyring_raw_sha256": {"$ref": "#/$defs/sha256"},
    "research_install_claim_id": {
      "type": "string",
      "pattern": "^cfast-simnow-install-claim-v1-[0-9a-f]{64}$"
    },
    "research_install_claim_raw_sha256": {"$ref": "#/$defs/sha256"},
    "research_install_claim_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "research_install_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "research_install_receipt_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "research_artifact_bindings": {"$ref": "#/$defs/artifactBindings"},
    "research_artifact_index_sha256": {"$ref": "#/$defs/sha256"},
    "formula_target_binding_sha256": {"$ref": "#/$defs/sha256"},
    "custody_root_path_sha256": {"$ref": "#/$defs/sha256"},
    "custody_identity_sha256": {"$ref": "#/$defs/sha256"},
    "research_install_files_identity_sha256": {"$ref": "#/$defs/sha256"},
    "acceptance_keyring_raw_sha256": {"$ref": "#/$defs/sha256"},
    "acceptance_verifier_sha256": {"$ref": "#/$defs/sha256"},
    "acceptance_signer_sha256": {"$ref": "#/$defs/sha256"},
    "acceptance_schema_sha256": {"$ref": "#/$defs/sha256"},
    "acceptance_keyring_schema_sha256": {"$ref": "#/$defs/sha256"},
    "consume_schema_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_schema_sha256": {"$ref": "#/$defs/sha256"},
    "expected_simnow_account_sha256": {"$ref": "#/$defs/sha256"},
    "selected_products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/product"}
    },
    "selected_targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/selectedTarget"}
    },
    "selected_target_index_sha256": {"$ref": "#/$defs/sha256"},
    "acceptance_is_deployment_authority": {"const": false},
    "acceptance_is_execution_authority": {"const": false},
    "countable_forward": {"const": false},
    "official_forward_claimed": {"const": false},
    "production_allowed": {"const": false},
    "deployment_authorized": {"const": false},
    "execution_permit_issued": {"const": false},
    "simnow_execution_authorized": {"const": false},
    "runtime_activation_authorized": {"const": false},
    "network_authorized": {"const": false},
    "web_bridge_rpc_authorized": {"const": false},
    "order_authorized": {"const": false},
    "order_submission_authorized": {"const": false},
    "position_read_authorized": {"const": false},
    "position_mutation_authorized": {"const": false},
    "dispatch_authorized": {"const": false},
    "trading_authorized": {"const": false},
    "replacement_authorized": {"const": false},
    "production_authorized": {"const": false},
    "automatic_promotion_authorized": {"const": false},
    "dynamic_selection_allowed": {"const": false},
    "replay_allowed": {"const": false},
    "account_data_read": {"const": false},
    "execution_data_read": {"const": false},
    "orders_sent": {"const": 0},
    "positions_modified": {"const": 0},
    "web_bridge_rpc_calls": {"const": 0},
    "signature": {
      "type": "string",
      "minLength": 88,
      "maxLength": 88
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{8,128}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "product": {
      "enum": ["ag", "al", "au", "bu", "cu", "rb", "ru", "sc", "sp", "zn"]
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "raw_sha256"],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "raw_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freeze_contract",
        "research_manifest",
        "signal_evidence",
        "target_evidence",
        "allocation_evidence",
        "daily_roll_evidence",
        "reference_price_evidence",
        "calendar_authority",
        "contract_spec_evidence"
      ],
      "properties": {
        "freeze_contract": {"$ref": "#/$defs/artifactBinding"},
        "research_manifest": {"$ref": "#/$defs/artifactBinding"},
        "signal_evidence": {"$ref": "#/$defs/artifactBinding"},
        "target_evidence": {"$ref": "#/$defs/artifactBinding"},
        "allocation_evidence": {"$ref": "#/$defs/artifactBinding"},
        "daily_roll_evidence": {"$ref": "#/$defs/artifactBinding"},
        "reference_price_evidence": {"$ref": "#/$defs/artifactBinding"},
        "calendar_authority": {"$ref": "#/$defs/artifactBinding"},
        "contract_spec_evidence": {"$ref": "#/$defs/artifactBinding"}
      }
    },
    "selectedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "exact_contract",
        "previous_target_quantity",
        "signed_target_quantity",
        "signed_target_delta",
        "signed_target_row_sha256"
      ],
      "properties": {
        "product": {"$ref": "#/$defs/product"},
        "exact_contract": {
          "type": "string",
          "pattern": "^(SHFE|INE)\\.[a-z]{2}[0-9]{4}$"
        },
        "previous_target_quantity": {"const": 0},
        "signed_target_quantity": {
          "type": "integer",
          "minimum": -500,
          "maximum": 500
        },
        "signed_target_delta": {
          "type": "integer",
          "minimum": -500,
          "maximum": 500,
          "not": {"const": 0}
        },
        "signed_target_row_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
