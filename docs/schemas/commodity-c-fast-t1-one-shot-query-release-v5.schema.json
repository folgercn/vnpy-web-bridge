{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:commodity-c-fast-t1-one-shot-query-release-v5",
  "title": "C_FAST query-v5 signed one-shot readonly release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "candidate_id", "parent_issue_number",
    "issue_number", "release_id", "attempt_id", "issued_at",
    "not_before", "expires_at", "signer_key_id", "signer_type",
    "reviewer_role", "human_signature", "trusted_keyring_sha256",
    "provenance_raw_sha256", "provenance_canonical_sha256",
    "provenance_signer_public_key_sha256",
    "composition_attestation_raw_sha256",
    "composition_attestation_canonical_sha256",
    "runtime_source_commit_sha", "runtime_image_reference",
    "runtime_image_digest", "runtime_image_id", "provenance_schema_sha256",
    "composition_attestation_schema_sha256", "release_schema_sha256",
    "pre_dsn_receipt_schema_sha256", "pre_dsn_gate_source_sha256",
    "query_v5_code_only_launcher_sha256", "maximum_release_ttl_seconds",
    "minimum_launch_margin_seconds", "t1_one_shot_child_launch_authorized",
    "network_query_authorized", "readonly_production_query_authorized",
    "local_query_evidence_write_authorized", "write_probe_authorized",
    "database_mutation_authorized", "deployment_mutation_authorized",
    "readonly_principal_deployment_authorized",
    "readonly_secret_file_installation_authorized",
    "questdb_restart_authorized", "questdb_recreate_authorized",
    "questdb_image_change_authorized", "network_mutation_authorized",
    "web_bridge_deployment_authorized", "collection_authorized",
    "execution_quality_collection_authorized", "runtime_activation_authorized",
    "web_bridge_rpc_authorized", "order_authorized",
    "order_submission_authorized", "position_mutation_authorized",
    "dispatch_authorized", "trading_authorized",
    "strategy_activation_authorized", "replacement_authorized",
    "production_authorized", "dynamic_selection_allowed",
    "automatic_promotion_authorized", "p0_acceptance_authorized",
    "replay_allowed", "signature"
  ],
  "properties": {
    "schema_version": {"const": "commodity_c_fast_t1_one_shot_query_release_v5"},
    "purpose": {"const": "c_fast_t1_exact_final_image_readonly_query_authority_v5"},
    "candidate_id": {"const": "C_FAST_CROSS_SECTION_NEUTRAL"},
    "parent_issue_number": {"const": 114},
    "issue_number": {"const": 216},
    "release_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"type": "string", "pattern": "^attempt-[0-9a-f]{64}$"},
    "issued_at": {"$ref": "#/$defs/dateTime"},
    "not_before": {"$ref": "#/$defs/dateTime"},
    "expires_at": {"$ref": "#/$defs/dateTime"},
    "signer_key_id": {"$ref": "#/$defs/id"},
    "signer_type": {"const": "human"},
    "reviewer_role": {"type": "string", "minLength": 3, "maxLength": 128, "not": {"pattern": "^PENDING_"}},
    "human_signature": {"type": "string", "minLength": 8, "maxLength": 512, "not": {"pattern": "^PENDING_"}},
    "trusted_keyring_sha256": {"$ref": "#/$defs/sha256"},
    "provenance_raw_sha256": {"$ref": "#/$defs/sha256"},
    "provenance_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "provenance_signer_public_key_sha256": {"$ref": "#/$defs/sha256"},
    "composition_attestation_raw_sha256": {"$ref": "#/$defs/sha256"},
    "composition_attestation_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_source_commit_sha": {"$ref": "#/$defs/commit"},
    "runtime_image_reference": {"$ref": "#/$defs/imageReference"},
    "runtime_image_digest": {"$ref": "#/$defs/ociDigest"},
    "runtime_image_id": {"$ref": "#/$defs/ociDigest"},
    "provenance_schema_sha256": {"$ref": "#/$defs/sha256"},
    "composition_attestation_schema_sha256": {"$ref": "#/$defs/sha256"},
    "release_schema_sha256": {"$ref": "#/$defs/sha256"},
    "pre_dsn_receipt_schema_sha256": {"$ref": "#/$defs/sha256"},
    "pre_dsn_gate_source_sha256": {"$ref": "#/$defs/sha256"},
    "query_v5_code_only_launcher_sha256": {"$ref": "#/$defs/sha256"},
    "maximum_release_ttl_seconds": {"const": 600},
    "minimum_launch_margin_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "t1_one_shot_child_launch_authorized": {"const": true},
    "network_query_authorized": {"const": true},
    "readonly_production_query_authorized": {"const": true},
    "local_query_evidence_write_authorized": {"const": true},
    "write_probe_authorized": {"const": false},
    "database_mutation_authorized": {"const": false},
    "deployment_mutation_authorized": {"const": false},
    "readonly_principal_deployment_authorized": {"const": false},
    "readonly_secret_file_installation_authorized": {"const": false},
    "questdb_restart_authorized": {"const": false},
    "questdb_recreate_authorized": {"const": false},
    "questdb_image_change_authorized": {"const": false},
    "network_mutation_authorized": {"const": false},
    "web_bridge_deployment_authorized": {"const": false},
    "collection_authorized": {"const": false},
    "execution_quality_collection_authorized": {"const": false},
    "runtime_activation_authorized": {"const": false},
    "web_bridge_rpc_authorized": {"const": false},
    "order_authorized": {"const": false},
    "order_submission_authorized": {"const": false},
    "position_mutation_authorized": {"const": false},
    "dispatch_authorized": {"const": false},
    "trading_authorized": {"const": false},
    "strategy_activation_authorized": {"const": false},
    "replacement_authorized": {"const": false},
    "production_authorized": {"const": false},
    "dynamic_selection_allowed": {"const": false},
    "automatic_promotion_authorized": {"const": false},
    "p0_acceptance_authorized": {"const": false},
    "replay_allowed": {"const": false},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ociDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "imageReference": {"type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"},
    "dateTime": {"type": "string", "format": "date-time"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  }
}
