{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:commodity-c-fast-readonly-deployment-principal-secret-post-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attestation_id", "candidate_id", "release_id", "attempt_id",
    "release_raw_sha256", "consume_marker_raw_sha256", "receipt_raw_sha256",
    "captured_at", "capture_method", "questdb_target_identity_sha256",
    "readonly_principal_identity_sha256",
    "principal_differs_from_admin", "readonly_password_value_source",
    "global_pgwire_readonly", "instance_readonly", "secret_file_path_sha256",
    "owner_uid", "owner_gid", "mode", "regular_file", "symlink",
    "secret_content_read", "principal_name_included", "secret_content_included"
  ],
  "properties": {
    "schema_version": {"const": "commodity_c_fast_readonly_deployment_principal_secret_post_v1"},
    "attestation_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"const": "C_FAST_CROSS_SECTION_NEUTRAL"},
    "release_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/attemptId"},
    "release_raw_sha256": {"$ref": "#/$defs/sha256"},
    "consume_marker_raw_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "captured_at": {"$ref": "#/$defs/dateTime"},
    "capture_method": {"const": "lstat_and_questdb_config_identity_post_restart_v1"},
    "questdb_target_identity_sha256": {"$ref": "#/$defs/sha256"},
    "readonly_principal_identity_sha256": {"$ref": "#/$defs/sha256"},
    "principal_differs_from_admin": {"const": true},
    "readonly_password_value_source": {"const": "file"},
    "global_pgwire_readonly": {"const": false},
    "instance_readonly": {"const": false},
    "secret_file_path_sha256": {"$ref": "#/$defs/sha256"},
    "owner_uid": {"const": 65532},
    "owner_gid": {"const": 65532},
    "mode": {"const": "0600"},
    "regular_file": {"const": true},
    "symlink": {"const": false},
    "secret_content_read": {"const": false},
    "principal_name_included": {"const": false},
    "secret_content_included": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$"},
    "attemptId": {"type": "string", "pattern": "^attempt-[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dateTime": {"type": "string", "format": "date-time"}
  }
}
