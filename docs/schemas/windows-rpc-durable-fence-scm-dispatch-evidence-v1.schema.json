{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vnpy.example/schemas/windows-rpc-durable-fence-scm-dispatch-evidence-v1.json",
  "title": "Host-observed exact Windows SCM restart dispatch evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "evidence_id", "evidence_core_sha256",
    "install_attempt_id", "install_manifest_raw_sha256",
    "restart_authorization_raw_sha256", "reservation_event_raw_sha256",
    "service_config_transition_receipt_raw_sha256", "service_name",
    "service_control_operation_id", "restart_dispatch_nonce_sha256",
    "host_boot_id", "audit_provider", "audit_provider_guid_sha256",
    "audit_channel", "audit_record_sequence", "audit_trace_id",
    "audit_trace_raw_sha256", "trace_challenge_id", "trace_challenge_nonce_sha256",
    "trace_challenge_issued_at_utc", "trace_captured_at_utc", "trace_expires_at_utc",
    "trusted_clock_id", "maximum_trace_age_seconds", "trace_single_use",
    "trace_replay_guard_id", "caller_principal_sid_sha256",
    "caller_process_image_sha256", "caller_process_id", "caller_session_id",
    "scm_api_sequence", "stop_call_started_at_utc", "stop_call_returned_at_utc",
    "stop_api_result", "start_call_started_at_utc", "start_call_returned_at_utc",
    "start_api_result", "exact_caller_and_operation_verified",
    "authority", "canonicalization_profile", "signature_domain_separator",
    "signature_algorithm", "signer_role", "signer_key_domain", "signer_key_id",
    "signer_public_key_sha256", "signature"
  ],
  "properties": {
    "schema_version": {"const": "windows_rpc_durable_fence_scm_dispatch_evidence_v1"},
    "purpose": {"const": "prove_exact_installer_scm_restart_call_from_host_audit_trace"},
    "evidence_id": {"type": "string", "pattern": "^windows-fence-scm-dispatch-evidence-[0-9a-f]{64}$"},
    "evidence_core_sha256": {"$ref": "#/$defs/sha256"},
    "install_attempt_id": {"$ref": "#/$defs/attemptId"},
    "install_manifest_raw_sha256": {"$ref": "#/$defs/sha256"},
    "restart_authorization_raw_sha256": {"$ref": "#/$defs/sha256"},
    "reservation_event_raw_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_transition_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "service_name": {"$ref": "#/$defs/serviceName"},
    "service_control_operation_id": {"$ref": "#/$defs/identifier"},
    "restart_dispatch_nonce_sha256": {"$ref": "#/$defs/sha256"},
    "host_boot_id": {"$ref": "#/$defs/identifier"},
    "audit_provider": {"const": "Microsoft-Windows-Services-host-audit"},
    "audit_provider_guid_sha256": {"$ref": "#/$defs/sha256"},
    "audit_channel": {"const": "host-protected-scm-call-trace"},
    "audit_record_sequence": {"type": "integer", "minimum": 1},
    "audit_trace_id": {"type": "string", "pattern": "^windows-scm-audit-trace-[0-9a-f]{64}$"},
    "audit_trace_raw_sha256": {"$ref": "#/$defs/sha256"},
    "trace_challenge_id": {"type": "string", "pattern": "^windows-scm-trace-challenge-[0-9a-f]{64}$"},
    "trace_challenge_nonce_sha256": {"$ref": "#/$defs/sha256"},
    "trace_challenge_issued_at_utc": {"$ref": "#/$defs/utc"},
    "trace_captured_at_utc": {"$ref": "#/$defs/utc"},
    "trace_expires_at_utc": {"$ref": "#/$defs/utc"},
    "trusted_clock_id": {"$ref": "#/$defs/identifier"},
    "maximum_trace_age_seconds": {"const": 10},
    "trace_single_use": {"const": true},
    "trace_replay_guard_id": {"type": "string", "pattern": "^windows-scm-trace-replay-[0-9a-f]{64}$"},
    "caller_principal_sid_sha256": {"$ref": "#/$defs/sha256"},
    "caller_process_image_sha256": {"$ref": "#/$defs/sha256"},
    "caller_process_id": {"type": "integer", "minimum": 1},
    "caller_session_id": {"type": "integer", "minimum": 0},
    "scm_api_sequence": {"const": ["ControlService(STOP)", "StartServiceW"]},
    "stop_call_started_at_utc": {"$ref": "#/$defs/utc"},
    "stop_call_returned_at_utc": {"$ref": "#/$defs/utc"},
    "stop_api_result": {"const": "SERVICE_STOPPED"},
    "start_call_started_at_utc": {"$ref": "#/$defs/utc"},
    "start_call_returned_at_utc": {"$ref": "#/$defs/utc"},
    "start_api_result": {"enum": ["SERVICE_START_PENDING", "SERVICE_RUNNING"]},
    "exact_caller_and_operation_verified": {"const": true},
    "authority": {"$ref": "#/$defs/authority"},
    "canonicalization_profile": {"const": "windows-foundation-canonical-json-v1"},
    "signature_domain_separator": {"const": "vnpy.issue267.windows-foundation.scm-dispatch-evidence.v1"},
    "signature_algorithm": {"const": "Ed25519"},
    "signer_role": {"const": "windows-foundation-observer-evidence"},
    "signer_key_domain": {"const": "dedicated-windows-foundation-observer-evidence-v1"},
    "signer_key_id": {"type": "string", "pattern": "^windows-foundation-observer-evidence:[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "signer_public_key_sha256": {"$ref": "#/$defs/sha256"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attemptId": {"type": "string", "pattern": "^windows-fence-install-[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "serviceName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["windows_fence_released", "authority_restore_allowed", "consume_authorized", "reconciliation_authorized", "deployment_authorized", "automatic_deploy_allowed", "production_allowed", "live_trading_authorized", "send_order_authorized", "cancel_order_authorized", "countable_forward"],
      "properties": {
        "windows_fence_released": {"const": false}, "authority_restore_allowed": {"const": false},
        "consume_authorized": {"const": false}, "reconciliation_authorized": {"const": false},
        "deployment_authorized": {"const": false}, "automatic_deploy_allowed": {"const": false},
        "production_allowed": {"const": false}, "live_trading_authorized": {"const": false},
        "send_order_authorized": {"const": false}, "cancel_order_authorized": {"const": false},
        "countable_forward": {"const": false}
      }
    }
  }
}
