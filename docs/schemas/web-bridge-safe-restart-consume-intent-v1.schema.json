{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:web-bridge-safe-restart-consume-intent-v1",
  "title": "Web Bridge safe restart consume WAL intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "consume_intent_id", "consume_intent_core_sha256",
    "receipt_id", "receipt_raw_sha256", "receipt_core_sha256",
    "online_recheck_id", "online_recheck_raw_sha256", "online_recheck_core_sha256",
    "preconsume_state_commitment_id", "preconsume_state_commitment_raw_sha256", "preconsume_state_generation",
    "consume_state_projection", "consume_state_projection_sha256", "request_id", "runtime_instance_id", "deployment_attempt_id",
    "release_plan_core_sha256", "restart_action_sha256", "drain_epoch", "execution_epoch",
    "prepared_at", "consume_not_after", "consumer_run_id", "operator", "consume_intent_prepared",
    "one_shot_consume_committed", "consume_authorized", "reconciliation_authorized",
    "deployment_authorized", "automatic_deploy_allowed", "production_allowed",
    "live_trading_authorized", "countable_forward"
  ],
  "properties": {
    "schema_version": {"const": "web_bridge_safe_restart_consume_intent_v1"},
    "purpose": {"const": "prepare_one_shot_safe_restart_consumption"},
    "consume_intent_id": {"$ref": "#/$defs/intentId"},
    "consume_intent_core_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_id": {"$ref": "#/$defs/receiptId"},
    "receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_core_sha256": {"$ref": "#/$defs/sha256"},
    "online_recheck_id": {"$ref": "#/$defs/onlineRecheckId"},
    "online_recheck_raw_sha256": {"$ref": "#/$defs/sha256"},
    "online_recheck_core_sha256": {"$ref": "#/$defs/sha256"},
    "preconsume_state_commitment_id": {"$ref": "#/$defs/stateCommitmentId"},
    "preconsume_state_commitment_raw_sha256": {"$ref": "#/$defs/sha256"},
    "preconsume_state_generation": {"type": "integer", "minimum": 1},
    "consume_state_projection": {"$ref": "#/$defs/stateProjection"},
    "consume_state_projection_sha256": {"$ref": "#/$defs/sha256"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "runtime_instance_id": {"$ref": "#/$defs/identifier"},
    "deployment_attempt_id": {"$ref": "#/$defs/identifier"},
    "release_plan_core_sha256": {"$ref": "#/$defs/sha256"},
    "restart_action_sha256": {"$ref": "#/$defs/sha256"},
    "drain_epoch": {"type": "integer", "minimum": 1},
    "execution_epoch": {"type": "integer", "minimum": 1},
    "prepared_at": {"$ref": "#/$defs/dateTime"},
    "consume_not_after": {"$ref": "#/$defs/dateTime"},
    "consumer_run_id": {"$ref": "#/$defs/identifier"},
    "operator": {"type": "string", "minLength": 1, "maxLength": 128},
    "consume_intent_prepared": {"const": true},
    "one_shot_consume_committed": {"const": false},
    "consume_authorized": {"const": false},
    "reconciliation_authorized": {"const": false},
    "deployment_authorized": {"const": false},
    "automatic_deploy_allowed": {"const": false},
    "production_allowed": {"const": false},
    "live_trading_authorized": {"const": false},
    "countable_forward": {"const": false}
  },
  "$defs": {
    "stateProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "state", "receipt_consumed", "receipt_id", "receipt_raw_sha256", "online_recheck_id", "online_recheck_raw_sha256", "preconsume_state_commitment_raw_sha256", "preconsume_state_generation", "runtime_instance_id", "drain_epoch", "execution_epoch", "consumer_run_id", "operator", "planned_consumed_at", "consume_authorized", "reconciliation_authorized", "deployment_authorized", "automatic_deploy_allowed", "production_allowed", "live_trading_authorized", "countable_forward"],
      "properties": {
        "schema_version": {"const": "web_bridge_safe_restart_consume_state_projection_v1"},
        "state": {"const": "SAFE_TO_RESTART"},
        "receipt_consumed": {"const": true},
        "receipt_id": {"$ref": "#/$defs/receiptId"},
        "receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
        "online_recheck_id": {"$ref": "#/$defs/onlineRecheckId"},
        "online_recheck_raw_sha256": {"$ref": "#/$defs/sha256"},
        "preconsume_state_commitment_raw_sha256": {"$ref": "#/$defs/sha256"},
        "preconsume_state_generation": {"type": "integer", "minimum": 1},
        "runtime_instance_id": {"$ref": "#/$defs/identifier"},
        "drain_epoch": {"type": "integer", "minimum": 1},
        "execution_epoch": {"type": "integer", "minimum": 1},
        "consumer_run_id": {"$ref": "#/$defs/identifier"},
        "operator": {"type": "string", "minLength": 1, "maxLength": 128},
        "planned_consumed_at": {"$ref": "#/$defs/dateTime"},
        "consume_authorized": {"const": false},
        "reconciliation_authorized": {"const": false},
        "deployment_authorized": {"const": false},
        "automatic_deploy_allowed": {"const": false},
        "production_allowed": {"const": false},
        "live_trading_authorized": {"const": false},
        "countable_forward": {"const": false}
      }
    },
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "intentId": {"type": "string", "pattern": "^safe-restart-consume-intent-(?!0{64}$)[0-9a-f]{64}$"},
    "receiptId": {"type": "string", "pattern": "^safe-restart-(?!0{64}$)[0-9a-f]{64}$"},
    "onlineRecheckId": {"type": "string", "pattern": "^safe-restart-online-recheck-(?!0{64}$)[0-9a-f]{64}$"},
    "stateCommitmentId": {"type": "string", "pattern": "^deployment-drain-state-commitment-(?!0{64}$)[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "dateTime": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
