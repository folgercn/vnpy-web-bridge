{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:web-bridge-safe-restart-reconciliation-v1",
  "title": "Web Bridge safe restart reconciliation evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "mode", "reconciliation_id", "reconciliation_core_sha256",
    "checkpoint_id", "checkpoint_raw_sha256", "checkpoint_core_sha256",
    "consume_intent_id", "consume_intent_raw_sha256", "consume_marker_id",
    "consume_marker_raw_sha256", "receipt_id", "online_recheck_id",
    "online_recheck_raw_sha256", "current_runtime_instance_id", "current_execution_epoch",
    "reconciled_at", "post_restart_reconciliation_verified",
    "windows_execution_admission_frozen", "target_runtime_verified",
    "execution_facts_reconciliation_completed", "reconciliation_completed",
    "windows_fence_released", "authority_restore_allowed", "consume_authorized", "reconciliation_authorized",
    "deployment_authorized", "automatic_deploy_allowed", "production_allowed",
    "live_trading_authorized", "countable_forward"
  ],
  "properties": {
    "schema_version": {"const": "web_bridge_safe_restart_reconciliation_v1"},
    "purpose": {"const": "record_non_authorizing_planned_restart_reconciliation_evidence"},
    "mode": {"const": "PLANNED_RESTART"},
    "reconciliation_id": {"type": "string", "pattern": "^safe-restart-reconciliation-(?!0{64}$)[0-9a-f]{64}$"},
    "reconciliation_core_sha256": {"$ref": "#/$defs/sha256"},
    "checkpoint_id": {"type": "string", "pattern": "^deployment-post-restart-checkpoint-(?!0{64}$)[0-9a-f]{64}$"},
    "checkpoint_raw_sha256": {"$ref": "#/$defs/sha256"},
    "checkpoint_core_sha256": {"$ref": "#/$defs/sha256"},
    "consume_intent_id": {"type": "string", "pattern": "^safe-restart-consume-intent-(?!0{64}$)[0-9a-f]{64}$"},
    "consume_intent_raw_sha256": {"$ref": "#/$defs/sha256"},
    "consume_marker_id": {"type": "string", "pattern": "^safe-restart-consume-marker-(?!0{64}$)[0-9a-f]{64}$"},
    "consume_marker_raw_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_id": {"type": "string", "pattern": "^safe-restart-(?!0{64}$)[0-9a-f]{64}$"},
    "online_recheck_id": {"type": "string", "pattern": "^safe-restart-online-recheck-(?!0{64}$)[0-9a-f]{64}$"},
    "online_recheck_raw_sha256": {"$ref": "#/$defs/sha256"},
    "current_runtime_instance_id": {"$ref": "#/$defs/identifier"},
    "current_execution_epoch": {"type": "integer", "minimum": 2},
    "reconciled_at": {"$ref": "#/$defs/dateTime"},
    "post_restart_reconciliation_verified": {"const": true},
    "windows_execution_admission_frozen": {"const": true},
    "target_runtime_verified": {"const": false},
    "execution_facts_reconciliation_completed": {"const": true},
    "reconciliation_completed": {"const": false},
    "windows_fence_released": {"const": false},
    "authority_restore_allowed": {"const": false},
    "consume_authorized": {"const": false},
    "reconciliation_authorized": {"const": false},
    "deployment_authorized": {"const": false},
    "automatic_deploy_allowed": {"const": false},
    "production_allowed": {"const": false},
    "live_trading_authorized": {"const": false},
    "countable_forward": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "dateTime": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
