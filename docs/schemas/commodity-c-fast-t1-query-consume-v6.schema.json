{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vnpy-web-bridge:schema:commodity-c-fast-t1-query-consume-v6",
  "title": "C_FAST query-v6 irreversible consume marker",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "candidate_id", "release_id", "attempt_id",
    "consumed_at", "executable_release_raw_sha256",
    "executable_release_canonical_sha256", "executable_keyring_sha256",
    "foundation_raw_sha256", "foundation_canonical_sha256",
    "readiness_v4_raw_sha256", "l3_outcome_raw_sha256",
    "query_manifest_raw_sha256", "runtime_pin_manifest_sha256",
    "dsn_file_identity_attestation_raw_sha256", "custody_identity_sha256",
    "pin_set_generation_id", "pin_set_manifest_sha256",
    "execution_adapter_sha256", "consume_precedes_final_revalidation",
    "consume_precedes_dsn_secret_read", "consume_precedes_network",
    "query_started", "dsn_secret_read", "network_attempted",
    "production_query_attempted", "consume_is_authority",
    "database_mutation_authorized", "web_bridge_rpc_authorized",
    "order_authorized", "position_mutation_authorized",
    "dispatch_authorized", "trading_authorized", "production_authorized",
    "replay_allowed"
  ],
  "properties": {
    "schema_version": {"const": "commodity_c_fast_t1_query_consume_v6"},
    "purpose": {"const": "c_fast_t1_query_v6_consume_before_network"},
    "candidate_id": {"const": "C_FAST_CROSS_SECTION_NEUTRAL"},
    "release_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/attemptId"},
    "consumed_at": {"$ref": "#/$defs/dateTime"},
    "executable_release_raw_sha256": {"$ref": "#/$defs/sha256"},
    "executable_release_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "executable_keyring_sha256": {"$ref": "#/$defs/sha256"},
    "foundation_raw_sha256": {"$ref": "#/$defs/sha256"},
    "foundation_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "readiness_v4_raw_sha256": {"$ref": "#/$defs/sha256"},
    "l3_outcome_raw_sha256": {"$ref": "#/$defs/sha256"},
    "query_manifest_raw_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_pin_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "dsn_file_identity_attestation_raw_sha256": {"$ref": "#/$defs/sha256"},
    "custody_identity_sha256": {"$ref": "#/$defs/sha256"},
    "pin_set_generation_id": {"$ref": "#/$defs/id"},
    "pin_set_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "execution_adapter_sha256": {"$ref": "#/$defs/sha256"},
    "consume_precedes_final_revalidation": {"const": true},
    "consume_precedes_dsn_secret_read": {"const": true},
    "consume_precedes_network": {"const": true},
    "query_started": {"const": false},
    "dsn_secret_read": {"const": false},
    "network_attempted": {"const": false},
    "production_query_attempted": {"const": false},
    "consume_is_authority": {"const": false},
    "database_mutation_authorized": {"const": false},
    "web_bridge_rpc_authorized": {"const": false},
    "order_authorized": {"const": false},
    "position_mutation_authorized": {"const": false},
    "dispatch_authorized": {"const": false},
    "trading_authorized": {"const": false},
    "production_authorized": {"const": false},
    "replay_allowed": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "attemptId": {"type": "string", "pattern": "^attempt-[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dateTime": {"type": "string", "format": "date-time"}
  }
}
