{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vnpy.example/schemas/windows-rpc-durable-fence-startup-receipt-v1.json",
  "title": "Observed Windows durable fence exact restart startup receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "receipt_id", "receipt_core_sha256",
    "install_attempt_id", "install_manifest_raw_sha256",
    "restart_authorization_raw_sha256",
    "service_config_transition_receipt_raw_sha256",
    "scm_dispatch_evidence_raw_sha256", "scm_audit_trace_raw_sha256",
    "restart_dispatched_event_id", "restart_dispatched_event_raw_sha256",
    "service_name", "service_control_operation_id", "restart_dispatch_nonce_sha256",
    "scm_call_started_at_utc", "scm_call_returned_at_utc", "scm_result", "trusted_clock_id",
    "observed_at_utc", "host_boot_id", "service_process_id",
    "service_process_started_at_utc", "process_start_strictly_after_scm_call_start",
    "service_image_path_canonical_sha256", "service_config_canonical_sha256",
    "service_start_type", "service_recovery_actions_disabled",
    "service_failure_actions_disabled", "automatic_policy_restore_authorized",
    "authority", "canonicalization_profile", "signature_domain_separator",
    "signature_algorithm", "signer_role", "signer_key_domain", "signer_key_id",
    "signer_public_key_sha256", "signature"
  ],
  "properties": {
    "schema_version": {"const": "windows_rpc_durable_fence_startup_receipt_v1"},
    "purpose": {"const": "prove_target_process_started_only_after_exact_reserved_scm_dispatch"},
    "receipt_id": {"type": "string", "pattern": "^windows-fence-startup-receipt-[0-9a-f]{64}$"},
    "receipt_core_sha256": {"$ref": "#/$defs/sha256"},
    "install_attempt_id": {"$ref": "#/$defs/attemptId"},
    "install_manifest_raw_sha256": {"$ref": "#/$defs/sha256"},
    "restart_authorization_raw_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_transition_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
    "scm_dispatch_evidence_raw_sha256": {"$ref": "#/$defs/sha256"},
    "scm_audit_trace_raw_sha256": {"$ref": "#/$defs/sha256"},
    "restart_dispatched_event_id": {"type": "string", "pattern": "^windows-fence-install-event-[0-9a-f]{64}$"},
    "restart_dispatched_event_raw_sha256": {"$ref": "#/$defs/sha256"},
    "service_name": {"$ref": "#/$defs/serviceName"},
    "service_control_operation_id": {"$ref": "#/$defs/identifier"},
    "restart_dispatch_nonce_sha256": {"$ref": "#/$defs/sha256"},
    "scm_call_started_at_utc": {"$ref": "#/$defs/utc"},
    "scm_call_returned_at_utc": {"$ref": "#/$defs/utc"},
    "scm_result": {"enum": ["SERVICE_START_PENDING", "SERVICE_RUNNING"]},
    "trusted_clock_id": {"$ref": "#/$defs/identifier"},
    "observed_at_utc": {"$ref": "#/$defs/utc"},
    "host_boot_id": {"$ref": "#/$defs/identifier"},
    "service_process_id": {"type": "integer", "minimum": 1},
    "service_process_started_at_utc": {"$ref": "#/$defs/utc"},
    "process_start_strictly_after_scm_call_start": {"const": true},
    "service_image_path_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "service_config_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "service_start_type": {"const": "DEMAND_START"},
    "service_recovery_actions_disabled": {"const": true},
    "service_failure_actions_disabled": {"const": true},
    "automatic_policy_restore_authorized": {"const": false},
    "authority": {"$ref": "#/$defs/authority"},
    "canonicalization_profile": {"const": "windows-foundation-canonical-json-v1"},
    "signature_domain_separator": {"const": "vnpy.issue267.windows-foundation.startup-receipt.v1"},
    "signature_algorithm": {"const": "Ed25519"},
    "signer_role": {"const": "windows-foundation-observer-evidence"},
    "signer_key_domain": {"const": "dedicated-windows-foundation-observer-evidence-v1"},
    "signer_key_id": {"type": "string", "pattern": "^windows-foundation-observer-evidence:[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "signer_public_key_sha256": {"$ref": "#/$defs/sha256"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attemptId": {"type": "string", "pattern": "^windows-fence-install-[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "serviceName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["windows_fence_released", "authority_restore_allowed", "consume_authorized", "reconciliation_authorized", "deployment_authorized", "automatic_deploy_allowed", "production_allowed", "live_trading_authorized", "send_order_authorized", "cancel_order_authorized", "countable_forward"],
      "properties": {
        "windows_fence_released": {"const": false}, "authority_restore_allowed": {"const": false},
        "consume_authorized": {"const": false}, "reconciliation_authorized": {"const": false},
        "deployment_authorized": {"const": false}, "automatic_deploy_allowed": {"const": false},
        "production_allowed": {"const": false}, "live_trading_authorized": {"const": false},
        "send_order_authorized": {"const": false}, "cancel_order_authorized": {"const": false},
        "countable_forward": {"const": false}
      }
    }
  }
}
