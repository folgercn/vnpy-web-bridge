{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bktrader.local/schemas/commodity-c-fast-execution-quality-collection-admission-trusted-keys-v1.schema.json",
  "title": "C_FAST collection-admission trusted keys v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {
      "const": "commodity_c_fast_execution_quality_collection_admission_trusted_keys_v1"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "purpose", "public_key_base64"],
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{8,128}$"
          },
          "purpose": {
            "const": "c_fast_execution_quality_collection_admission_signer"
          },
          "public_key_base64": {
            "type": "string",
            "minLength": 44,
            "maxLength": 44
          }
        }
      }
    }
  }
}
