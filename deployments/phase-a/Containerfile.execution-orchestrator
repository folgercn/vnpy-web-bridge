# Phase A Execution image.  It is the only Linux image allowed to own broker
# send/cancel; no frontend tree or signing private key enters this image.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend

WORKDIR /app

COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

COPY backend/app /app/backend/app
COPY shared /app/shared
COPY docs/schemas/web-bridge-control-execution-command-v1.schema.json /app/docs/schemas/web-bridge-control-execution-command-v1.schema.json
COPY docs/schemas/web-bridge-execution-status-v1.schema.json /app/docs/schemas/web-bridge-execution-status-v1.schema.json

RUN python -m compileall -q /app/backend/app

# Pre-create every writable mount point with the fixed runtime identity.
RUN groupadd --system --gid 65532 vnpy \
    && useradd --system --uid 65532 --gid 65532 --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin vnpy \
    && mkdir -p /var/lib/vnpy-execution/archive /var/lib/vnpy-execution/audit \
    && chown -R 65532:65532 /var/lib/vnpy-execution

EXPOSE 8090
USER 65532:65532
ENTRYPOINT ["python", "-m", "app.execution_orchestrator"]
