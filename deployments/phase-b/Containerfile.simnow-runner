# Fixed-tuple SIMNOW runner.  This intentionally packages only the runner's
# import closure; gateway/RPC transports, signing authority, and service apps
# stay outside this image.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/backend:/app/scripts
WORKDIR /app

COPY deployments/phase-b/requirements-simnow-runner.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY backend/app/__init__.py /app/backend/app/__init__.py
COPY backend/app/control_execution_client.py /app/backend/app/control_execution_client.py
COPY backend/app/control_execution_projection.py /app/backend/app/control_execution_projection.py
COPY docs/schemas/web-bridge-execution-status-v1.schema.json /app/docs/schemas/web-bridge-execution-status-v1.schema.json
COPY backend/app/schemas/__init__.py /app/backend/app/schemas/__init__.py
COPY backend/app/schemas/control_execution.py /app/backend/app/schemas/control_execution.py
COPY backend/app/execution/__init__.py /app/backend/app/execution/__init__.py
COPY backend/app/execution/errors.py /app/backend/app/execution/errors.py
COPY backend/app/execution/executable_target_adapter.py /app/backend/app/execution/executable_target_adapter.py
COPY backend/app/execution/gateway_contracts.py /app/backend/app/execution/gateway_contracts.py
COPY backend/app/execution/models.py /app/backend/app/execution/models.py
COPY backend/app/phase_c/__init__.py /app/backend/app/phase_c/__init__.py
COPY backend/app/phase_c/adapters.py /app/backend/app/phase_c/adapters.py
COPY backend/app/phase_c/client.py /app/backend/app/phase_c/client.py
COPY backend/app/phase_c/models.py /app/backend/app/phase_c/models.py
COPY scripts/simnow_keyless_pilot.py /app/scripts/simnow_keyless_pilot.py
COPY scripts/simnow_run_once.py /app/scripts/simnow_run_once.py
COPY scripts/c_fast_producer /app/scripts/c_fast_producer
COPY scripts/map /app/scripts/map
COPY scripts/commodity_c_fast_pure_producer_kernel.py /app/scripts/commodity_c_fast_pure_producer_kernel.py
COPY shared/artifact_contracts /app/shared/artifact_contracts
COPY shared/commodity_execution /app/shared/commodity_execution
COPY shared/phase_c_workflow /app/shared/phase_c_workflow
COPY shared/trust_contracts /app/shared/trust_contracts

RUN python -m py_compile /app/scripts/simnow_run_once.py /app/scripts/simnow_keyless_pilot.py

USER 65532:65532
ENTRYPOINT ["python", "/app/scripts/simnow_run_once.py"]
