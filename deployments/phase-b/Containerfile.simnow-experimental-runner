# SIMNOW_EXPERIMENTAL runner image; default invocation remains dry-run.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app:/app/backend:/app/scripts
WORKDIR /app
COPY deployments/phase-b/requirements-simnow-experimental-runner.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
# The inherited lifecycle is imported but its audited warehouse paths are not
# called by this runner.  Keep its exact Python import closure available rather
# than copying lifecycle code into a second dispatcher.
COPY backend/app /app/backend/app
COPY scripts /app/scripts
COPY shared /app/shared
RUN python -m py_compile /app/scripts/simnow_experimental_materialize_target.py /app/scripts/simnow_experimental_monthly_once.py /app/scripts/simnow_experimental_run_once.py /app/scripts/simnow_experimental_offline_harness.py
RUN groupadd --system --gid 65532 simnow && useradd --system --uid 65532 --gid 65532 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin simnow
USER 65532:65532
ENTRYPOINT ["python", "/app/scripts/simnow_experimental_run_once.py"]
