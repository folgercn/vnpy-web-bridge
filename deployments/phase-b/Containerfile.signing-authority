# Phase B offline signing authority.  No public endpoint and no key is copied
# into the image; the ceremony supplies an explicit ephemeral read-only FD.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
WORKDIR /app
COPY deployments/phase-b/requirements-artifact.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY shared/artifact_contracts /app/shared/artifact_contracts
COPY shared/trust_contracts /app/shared/trust_contracts
COPY scripts/phase_b_offline_signer.py /app/scripts/phase_b_offline_signer.py
RUN groupadd --system --gid 65532 signer \
    && useradd --system --uid 65532 --gid 65532 --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin signer \
    && mkdir -p /out \
    && chown 65532:65532 /out
RUN python -m compileall -q /app/shared /app/scripts/phase_b_offline_signer.py
USER 65532:65532
ENTRYPOINT ["python", "/app/scripts/phase_b_offline_signer.py"]
