# Phase B C_FAST batch image.  It contains only the C_FAST boundary, the
# frozen pure kernel, the MAP source identity used for predecessor checking,
# and the immutable JSON contracts.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/vendor
WORKDIR /app

COPY backend/requirements.phase-b-verifier.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY scripts/c_fast_producer /app/c_fast_producer
COPY scripts/commodity_c_fast_pure_producer_kernel.py /app/vendor/commodity_c_fast_pure_producer_kernel.py
COPY scripts/map/producer.py /app/contracts/map-producer.py
COPY shared/artifact_contracts /app/shared/artifact_contracts
COPY shared/trust_contracts /app/shared/trust_contracts
COPY shared/artifact-contracts/c-fast /app/contracts/c-fast

RUN python -m py_compile \
      /app/c_fast_producer/__init__.py \
      /app/c_fast_producer/producer.py \
      /app/vendor/commodity_c_fast_pure_producer_kernel.py

USER 65532:65532
ENTRYPOINT ["python", "-m", "c_fast_producer.producer"]
CMD ["ready"]
