# Phase B execution-quality worker.  It consumes only the durable verified
# stream and writes append-only evidence; no application services are copied.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app
RUN mkdir -p /app/phase_b_workers/schemas
COPY scripts/phase_b_workers/__init__.py /app/phase_b_workers/__init__.py
COPY scripts/phase_b_workers/contracts.py /app/phase_b_workers/contracts.py
COPY scripts/phase_b_workers/durable.py /app/phase_b_workers/durable.py
COPY scripts/phase_b_workers/execution_quality_worker.py /app/phase_b_workers/execution_quality_worker.py
COPY scripts/phase_b_workers/schemas/verified-tick-v1.schema.json /app/phase_b_workers/schemas/verified-tick-v1.schema.json
COPY scripts/phase_b_workers/schemas/execution-quality-evidence-v1.schema.json /app/phase_b_workers/schemas/execution-quality-evidence-v1.schema.json
COPY scripts/phase_b_workers/schemas/worker-health-v1.schema.json /app/phase_b_workers/schemas/worker-health-v1.schema.json
COPY scripts/phase_b_workers/schemas/worker-readiness-v1.schema.json /app/phase_b_workers/schemas/worker-readiness-v1.schema.json
COPY scripts/phase_b_workers/schemas/worker-metrics-v1.schema.json /app/phase_b_workers/schemas/worker-metrics-v1.schema.json

RUN python -m compileall -q /app/phase_b_workers \
    && groupadd --system --gid 65532 phaseb \
    && useradd --system --uid 65532 --gid 65532 --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin phaseb \
    && mkdir -p /var/lib/phase-b/execution-quality \
    && chown -R 65532:65532 /var/lib/phase-b

USER 65532:65532
ENTRYPOINT ["python", "-m", "phase_b_workers.execution_quality_worker"]
CMD ["--health"]
