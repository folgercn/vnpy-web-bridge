FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
WORKDIR /app
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY backend/app /app/app
COPY shared /app/shared
RUN useradd --system --uid 65532 --no-create-home execution && mkdir /var/lib/phase-c-execution && chown execution /var/lib/phase-c-execution && chmod 0700 /var/lib/phase-c-execution
USER 65532
CMD ["python", "-m", "uvicorn", "app.phase_c_execution:app", "--host", "0.0.0.0", "--port", "8092"]
