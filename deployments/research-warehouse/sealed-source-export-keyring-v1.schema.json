{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keyring_id", "purpose", "keys"],
  "properties": {
    "schema_version": {"const": "vnpy_research_sealed_source_export_keyring_v1"},
    "keyring_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$"},
    "purpose": {"const": "research_sealed_source_export_signer"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "algorithm",
          "public_key_base64",
          "public_key_sha256",
          "enabled"
        ],
        "properties": {
          "key_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$"},
          "algorithm": {"const": "Ed25519"},
          "public_key_base64": {"type": "string", "minLength": 40},
          "public_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}
