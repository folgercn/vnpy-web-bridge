<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.vnpy.research-warehouse-monitor</string>
  <key>UserName</key><string>vnpyresearch</string>
  <key>GroupName</key><string>vnpyresearch</string>
  <key>ProgramArguments</key>
  <array><string>/Users/Shared/vnpy-research/runtime/run-monitor</string></array>
  <key>WorkingDirectory</key><string>/Users/Shared/vnpy-research/runtime</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/Shared/vnpy-research/home</string>
    <key>LANG</key><string>C.UTF-8</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONNOUSERSITE</key><string>1</string>
    <key>TMPDIR</key><string>/Users/Shared/vnpy-research/runtime/tmp</string>
  </dict>
  <key>Umask</key><integer>63</integer>
  <key>StartInterval</key><integer>900</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/Shared/vnpy-research/runtime/log/monitor.stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/Shared/vnpy-research/runtime/log/monitor.stderr.log</string>
</dict>
</plist>
