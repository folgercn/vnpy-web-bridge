<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.vnpy.research-warehouse-rebuild</string>
  <key>UserName</key><string>vnpyresearch</string>
  <key>GroupName</key><string>vnpyresearch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/vnpyresearch/release-lock-runner</string>
    <string>rebuild</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/Shared/vnpy-research/runtime</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/Shared/vnpy-research/home</string>
    <key>LANG</key><string>C.UTF-8</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONNOUSERSITE</key><string>1</string>
    <key>TMPDIR</key><string>/Users/Shared/vnpy-research/runtime/tmp</string>
  </dict>
  <key>Umask</key><integer>63</integer>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>50</integer></dict>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/Shared/vnpy-research/runtime/log/rebuild.stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/Shared/vnpy-research/runtime/log/rebuild.stderr.log</string>
</dict>
</plist>
