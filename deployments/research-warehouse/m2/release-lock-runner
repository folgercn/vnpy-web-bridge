#!/usr/bin/python3
import fcntl
import os
import stat
import sys

LOCK = "/usr/local/libexec/vnpyresearch/release.lock"
PROGRAMS = {
    "backup-signer": "/usr/local/libexec/vnpyresearch/release/bin/research-warehouse-backup-signer",
    "manifest-signer": "/usr/local/libexec/vnpyresearch/release/bin/research-warehouse-manifest-signer",
    "operator-state": "/usr/local/libexec/vnpyresearch/release/bin/research-warehouse-operator-state",
    "rebuild": "/usr/local/libexec/vnpyresearch/release/bin/research-warehouse-rebuild",
    "warehouse": "/usr/local/libexec/vnpyresearch/release/bin/research-warehouse-job",
    "monitor": "/usr/local/libexec/vnpyresearch/release/bin/research-warehouse-monitor",
}

if len(sys.argv) != 2 or sys.argv[1] not in PROGRAMS:
    raise SystemExit(64)
flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
path_facts = os.stat(LOCK, follow_symlinks=False)
descriptor = os.open(LOCK, flags)
facts = os.fstat(descriptor)
if (
    stat.S_ISLNK(path_facts.st_mode)
    or (path_facts.st_dev, path_facts.st_ino) != (facts.st_dev, facts.st_ino)
    or not stat.S_ISREG(facts.st_mode)
    or facts.st_uid != 0
    or facts.st_gid != 0
    or stat.S_IMODE(facts.st_mode) != 0o444
    or facts.st_nlink != 1
):
    raise SystemExit(78)
fcntl.flock(descriptor, fcntl.LOCK_SH)
os.set_inheritable(descriptor, True)
program = PROGRAMS[sys.argv[1]]
os.execv(program, [program])
