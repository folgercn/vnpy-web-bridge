{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/folgercn/vnpy-web-bridge/research-normalization-contract-v1.schema.json",
  "title": "Research Warehouse normalization contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "normalizer_version",
    "normalized_schema_version",
    "columns",
    "sort_keys",
    "parquet"
  ],
  "properties": {
    "schema_version": {
      "const": "vnpy_research_normalization_contract_v1"
    },
    "normalizer_version": {
      "const": "vnpy-research-normalizer-v1"
    },
    "normalized_schema_version": {
      "const": "vnpy_research_daily_rows_v1"
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "type": {"type": "string", "minLength": 1}
        }
      }
    },
    "sort_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "parquet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compression",
        "compression_level",
        "dictionary_page_size",
        "duckdb_version",
        "parquet_version",
        "row_group_size",
        "schema_sha256",
        "sort_sha256",
        "timezone"
      ],
      "properties": {
        "compression": {"const": "zstd"},
        "compression_level": {"const": 3},
        "dictionary_page_size": {"const": 1000000},
        "duckdb_version": {"const": "1.5.5"},
        "parquet_version": {"const": "V2"},
        "row_group_size": {"const": 122880},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sort_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "timezone": {"const": "UTC"}
      }
    }
  }
}
