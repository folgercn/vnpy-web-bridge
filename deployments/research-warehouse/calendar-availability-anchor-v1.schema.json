{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/folgercn/vnpy-web-bridge/calendar-availability-anchor-v1.schema.json",
  "title": "Research Warehouse external calendar availability anchor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "calendar_raw_sha256",
    "source_evidence_sha256",
    "available_at"
  ],
  "properties": {
    "schema_version": {
      "const": "vnpy_research_calendar_availability_anchor_v1"
    },
    "calendar_raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_evidence_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["INE", "SHFE"],
      "properties": {
        "INE": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "SHFE": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "available_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
