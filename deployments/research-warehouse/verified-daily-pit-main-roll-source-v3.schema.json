{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/folgercn/vnpy-web-bridge/deployments/research-warehouse/verified-daily-pit-main-roll-source-v3.schema.json",
  "title": "Verified no-authority daily PIT-main roll source v3",
  "description": "Verified-at-construction Warehouse source evidence. Genesis uses a signed delayed monthly STATIC_CORE_EQUAL baseline; linked continuity uses only the fixed root-managed immutable predecessor catalog. Roll changes are detection facts only; this artifact is never installable, event-ready, dispatch-authorized, order-authorized, production/live authority, or official/countable forward evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "source_kind",
    "derivation_id",
    "official_day",
    "execution_day",
    "following_official_day",
    "roll_change_detected",
    "changed_products",
    "input_lineage_status",
    "installable",
    "event_ready",
    "execution_lane",
    "production_allowed",
    "live_trading_authorized",
    "countable_forward",
    "official_forward_claimed",
    "dispatch_authorized",
    "order_authorized",
    "mains",
    "verified_lineage",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "vnpy_research_commodity_verified_daily_pit_main_roll_source_v3"},
    "artifact_id": {"type": "string", "pattern": "^verified-daily-roll-[0-9a-f]{64}$"},
    "source_kind": {"const": "DAILY_PIT_MAIN_ROLL_ONLY"},
    "derivation_id": {"const": "VERIFIED_FROZEN_OI_DESC_DELIVERY_ASC_EXACT_ASC_ROLL_SOURCE_V3"},
    "official_day": {"$ref": "#/$defs/day"},
    "execution_day": {"$ref": "#/$defs/day"},
    "following_official_day": {"$ref": "#/$defs/day"},
    "roll_change_detected": {"type": "boolean"},
    "changed_products": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/product"}
    },
    "input_lineage_status": {"const": "VERIFIED_AT_CONSTRUCTION_V3"},
    "installable": {"const": false},
    "event_ready": {"const": false},
    "execution_lane": {"const": "simnow_shakedown"},
    "production_allowed": {"const": false},
    "live_trading_authorized": {"const": false},
    "countable_forward": {"const": false},
    "official_forward_claimed": {"const": false},
    "dispatch_authorized": {"const": false},
    "order_authorized": {"const": false},
    "mains": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/main"}
    },
    "verified_lineage": {"$ref": "#/$defs/verifiedLineage"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "day": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{6})?Z$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$"},
    "product": {"enum": ["ag", "al", "au", "bu", "cu", "rb", "ru", "sc", "sp", "zn"]},
    "exchange": {"enum": ["SHFE", "INE"]},
    "exactContract": {"type": "string", "pattern": "^(SHFE|INE)\\.[a-z]{2}[0-9]{4}$"},
    "main": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product", "exchange", "previous_exact_contract", "exact_contract",
        "changed", "delivery_yyyymm", "settlement", "open_interest",
        "eligible_contract_count", "ranked_contracts_sha256",
        "official_last_trading_day", "execution_day_dte",
        "following_official_day_dte"
      ],
      "properties": {
        "product": {"$ref": "#/$defs/product"},
        "exchange": {"$ref": "#/$defs/exchange"},
        "previous_exact_contract": {"$ref": "#/$defs/exactContract"},
        "exact_contract": {"$ref": "#/$defs/exactContract"},
        "changed": {"type": "boolean"},
        "delivery_yyyymm": {"type": "integer", "minimum": 200001, "maximum": 209912},
        "settlement": {"type": "number", "exclusiveMinimum": 0},
        "open_interest": {"type": "number", "exclusiveMinimum": 0},
        "eligible_contract_count": {"type": "integer", "minimum": 3, "maximum": 64},
        "ranked_contracts_sha256": {"$ref": "#/$defs/sha256"},
        "official_last_trading_day": {"$ref": "#/$defs/day"},
        "execution_day_dte": {"type": "integer", "minimum": 11},
        "following_official_day_dte": {"type": "integer", "minimum": 11}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "exchange", "object_id", "observation_id", "revision_id",
        "raw_sha256", "raw_bytes", "raw_relative_path"
      ],
      "properties": {
        "source_id": {"enum": ["shfe-daily-market-data-v1", "ine-daily-market-data-v1"]},
        "exchange": {"$ref": "#/$defs/exchange"},
        "object_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "observation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "revision_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "raw_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "raw_relative_path": {"type": "string", "pattern": "^raw/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$", "maxLength": 1024}
      }
    },
    "verifiedLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime", "calendar", "operator_state", "run_receipt", "manifest",
        "sources", "contract_registry", "continuity", "producer", "shfe_contract_parameters"
      ],
      "properties": {
        "runtime": {
          "type": "object", "additionalProperties": false,
          "required": ["runtime_input_raw_sha256", "isolation_policy_raw_sha256", "warehouse_registry_raw_sha256"],
          "properties": {
            "runtime_input_raw_sha256": {"$ref": "#/$defs/sha256"},
            "isolation_policy_raw_sha256": {"$ref": "#/$defs/sha256"},
            "warehouse_registry_raw_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "calendar": {
          "type": "object", "additionalProperties": false,
          "required": ["calendar_id", "calendar_raw_sha256", "calendar_availability_anchor_raw_sha256", "calendar_available_at"],
          "properties": {
            "calendar_id": {"$ref": "#/$defs/id"},
            "calendar_raw_sha256": {"$ref": "#/$defs/sha256"},
            "calendar_availability_anchor_raw_sha256": {"$ref": "#/$defs/sha256"},
            "calendar_available_at": {"$ref": "#/$defs/utc"}
          }
        },
        "operator_state": {
          "type": "object", "additionalProperties": false,
          "required": ["raw_sha256", "manifest_sequence", "manifest_genesis_seal_sha256", "manifest_head_seal_sha256", "manifest_head_commit_seal_sha256", "commit_anchor_ledger_raw_sha256"],
          "properties": {
            "raw_sha256": {"$ref": "#/$defs/sha256"},
            "manifest_sequence": {"type": "integer", "minimum": 1},
            "manifest_genesis_seal_sha256": {"$ref": "#/$defs/sha256"},
            "manifest_head_seal_sha256": {"$ref": "#/$defs/sha256"},
            "manifest_head_commit_seal_sha256": {"$ref": "#/$defs/sha256"},
            "commit_anchor_ledger_raw_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "run_receipt": {
          "type": "object", "additionalProperties": false,
          "required": ["receipt_id", "completed_at", "raw_sha256", "raw_bytes"],
          "properties": {
            "receipt_id": {"type": "string", "pattern": "^run-[0-9a-f]{64}$"},
            "completed_at": {"$ref": "#/$defs/utc"},
            "raw_sha256": {"$ref": "#/$defs/sha256"},
            "raw_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
          }
        },
        "manifest": {
          "type": "object", "additionalProperties": false,
          "required": ["trade_day", "batch_id", "batch_seal_sha256", "commit_seal_sha256", "manifest_raw_sha256", "commit_receipt_raw_sha256", "parent_batch_seal_sha256", "parent_commit_seal_sha256"],
          "properties": {
            "trade_day": {"$ref": "#/$defs/day"},
            "batch_id": {"$ref": "#/$defs/id"},
            "batch_seal_sha256": {"$ref": "#/$defs/sha256"},
            "commit_seal_sha256": {"$ref": "#/$defs/sha256"},
            "manifest_raw_sha256": {"$ref": "#/$defs/sha256"},
            "commit_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
            "parent_batch_seal_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
            "parent_commit_seal_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
          }
        },
        "sources": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/source"}},
        "contract_registry": {
          "type": "object", "additionalProperties": false,
          "required": ["raw_sha256", "raw_bytes", "expected_raw_sha256"],
          "properties": {
            "raw_sha256": {"$ref": "#/$defs/sha256"},
            "raw_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
            "expected_raw_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "continuity": {
          "oneOf": [
            {"$ref": "#/$defs/genesisContinuity"},
            {"$ref": "#/$defs/linkedContinuity"}
          ]
        },
        "producer": {
          "type": "object", "additionalProperties": false,
          "required": ["producer_kernel_id", "frozen_rule_id", "frozen_rule_sha256"],
          "properties": {
            "producer_kernel_id": {"const": "commodity_c_fast_pure_producer_kernel_v1"},
            "frozen_rule_id": {"const": "commodity_fast_tsmom_forward_freeze_v1"},
            "frozen_rule_sha256": {"const": "d9a6ef4ffb6d74fe0feee8ac8935acbeb79abd4686581611f14135eb5c41040a"}
          }
        },
        "shfe_contract_parameters": {
          "type": "array", "minItems": 0, "maxItems": 9,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["source_id", "endpoint", "query_day", "observed_at", "raw_sha256", "raw_bytes", "exact_contract", "instrument_id", "expire_date"],
            "properties": {
              "source_id": {"const": "shfe-contract-parameters-v1"},
              "endpoint": {"type": "string", "pattern": "^https://www\\.shfe\\.com\\.cn/data/busiparamdata/future/ContractBaseInfo[0-9]{8}\\.dat$"},
              "query_day": {"$ref": "#/$defs/day"},
              "observed_at": {"$ref": "#/$defs/utc"},
              "raw_sha256": {"$ref": "#/$defs/sha256"},
              "raw_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
              "exact_contract": {"type": "string", "pattern": "^SHFE\\.[a-z]{2}[0-9]{4}$"},
              "instrument_id": {"type": "string", "pattern": "^[a-z]{2}[0-9]{4}$"},
              "expire_date": {"$ref": "#/$defs/day"}
            }
          }
        }
      }
    },
    "genesisContinuity": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "baseline_batch_id", "baseline_batch_raw_sha256", "baseline_batch_raw_bytes", "baseline_unsigned_sha256", "baseline_source_view_raw_sha256", "baseline_unsigned_batch_raw_sha256", "baseline_replay_evidence_raw_sha256", "baseline_source_month", "baseline_execution_day", "baseline_signer_key_id", "baseline_public_key_sha256", "predecessor_exact_contract_map_sha256"],
      "properties": {
        "mode": {"const": "GENESIS_STATIC_CORE_EQUAL"},
        "baseline_batch_id": {"$ref": "#/$defs/id"},
        "baseline_batch_raw_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_batch_raw_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "baseline_unsigned_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_source_view_raw_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_unsigned_batch_raw_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_replay_evidence_raw_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_source_month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
        "baseline_execution_day": {"$ref": "#/$defs/day"},
        "baseline_signer_key_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "baseline_public_key_sha256": {"$ref": "#/$defs/sha256"},
        "predecessor_exact_contract_map_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "linkedContinuity": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "catalog_receipt_id", "catalog_receipt_raw_sha256", "catalog_sequence", "predecessor_artifact_id", "predecessor_artifact_raw_sha256", "predecessor_artifact_raw_bytes", "predecessor_official_day", "predecessor_execution_day", "predecessor_exact_contract_map_sha256"],
      "properties": {
        "mode": {"const": "LINKED_ROOT_CATALOG"},
        "catalog_receipt_id": {"type": "string", "pattern": "^daily-roll-catalog-receipt-[0-9a-f]{64}$"},
        "catalog_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_sequence": {"type": "integer", "minimum": 1},
        "predecessor_artifact_id": {"type": "string", "pattern": "^verified-daily-roll-[0-9a-f]{64}$"},
        "predecessor_artifact_raw_sha256": {"$ref": "#/$defs/sha256"},
        "predecessor_artifact_raw_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "predecessor_official_day": {"$ref": "#/$defs/day"},
        "predecessor_execution_day": {"$ref": "#/$defs/day"},
        "predecessor_exact_contract_map_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["account_data_read", "control_authorized", "deployment_authorized", "execution_authorized", "network_beyond_allowlist_authorized", "order_authorized", "permit_authorized", "position_mutation_authorized", "production_authorized", "rpc_authorized", "trading_authorized"],
      "properties": {
        "account_data_read": {"const": false},
        "control_authorized": {"const": false},
        "deployment_authorized": {"const": false},
        "execution_authorized": {"const": false},
        "network_beyond_allowlist_authorized": {"const": false},
        "order_authorized": {"const": false},
        "permit_authorized": {"const": false},
        "position_mutation_authorized": {"const": false},
        "production_authorized": {"const": false},
        "rpc_authorized": {"const": false},
        "trading_authorized": {"const": false}
      }
    }
  }
}
