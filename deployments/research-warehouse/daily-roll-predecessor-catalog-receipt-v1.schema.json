{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/folgercn/vnpy-web-bridge/deployments/research-warehouse/daily-roll-predecessor-catalog-receipt-v1.schema.json",
  "title": "Root-managed daily roll predecessor catalog receipt v1",
  "description": "Immutable no-authority receipt for one verified daily PIT-main artifact in the Warehouse predecessor catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "sequence",
    "official_day",
    "artifact_id",
    "artifact_raw_sha256",
    "artifact_raw_bytes",
    "artifact_relative_path",
    "previous_receipt_raw_sha256",
    "previous_artifact_id",
    "operator_state_raw_sha256",
    "operator_manifest_sequence",
    "manifest_head_seal_sha256",
    "manifest_head_commit_seal_sha256",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "vnpy_research_daily_roll_predecessor_catalog_receipt_v1"},
    "receipt_id": {"type": "string", "pattern": "^daily-roll-catalog-receipt-[0-9a-f]{64}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "official_day": {"$ref": "#/$defs/day"},
    "artifact_id": {"$ref": "#/$defs/artifactId"},
    "artifact_raw_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_raw_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
    "artifact_relative_path": {"type": "string", "pattern": "^artifacts/verified-daily-roll-[0-9a-f]{64}\\.json$"},
    "previous_receipt_raw_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "previous_artifact_id": {
      "anyOf": [{"$ref": "#/$defs/artifactId"}, {"type": "null"}]
    },
    "operator_state_raw_sha256": {"$ref": "#/$defs/sha256"},
    "operator_manifest_sequence": {"type": "integer", "minimum": 1},
    "manifest_head_seal_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_head_commit_seal_sha256": {"$ref": "#/$defs/sha256"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"sequence": {"const": 1}},
        "required": ["sequence"]
      },
      "then": {
        "properties": {
          "previous_receipt_raw_sha256": {"type": "null"},
          "previous_artifact_id": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "previous_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
          "previous_artifact_id": {"$ref": "#/$defs/artifactId"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "day": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "artifactId": {"type": "string", "pattern": "^verified-daily-roll-[0-9a-f]{64}$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_data_read",
        "control_authorized",
        "deployment_authorized",
        "execution_authorized",
        "network_beyond_allowlist_authorized",
        "order_authorized",
        "permit_authorized",
        "position_mutation_authorized",
        "production_authorized",
        "rpc_authorized",
        "trading_authorized"
      ],
      "properties": {
        "account_data_read": {"const": false},
        "control_authorized": {"const": false},
        "deployment_authorized": {"const": false},
        "execution_authorized": {"const": false},
        "network_beyond_allowlist_authorized": {"const": false},
        "order_authorized": {"const": false},
        "permit_authorized": {"const": false},
        "position_mutation_authorized": {"const": false},
        "production_authorized": {"const": false},
        "rpc_authorized": {"const": false},
        "trading_authorized": {"const": false}
      }
    }
  }
}
