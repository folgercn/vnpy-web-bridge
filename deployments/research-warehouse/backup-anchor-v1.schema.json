{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vnpy.example/schemas/research-warehouse-backup-anchor-v1.json",
  "title": "Research Warehouse append-only backup anchor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "anchor_id",
    "purpose",
    "sequence",
    "created_at",
    "parent_anchor_raw_sha256",
    "source_custody_identity",
    "backup_custody_identity",
    "snapshot",
    "rebuild",
    "authority",
    "signer_key_id",
    "signer_public_key_sha256",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "vnpy_research_backup_anchor_v1"},
    "anchor_id": {"type": "string", "pattern": "^backup-[0-9a-f]{64}$"},
    "purpose": {"const": "RESEARCH_EVIDENCE_APPEND_ONLY_BACKUP"},
    "sequence": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "parent_anchor_raw_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "source_custody_identity": {"$ref": "#/$defs/sha256"},
    "backup_custody_identity": {"$ref": "#/$defs/sha256"},
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "rebuild": {"$ref": "#/$defs/rebuild"},
    "authority": {"$ref": "#/$defs/authority"},
    "signer_key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "signer_public_key_sha256": {"$ref": "#/$defs/sha256"},
    "signature": {"type": "string", "minLength": 88, "maxLength": 88}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_authorized",
        "deployment_authorized",
        "execution_authorized",
        "network_authorized",
        "rpc_authorized",
        "order_authorized",
        "position_mutation_authorized",
        "dispatch_authorized",
        "trading_authorized",
        "production_authorized"
      ],
      "properties": {
        "control_authorized": {"const": false},
        "deployment_authorized": {"const": false},
        "execution_authorized": {"const": false},
        "network_authorized": {"const": false},
        "rpc_authorized": {"const": false},
        "order_authorized": {"const": false},
        "position_mutation_authorized": {"const": false},
        "dispatch_authorized": {"const": false},
        "trading_authorized": {"const": false},
        "production_authorized": {"const": false}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "kind", "bytes", "raw_sha256"],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^(raw|manifests)/[A-Za-z0-9._/-]{1,900}$"
        },
        "kind": {"enum": ["raw", "manifest"]},
        "bytes": {"type": "integer", "minimum": 1},
        "raw_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_sha256",
        "object_count",
        "total_bytes",
        "raw_object_count",
        "manifest_object_count",
        "objects"
      ],
      "properties": {
        "root_sha256": {"$ref": "#/$defs/sha256"},
        "object_count": {"type": "integer", "minimum": 2},
        "total_bytes": {"type": "integer", "minimum": 2},
        "raw_object_count": {"type": "integer", "minimum": 1},
        "manifest_object_count": {"type": "integer", "minimum": 1},
        "objects": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/inventory"}
        }
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "raw_sha256"],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^parquet/[A-Za-z0-9._/-]+\\.parquet$"
        },
        "raw_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rebuild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_raw_sha256",
        "commit_anchor_ledger_sha256",
        "genesis_batch_seal_sha256",
        "head_batch_seal_sha256",
        "head_commit_seal_sha256",
        "tool_commit_sha",
        "dependency_lock_sha256",
        "catalog_logical_sha256",
        "partition_hashes"
      ],
      "properties": {
        "registry_raw_sha256": {"$ref": "#/$defs/sha256"},
        "commit_anchor_ledger_sha256": {"$ref": "#/$defs/sha256"},
        "genesis_batch_seal_sha256": {"$ref": "#/$defs/sha256"},
        "head_batch_seal_sha256": {"$ref": "#/$defs/sha256"},
        "head_commit_seal_sha256": {"$ref": "#/$defs/sha256"},
        "tool_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_logical_sha256": {"$ref": "#/$defs/sha256"},
        "partition_hashes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/partition"}
        }
      }
    }
  }
}
