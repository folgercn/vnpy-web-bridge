{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/folgercn/vnpy-web-bridge/deployments/research-warehouse/relative-vol-pit-source-receipt-v1.schema.json",
  "title": "Research Warehouse relative-vol sealed PIT source receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "source_view_id",
    "source_view_filename",
    "source_view_raw_sha256",
    "source_view_raw_bytes",
    "source_month",
    "research_as_of_official_day",
    "execution_day",
    "derivation_id",
    "pins",
    "daily_receipts",
    "used_daily_sources",
    "producer_replay",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "vnpy_research_commodity_relative_vol_pit_source_receipt_v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^pit-receipt-[0-9a-f]{64}$"
    },
    "source_view_id": {
      "$ref": "#/$defs/id"
    },
    "source_view_filename": {
      "const": "source-view.json"
    },
    "source_view_raw_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_view_raw_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4194304
    },
    "source_month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "research_as_of_official_day": {
      "type": "string",
      "format": "date"
    },
    "execution_day": {
      "type": "string",
      "format": "date"
    },
    "derivation_id": {
      "const": "SIGNED_BASELINE_BUFFERED_WEIGHTED_ROLL_SAFE_LOG_RETURN_V1"
    },
    "pins": {
      "$ref": "#/$defs/pins"
    },
    "daily_receipts": {
      "type": "array",
      "minItems": 186,
      "maxItems": 186,
      "items": {
        "$ref": "#/$defs/dailyReceipt"
      }
    },
    "used_daily_sources": {
      "type": "array",
      "minItems": 127,
      "maxItems": 127,
      "items": {
        "$ref": "#/$defs/usedDailySource"
      }
    },
    "producer_replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "snapshot_draft_raw_sha256",
        "producer_evidence_raw_sha256"
      ],
      "properties": {
        "status": {
          "const": "EXACT_SOURCE_VIEW_REPLAY_VERIFIED"
        },
        "snapshot_draft_raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "producer_evidence_raw_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authority": {
      "$ref": "#/$defs/authority"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{8,128}$"
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_receipt_raw_sha256",
        "calendar_raw_sha256",
        "calendar_anchor_raw_sha256",
        "registry_raw_sha256",
        "operator_state_raw_sha256",
        "manifest_genesis_seal_sha256",
        "manifest_head_seal_sha256",
        "manifest_head_commit_seal_sha256",
        "commit_anchor_ledger_raw_sha256",
        "baseline_batch_hash",
        "source_month",
        "derivation_id"
      ],
      "properties": {
        "history_receipt_raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "calendar_raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "calendar_anchor_raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "registry_raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "operator_state_raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_genesis_seal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_head_seal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_head_commit_seal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "commit_anchor_ledger_raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "baseline_batch_hash": {
          "$ref": "#/$defs/sha256"
        },
        "source_month": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "derivation_id": {
          "const": "SIGNED_BASELINE_BUFFERED_WEIGHTED_ROLL_SAFE_LOG_RETURN_V1"
        }
      }
    },
    "dailyReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trade_day",
        "run_receipt_relative_path",
        "run_receipt_raw_sha256",
        "source_raw_sha256",
        "source_raw_bytes"
      ],
      "properties": {
        "trade_day": {
          "type": "string",
          "format": "date"
        },
        "run_receipt_relative_path": {
          "type": "string",
          "pattern": "^history-run-receipts/[0-9]{4}-[0-9]{2}-[0-9]{2}\\.json$"
        },
        "run_receipt_raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_raw_sha256": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "source_raw_bytes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "usedDailySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_day",
        "sources"
      ],
      "properties": {
        "official_day": {
          "type": "string",
          "format": "date"
        },
        "sources": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/shfeSource"
            },
            {
              "$ref": "#/$defs/ineSource"
            }
          ],
          "items": false
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exchange",
        "raw_sha256",
        "raw_bytes"
      ],
      "properties": {
        "exchange": {
          "enum": [
            "SHFE",
            "INE"
          ]
        },
        "raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "raw_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "shfeSource": {
      "allOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "properties": {
            "exchange": {
              "const": "SHFE"
            }
          }
        }
      ]
    },
    "ineSource": {
      "allOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "properties": {
            "exchange": {
              "const": "INE"
            }
          }
        }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_data_read",
        "control_authorized",
        "deployment_authorized",
        "execution_authorized",
        "network_beyond_allowlist_authorized",
        "order_authorized",
        "permit_authorized",
        "position_mutation_authorized",
        "production_authorized",
        "rpc_authorized",
        "trading_authorized"
      ],
      "properties": {
        "account_data_read": {
          "const": false
        },
        "control_authorized": {
          "const": false
        },
        "deployment_authorized": {
          "const": false
        },
        "execution_authorized": {
          "const": false
        },
        "network_beyond_allowlist_authorized": {
          "const": false
        },
        "order_authorized": {
          "const": false
        },
        "permit_authorized": {
          "const": false
        },
        "position_mutation_authorized": {
          "const": false
        },
        "production_authorized": {
          "const": false
        },
        "rpc_authorized": {
          "const": false
        },
        "trading_authorized": {
          "const": false
        }
      }
    }
  }
}
