{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/folgercn/vnpy-web-bridge/absence-availability-anchor-v1.schema.json",
  "title": "Research Warehouse external absence availability anchor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "absence_id",
    "receipt_sha256",
    "calendar_raw_sha256",
    "registry_raw_sha256",
    "available_at"
  ],
  "properties": {
    "schema_version": {
      "const": "vnpy_research_absence_availability_anchor_v1"
    },
    "absence_id": {
      "type": "string",
      "pattern": "^absence-[0-9a-f]{64}$"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "calendar_raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "registry_raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "available_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
