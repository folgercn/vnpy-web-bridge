FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
WORKDIR /app
COPY deployments/phase-b/requirements-artifact.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY shared/artifact_contracts /app/shared/artifact_contracts
COPY shared/artifact_custody /app/shared/artifact_custody
COPY shared/commodity_execution /app/shared/commodity_execution
COPY shared/trust_contracts /app/shared/trust_contracts
COPY deployments/final/artifact_bootstrap.py /app/smoke/artifact_bootstrap.py
RUN python -m compileall -q /app/shared /app/smoke \
    && groupadd --system --gid 65532 custody \
    && useradd --system --uid 65532 --gid 65532 --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin custody \
    && mkdir -p /var/lib/phase-c-custody /handoff \
    && chown 65532:65532 /var/lib/phase-c-custody /handoff \
    && chmod 0700 /var/lib/phase-c-custody /handoff
VOLUME ["/var/lib/phase-c-custody", "/handoff"]
USER 65532:65532
ENTRYPOINT ["python", "/app/smoke/artifact_bootstrap.py"]
